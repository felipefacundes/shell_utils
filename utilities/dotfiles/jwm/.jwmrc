<?xml version="1.0"?>

<JWM>
<StartupCommand> exec setxkbmap br abnt2</StartupCommand>
<StartupCommand> exec tint2</StartupCommand>
<StartupCommand> exec vattery</StartupCommand>
<StartupCommand> exec clipit</StartupCommand>
<StartupCommand> exec #compton --config ~/.config/compton.conf</StartupCommand>

<!-- The root menu, if this is undefined you will not get a menu. -->
<!-- Additional RootMenu attributes: onroot, labeled, label -->
<RootMenu height="15" onroot="123">
<Program icon="kmix.png" label="alsamixer">xterm -T "alsamixer" -e sh -c "/usr/bin/alsamixer"</Program>
<Program icon="konqueror.png" label="konqueror">konqueror applications:/</Program>
<Program icon="kopete.png" label="kopete">kopete</Program>
<Program label="KWrite" icon="/usr/share/icons/Faenza/apps/48/accessories-text-editor.png">kwrite</Program>
<Program icon="fast-chromium.png" label="fast-chromium">fast-chromium.sh</Program>
<Program label="LibreOffice Writer" icon="/usr/share/icons/Faenza/apps/48/libreoffice-writer.png">libreoffice --writer</Program>
<Program label="LibreOffice Calc" icon="/usr/share/icons/Faenza/apps/48/libreoffice-calc.png">libreoffice --calc</Program>
<Program label="LibreOffice Draw" icon="/usr/share/icons/Faenza/apps/48/libreoffice-draw.png">libreoffice --draw</Program>
<Program icon="/usr/share/icons/Faenza/apps/48/system-file-manager.png" label="dolphin">dolphin</Program>
<Program icon="fast-firefox.png" label="fast-firefox">fast-firefox.sh</Program>
<Program icon="skype.png" label="skype">skype</Program>
<Program icon="/usr/share/icons/Faenza/apps/48/utilities-terminal.png" label="xfce4-terminal">xfce4-terminal</Program>
<Separator/>
<Program icon="gmrun.xpm" label="Run Command">gmrun</Program>
<!-- <Restart label="Restart" icon="restart.png"/> -->
<Exit label="Exit" confirm="true" icon="exit.png"/>
<Restart label="Restart" icon="restart.png"/>
<Program label="Shutdown" confirm="false" icon="exit.png">/usr/lib/jwm/jwm-poweroff.sh</Program>
<Separator/>
