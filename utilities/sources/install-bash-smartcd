#!/usr/bin/env bash

# File to check
BASHRC_FILE="$HOME/.bashrc"

# Line to look for
TARGET_LINE=". ~/.shell_utils/utilities/sources/smartcd-with-fzf"

# Check if the line already exists in the file
if ! grep -Fq "$TARGET_LINE" "$BASHRC_FILE"; then
    echo "Adding the line 'smartcd' to ~/.bashrc"
    echo " " >> "$BASHRC_FILE"
    echo "$TARGET_LINE" >> "$BASHRC_FILE"
    echo "Line added successfully!"
fi

unset TARGET_LINE BASHRC_FILE