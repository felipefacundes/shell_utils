: <<'DOCUMENTATION'

SMARTFILE - Intelligent File Opening
===================================

OVERVIEW:
smartfile is a smart file opener that intercepts command-not-found errors
and tries to open files with xdg-open using fuzzy search.

FEATURES:
• Intercepts command-not-found and tries to open as file
• Fuzzy search through FILESYSTEM only (not database)
• Interactive selection with fzf + preview (shows files from current directory)
• Alt+f shows only files previously opened from current directory (regional database)
• Single database file stores all directories history
• Regional database: each directory shows only its own opened files
• Opens files with xdg-open (or termux-open on Termux)
• Maintains history database with size limit
• All searches are restricted to the current working directory
• Handles filenames with spaces without requiring escaping
• Removes invalid commands from shell history on Linux (via PROMPT_COMMAND / precmd)
• On Termux, keeps every command in history (valid or invalid)
• "command not found" is shown only when smartfile truly cannot open a file

USAGE:
  Just type any filename as a command - smartfile will intercept it
  Or use explicitly: smartfile [FILE]
  Alt+f - Interactive mode (shows regional files from current directory)

EXAMPLES:
  documento.pdf      # Opens with xdg-open (if file exists or fuzzy match)
  relatorio         # Fuzzy finds and opens relatorio_final.pdf (only in current directory)
  Parallax 2.5D.txt # Opens file with spaces in name without escaping
  $LS_COLORS        # Variable expansion works normally
  smartfile --       # Interactive mode (shows regional database)

DATABASE BEHAVIOR:
  • Regional database: When pressing Alt+f, only files that were opened from
    the current working directory are displayed
  • Navigate to different directories to see their specific history
  • Single database file stores all paths with absolute references
  • History persists across sessions
  • All file searches are restricted to the current working directory

CONFIGURATION:
  SMARTFILE (0/1/2):
    0 = disabled (the command-not-found hook is not installed)
    1 = enabled, no fuzzy search (exact basename match, else single candidate)
    2 = enabled with fuzzy fzf picker (default)

  SMARTFILE_HIST_KEEP_INVALID (0/1):
    0 = remove invalid commands from history on Linux (default)
    1 = keep invalid commands (default bash/zsh behavior)
    On Termux invalid commands are always kept and this flag is ignored.

DOCUMENTATION

# Guard against multiple sourcing (prevents duplicated PROMPT_COMMAND entries)
if [[ -n "$_SMARTFILE_LOADED" ]]; then
    return 0
fi
_SMARTFILE_LOADED=1

# Smartfile configuration
export SMARTFILE_LOG=~/.smartfile.log
export SMARTFILE_HIST_SIZE=${SMARTFILE_HIST_SIZE:-"100"}
export SMARTFILE_HIST_IGNORE=${SMARTFILE_HIST_IGNORE:-".git|*.tmp|*.log|*.swp"}
export SMARTFILE_CONFIG_FOLDER=${SMARTFILE_CONFIG_FOLDER:-"$HOME/.shell_utils_configs/smartfile"}
export SMARTFILE_CONFIG="$SMARTFILE_CONFIG_FOLDER/smartfile.conf"
export SMARTFILE_HIST_FILE=${SMARTFILE_HIST_FILE:-"file_history.db"}
export SMARTFILE_CNF_FLAG=${SMARTFILE_CNF_FLAG:-"${TMPDIR:-/tmp}/.smartfile_cnf_${USER}_$$"}
export SMARTFILE_HIST_KEEP_INVALID=${SMARTFILE_HIST_KEEP_INVALID:-0}

[[ ! -d "$SMARTFILE_CONFIG_FOLDER" ]] && mkdir -p "$SMARTFILE_CONFIG_FOLDER" >/dev/null 2>&1

if [[ ! -f "$SMARTFILE_CONFIG" ]]; then
cat <<'EOF' >| "$SMARTFILE_CONFIG"
# SMARTFILE modes:
#   0 = disable smartfile (hook is not installed)
#   1 = enable smartfile WITHOUT fuzzy search (exact / filesystem match only)
#   2 = enable smartfile WITH fuzzy search (default, uses fzf)
export SMARTFILE=2

# SMARTFILE_HIST_KEEP_INVALID:
#   1 = keep invalid commands in shell history (default bash/zsh behavior)
#   0 = remove invalid commands from shell history on Linux
#       (on Termux the invalid command is always kept, this flag is ignored)
export SMARTFILE_HIST_KEEP_INVALID=0
EOF
fi

[[ -z "$SMARTFILE" || "$SMARTFILE" == 0 ]] && return 0

# shellcheck source=/dev/null
[[ -f "$SMARTFILE_CONFIG" ]] && source "$SMARTFILE_CONFIG"

# Re-check after sourcing the config, in case it disabled smartfile
[[ -z "$SMARTFILE" || "$SMARTFILE" == 0 ]] && return 0

# Check dependencies
if ! command -v fzf &> /dev/null; then
    echo "Can't use smartfile : missing fzf" >| "$SMARTFILE_LOG"
    return 2>/dev/null
fi

# Detect Termux once (used by open_path, history cleanup and dependency checks)
if [[ -n "$TERMUX_VERSION" ]] || [[ -d "/data/data/com.termux" ]]; then
    SMARTFILE_IS_TERMUX=1
else
    SMARTFILE_IS_TERMUX=0
fi

# Check the opener dependency (xdg-open on Linux, termux-open on Termux)
if [[ "$SMARTFILE_IS_TERMUX" -eq 1 ]]; then
    if ! command -v termux-open &> /dev/null; then
        echo "Can't use smartfile : missing termux-open (install termux-tools)" >| "$SMARTFILE_LOG"
        return 2>/dev/null
    fi
else
    if ! command -v xdg-open &> /dev/null; then
        echo "Can't use smartfile : missing xdg-open" >| "$SMARTFILE_LOG"
        return 2>/dev/null
    fi
fi

# Smartfile functions

# Called from PROMPT_COMMAND (bash) / precmd (zsh), i.e. OUTSIDE the
# command-not-found handler subshell, so history modifications actually stick.
#
# On Termux: does NOT touch the history - every command (valid or invalid)
# is kept, which matches the user's requirement there.
# On Linux: removes the invalid command from history, UNLESS the user set
# SMARTFILE_HIST_KEEP_INVALID=1 (then default bash/zsh behavior is preserved).
# The flag is consumed in both cases so it does not leak into the next prompt.
function __smartfile_hist_cleanup() {
    [[ ! -f "$SMARTFILE_CNF_FLAG" ]] && return 0

    # Consume the flag first to avoid re-entrancy
    rm -f "$SMARTFILE_CNF_FLAG" 2>/dev/null

    # Termux: keep every entry in history, nothing to remove
    if [[ "$SMARTFILE_IS_TERMUX" -eq 1 ]]; then
        return 0
    fi

    # User opted into the default bash/zsh behavior: keep invalid commands
    if [[ "$SMARTFILE_HIST_KEEP_INVALID" -eq 1 ]]; then
        return 0
    fi

    if [[ -n "$BASH_VERSION" ]]; then
        # The invalid command is the last entry in the in-memory history.
        history -d -1 2>/dev/null || true
        # If it was already persisted (history -a / PROMPT_COMMAND), drop the
        # matching last line from HISTFILE.
        if [[ -n "$HISTFILE" && -f "$HISTFILE" ]]; then
            local last_line
            last_line=$(tail -n 1 "$HISTFILE" 2>/dev/null)
            if [[ -n "$last_line" && "$last_line" != "$(history 1 2>/dev/null | sed 's/^ *[0-9]* *//')" ]]; then
                # Last file line differs from current last memory entry:
                # it is the invalid command that was persisted. Remove it.
                sed -i '$ d' "$HISTFILE" 2>/dev/null || true
            fi
        fi
    elif [[ -n "$ZSH_VERSION" ]]; then
        # In zsh the command may already be in memory/history file.
        if (( $+functions[hist] )); then
            hist -fs delete -1 2>/dev/null || true
        else
            fc -d -1 2>/dev/null || true
        fi
        if [[ -n "$HISTFILE" && -f "$HISTFILE" ]]; then
            local last_line
            last_line=$(tail -n 1 "$HISTFILE" 2>/dev/null)
            if [[ -n "$last_line" && "$last_line" != "$(fc -ln -1 2>/dev/null)" ]]; then
                sed -i '$ d' "$HISTFILE" 2>/dev/null || true
            fi
        fi
    fi

    return 0
}

# Return codes for __smartfile_open:
#   0 = a file was successfully opened
#   1 = nothing was opened (no match, user cancelled, or open failed)
#   2 = invalid input (empty / not a plausible filename) - handler prints error
function __smartfile_open() {
    local lookUpPath="${*}"
    local selectedEntry=""

    [[ ! -f "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}" ]] && __smartfile_database_reset

    # Remove surrounding quotes if present
    lookUpPath=$(echo "$lookUpPath" | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")

    # Try to open the exact input first (handles files with spaces)
    # Check if the file exists relative to current directory
    if [[ -f "${PWD}/${lookUpPath}" ]] && [[ -r "${PWD}/${lookUpPath}" ]]; then
        __smartfile_open_path "${PWD}/${lookUpPath}"
        return $?
    fi

    # Check if it's an absolute path
    if [[ -f "${lookUpPath}" ]] && [[ -r "${lookUpPath}" ]]; then
        __smartfile_open_path "${lookUpPath}"
        return $?
    fi

    # Fuzzy search mode (only for interactive mode with --)
    if [[ "${lookUpPath}" = "--" ]]; then
        # Interactive mode always uses fzf (it IS the picker).
        local current_dir="${PWD}"
        selectedEntry=$(__smartfile_database_search_by_dir "${current_dir}" | __smartfile_choose_file)
    else
        # Only search filesystem in CURRENT DIRECTORY, NOT database
        local fs_results
        fs_results=$(__smartfile_filesystem_search "${lookUpPath}" 2>/dev/null)

        if [[ -n "$fs_results" ]]; then
            local line_count; line_count=$(echo "$fs_results" | wc -l)

            if [[ "$SMARTFILE" -eq 1 ]]; then
                # Mode 1: no fuzzy. Prefer an exact basename match, otherwise
                # only open if there is a single candidate. Never invoke fzf.
                local exact_match=""
                while IFS= read -r cand; do
                    [[ "${cand##*/}" == "${lookUpPath##*/}" ]] && { exact_match="$cand"; break; }
                done <<< "$fs_results"

                if [[ -n "$exact_match" ]]; then
                    selectedEntry="$exact_match"
                elif [[ "$line_count" -eq 1 ]]; then
                    selectedEntry="$fs_results"
                fi
            else
                # Mode 2 (default): fuzzy picker via fzf.
                local fzfSelect1=""
                [[ $line_count -eq 1 ]] && fzfSelect1="--select-1"
                selectedEntry=$(echo "$fs_results" | __smartfile_choose_file "$fzfSelect1")
            fi
        fi
    fi

    if [[ -n "${selectedEntry}" ]]; then
        __smartfile_open_path "${selectedEntry}"
        return $?
    fi

    # Nothing was selected/opened. If the input was a plausible filename,
    # the caller (command-not-found hook) will decide whether to print the
    # "command not found" message. Return 1 to indicate "not opened".
    return 1
}

function __smartfile_choose_file() {
    local fzfSelect1="${1}"
    local fzfPreview=""
    local cmdPreview; cmdPreview=$(command -v bat batcat cat 2>/dev/null | awk 'NR==1 {print}')

    local errMessage="no such file [ {} ]'\n\n'hint: run '\033[1m'smartfile --cleanup'\033[22m'"

    case "${cmdPreview}" in
        */bat|*/batcat)
            fzfPreview='[ -f {} ] && '${cmdPreview}' --color=always --line-range :50 {} || echo -e '"${errMessage}"''
            ;;
        *)
            fzfPreview='[ -f {} ] && echo "=== File: {} ===" ; '${cmdPreview}' {} || echo -e '"${errMessage}"''
            ;;
    esac

    # Read all input lines
    local input_lines=()
    while IFS= read -r line; do
        input_lines+=("$line")
    done

    # Create display list with only basenames using ##*/ parameter expansion
    local display_list=()
    for fullpath in "${input_lines[@]}"; do
        display_list+=("${fullpath##*/}")
    done

    # Use fzf to select from display list
    local selected_display
    if [[ -n "$TERMUX_VERSION" ]]; then
        selected_display=$(printf '%s\n' "${display_list[@]}" | fzf ${fzfSelect1} --delimiter="\n" --layout="reverse" 2>/dev/tty)
    else
        selected_display=$(printf '%s\n' "${display_list[@]}" | fzf ${fzfSelect1} --delimiter="\n" --layout="reverse" --height="40%" \
            --preview="${fzfPreview}" 2>/dev/tty)
    fi

    # Find the corresponding full path
    if [[ -n "$selected_display" ]]; then
        for i in "${!display_list[@]}"; do
            if [[ "${display_list[$i]}" == "$selected_display" ]]; then
                echo "${input_lines[$i]}"
                return 0
            fi
        done
    fi
}

function __smartfile_open_path() {
    local file="${1}"

    # Resolve to absolute path if relative
    if [[ ! "$file" =~ ^/ ]]; then
        file="${PWD}/${file}"
    fi
    # Normalize path
    file=$(realpath "${file}" 2>/dev/null || echo "${file}")

    if [[ ! -f "${file}" ]] || [[ ! -r "${file}" ]]; then
        echo "smartfile: file '${file}' does not exist or is not readable" >&2
        __smartfile_database_delete_path "${file}"
        return 1
    fi

    if [[ "$SMARTFILE_IS_TERMUX" -eq 1 ]]; then
        # Termux: run termux-open synchronously so the real exit status is
        # captured (termux-open hands the file to an Android app and returns
        # immediately; backgrounding it would hide failures).
        if termux-open "${file}" &>/dev/null; then
            __smartfile_database_save_path "${file}"
            return 0
        else
            __smartfile_database_delete_path "${file}"
            echo "smartfile: failed to open '${file}' with 'termux-open'" >&2
            return 1
        fi
    else
        # Linux: keep the original asynchronous behavior so the shell is not
        # blocked while the graphical application starts.
        if { xdg-open "${file}" 2>/dev/null & disown; } &>/dev/null; then
            __smartfile_database_save_path "${file}"
            return 0
        else
            __smartfile_database_delete_path "${file}"
            return 1
        fi
    fi
}

function __smartfile_filesystem_search() {
    local searchString="${1}"
    local cmdFinder; cmdFinder=$(command -v fdfind fd find 2>/dev/null | awk 'NR==1 {print}')

    # Resolve /sdcard and other symlinked paths to their real location.
    # On Termux, /sdcard is a FUSE mount; using the raw $PWD can make
    # fd/find return nothing, so we normalize it first.
    local searchPath; searchPath=$(realpath "${PWD}" 2>/dev/null || echo "${PWD}")

    # Don't search if searchString is empty or just dots
    if [[ -z "${searchString}" || "${searchString}" =~ ^\.+$ ]]; then
        return 0
    fi

    # Remove leading path if user typed a path, we only want the filename part
    searchString=$(basename -- "${searchString}")

    case "${cmdFinder}" in
        */fd*)
            "${cmdFinder}" --hidden --no-ignore-vcs "${searchString}" --color=never --follow --max-depth=1 --type=file --exclude ".git/" "${searchPath}" --exec realpath --no-symlinks 2>/dev/null
            ;;
        *)
            find "${searchPath}" -maxdepth 1 -type f ! -path '*\.git/*' -iname '*'"${searchString}"'*' -exec realpath --no-symlinks {} + 2>/dev/null
            ;;
    esac
}

function __smartfile_database_search() {
    local searchString="${1}"

    # If search string is empty, return all history
    if [[ -z "${searchString}" ]]; then
        cat "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}" 2>/dev/null
        return 0
    fi

    # Escape special regex characters
    local escaped_string
    escaped_string=$(echo "${searchString}" | sed -e 's/\./\\./g' -e 's/\//\\//g')

    # Only create pattern if escaped_string is not empty
    if [[ -n "${escaped_string}" ]]; then
        grep -i "${escaped_string}" "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}" 2>/dev/null
    else
        cat "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}" 2>/dev/null
    fi
}

function __smartfile_database_search_by_dir() {
    local target_dir="${1}"
    local escaped_dir

    # Escape special characters for grep
    escaped_dir=$(echo "${target_dir}" | sed 's/[.[\*^$()+?{|]/\\&/g')

    # Return files that are in the specified directory (regional database)
    grep "^${escaped_dir}/[^/]*$" "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}" 2>/dev/null
}

function __smartfile_database_save_path() {
    local file="${1}"
    local iCounter=0
    local ignoreItem=""
    local ignoreItemFound=""

    [[ ! -f "${file}" ]] && return

    # Ensure we have absolute path
    if [[ ! "$file" =~ ^/ ]]; then
        file=$(realpath "${file}" 2>/dev/null || echo "${PWD}/${file}")
    fi

    # Check ignore list
    while true; do
        ((iCounter++))
        ignoreItem=$(echo "${SMARTFILE_HIST_IGNORE}|" | cut -d'|' -f${iCounter})
        [[ -z "${ignoreItem}" ]] && break

        ignoreItemFound=$(echo "${file}" | grep -E "${ignoreItem}" 2>/dev/null)
        if [[ -n "${ignoreItemFound}" ]]; then
            __smartfile_database_delete_path "${file}"
            return
        fi
    done

    __smartfile_database_delete_path "${file}"
    sed -i "1 s:^:${file}\n:" "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}"
    sed -i $((SMARTFILE_HIST_SIZE + 1))',$ d' "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}"
}

function __smartfile_database_delete_path() {
    local file="${1}"
    # Escape special characters for sed
    local escaped_file; escaped_file=$(echo "${file}" | sed 's/[.[\*^$()+?{|]/\\&/g')
    sed -i "\:^${escaped_file}$:d" "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}" 2>/dev/null
}

function __smartfile_database_cleanup() {
    local fTmp; fTmp=$(mktemp 2>/dev/null)
    local line=""
    local iCounter=0
    local bIgnore="false"
    local ignoreItem=""
    local ignoreItemFound=""

    [[ ! -f "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}" ]] && __smartfile_database_reset

    while IFS= read -r line || [[ -n "${line}" ]]; do
        if [[ -f "${line}" ]]; then
            iCounter=0
            bIgnore="false"

            while true; do
                ((iCounter++))
                ignoreItem=$(echo "${SMARTFILE_HIST_IGNORE}|" | cut -d'|' -f${iCounter})
                [[ -z "${ignoreItem}" ]] && break

                ignoreItemFound=$(echo "${line}" | grep -E "${ignoreItem}" 2>/dev/null)
                if [[ -n "${ignoreItemFound}" ]]; then
                    bIgnore="true"
                    break
                fi
            done

            [[ "${bIgnore}" = "false" ]] && echo "${line}" >> "${fTmp}"
        fi
    done < "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}"

    awk '!seen[$0]++' "${fTmp}" >| "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}"
    sed -i '/^[[:blank:]]*$/ d' "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}"
    [[ $(wc -l < "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}") -eq 0 ]] && __smartfile_database_reset
    rm -f "${fTmp}"
}

function __smartfile_database_reset() {
    mkdir -p "${SMARTFILE_CONFIG_FOLDER}" >/dev/null 2>&1
    echo "" >| "${SMARTFILE_CONFIG_FOLDER}/${SMARTFILE_HIST_FILE}"
}

# Main smartfile function
function smartfile() {
    case "$1" in
        --help|-h)
            echo "Usage: smartfile [FILE]"
            echo "       smartfile --         (interactive mode with regional database)"
            echo "       smartfile --cleanup  (cleanup database)"
            echo "       smartfile --reset    (reset database)"
            echo ""
            echo "Database is regional: Alt+f shows only files from current directory"
            echo "Each directory maintains its own history within a single database file"
            echo "All file searches are restricted to the current working directory"
            echo "Files with spaces in names are handled automatically"
            ;;
        --cleanup)
            __smartfile_database_cleanup
            ;;
        --reset)
            __smartfile_database_reset
            ;;
        --)
            __smartfile_open "--"
            ;;
        *)
            __smartfile_open "$@"
            ;;
    esac
}

# Command not found hook for bash
if [[ -n "$BASH_VERSION" ]]; then
    command_not_found_handle() {
        # Signal (outside this subshell) that the last typed command was invalid.
        # On Linux this makes __smartfile_hist_cleanup remove it from history,
        # unless SMARTFILE_HIST_KEEP_INVALID=1.
        # On Termux the flag is still created but the cleanup ignores it, so the
        # invalid command stays in history (user's requirement).
        : >| "$SMARTFILE_CNF_FLAG" 2>/dev/null

        # If the input contains only alphanumeric, underscores, dots, slashes, spaces, or hyphens, it might be a file
        # If it contains special chars like =, :, etc., it's probably a variable expansion - show it
        if [[ "$*" =~ ^[a-zA-Z0-9._/\\\ -]+$ ]]; then
            # Capture the original bash error message in a variable.
            # On Termux, `bash -c "type ..."` fails noisily because the inner
            # bash prints "type: <cmd>: not found" before returning, so we skip
            # the capture there and use a fixed message instead.
            local original_error=""
            if [[ "$SMARTFILE_IS_TERMUX" -eq 0 ]]; then
                original_error=$(LC_ALL=C bash -c "type $*" 2>&1 || true)
            fi

            # Try to open as file. __smartfile_open returns:
            #   0 = file was opened successfully
            #   1 = nothing was opened (no match / user cancelled / open failed)
            #   2 = invalid input
            smartfile "$@" 2>/dev/null
            local smartfile_result=$?

            # Only report "command not found" when smartfile could not open
            # anything at all (no file matched/selected/opened).
            if [[ $smartfile_result -ne 0 ]]; then
                if [[ "$SMARTFILE_IS_TERMUX" -eq 0 && -f /usr/share/bash-completion/bash_completion ]]; then
                    printf "bash: %s: command not found\n" "$*" >&2
                elif [[ "$SMARTFILE_IS_TERMUX" -eq 0 && -n "$original_error" ]]; then
                    echo "$original_error" >&2
                else
                    printf "bash: %s: command not found\n" "$*" >&2
                fi
                return 127
            fi
            return 0
        else
            # For variable expansions and other special content, show it as text
            echo "$*"
            return 127
        fi
    }

    # Run history cleanup in the main shell (not the handler subshell).
    # On Termux, bash only flushes history on explicit exit, so valid commands
    # are lost when the app is closed from the notification. Prepending
    # `history -a` after every command keeps the history file up to date.
    # Idempotent checks avoid duplicated entries if this file is sourced twice.
    if [[ "$SMARTFILE_IS_TERMUX" -eq 1 ]]; then
        [[ "$PROMPT_COMMAND" != *"history -a"* ]] && \
            PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
        [[ "$PROMPT_COMMAND" != *"__smartfile_hist_cleanup"* ]] && \
            PROMPT_COMMAND="__smartfile_hist_cleanup${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
    else
        [[ "$PROMPT_COMMAND" != *"__smartfile_hist_cleanup"* ]] && \
            PROMPT_COMMAND="__smartfile_hist_cleanup${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
    fi

    # Key binding for Alt+f
    bind -r '\ef' 2>/dev/null || true
    bind '"\ef":"smartfile --\n"' 2>/dev/null || true
fi

# Command not found hook for zsh
if [[ -n "$ZSH_VERSION" ]]; then
    command_not_found_handler() {
        # Signal (outside this handler) that the last typed command was invalid.
        # Same semantics as bash: Linux removes it from history (unless
        # SMARTFILE_HIST_KEEP_INVALID=1), Termux keeps it.
        : >| "$SMARTFILE_CNF_FLAG" 2>/dev/null

        # If the input contains only alphanumeric, underscores, dots, slashes, spaces, or hyphens, it might be a file
        # If it contains special chars like =, :, etc., it's probably a variable expansion - show it
        if [[ "$*" =~ ^[a-zA-Z0-9._/\\\ -]+$ ]]; then
            # Capture the original zsh error message in a variable.
            # On Termux, `zsh -c "type ..."` fails noisily because the inner
            # zsh prints "type: <cmd>: not found" before returning, so we skip
            # the capture there and use a fixed message instead.
            local original_error=""
            if [[ "$SMARTFILE_IS_TERMUX" -eq 0 ]]; then
                original_error=$(LC_ALL=C zsh -c "type $*" 2>&1 || true)
            fi

            # Try to open as file. __smartfile_open returns:
            #   0 = file was opened successfully
            #   1 = nothing was opened (no match / user cancelled / open failed)
            #   2 = invalid input
            smartfile "$@" 2>/dev/null
            local smartfile_result=$?

            # Only report "command not found" when smartfile could not open
            # anything at all (no file matched/selected/opened).
            if [[ $smartfile_result -ne 0 ]]; then
                printf "zsh: command not found: %s\n" "$*" >&2
                return 127
            fi
            return 0
        else
            # For variable expansions and other special content, show it as text
            echo "$*"
            return 127
        fi
    }

    # Run history cleanup in the main shell (not the handler)
    autoload -Uz add-zsh-hook 2>/dev/null
    add-zsh-hook precmd __smartfile_hist_cleanup 2>/dev/null || true

    # Key binding for Alt+f
    bindkey -s '^[f' 'smartfile --\n' 2>/dev/null || true
fi

# Bash completion
if [[ -n "$BASH_VERSION" ]]; then
    _smartfile_completion() {
        local cur="${COMP_WORDS[COMP_CWORD]}"
        COMPREPLY=( $(compgen -f -- "$cur") )
    }
    complete -o filenames -o nospace -F _smartfile_completion smartfile 2>/dev/null || true
fi

# Zsh completion
if [[ -n "$ZSH_VERSION" ]]; then
    compdef _files smartfile 2>/dev/null || true
fi