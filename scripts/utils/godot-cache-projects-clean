is_godot_project() {
    local project_dir="$1"
    
    printf "${CLR_BLUE}${MESSAGES[sweep_checking]}${CLR_RESET}\n" "$project_dir"
    
    if [[ ! -d "$project_dir" ]]; then
        return 1
    fi
    
    if [[ -f "$project_dir/project.godot" ]] || [[ -f "$project_dir/engine.cfg" ]]; then
        printf "${CLR_GREEN}${MESSAGES[sweep_confirmed_marker]}${CLR_RESET}\n"
        return 0
    fi
    
    local valid=false
    local evidence_count=0
    
    # Markers
    local markers=("project.godot" "engine.cfg" "default_env.tres" "icon.png" "icon.svg" ".gitignore" ".gitattributes")
    for marker in "${markers[@]}"; do
        if [[ -e "$project_dir/$marker" ]]; then
            printf "${CLR_GREEN}${MESSAGES[sweep_evidence_found]}${CLR_RESET}\n" "$marker"
            valid=true
            ((evidence_count++))
        fi
    done
    
    # Typical Godot directories
    local godot_dirs=("scenes" "scripts" "assets" "src" "addons" "autoload" "shaders" "materials" "textures" "sounds" "music" "fonts" "resources")
    for dir in "${godot_dirs[@]}"; do
        if [[ -d "$project_dir/$dir" ]]; then
            printf "${CLR_GREEN}${MESSAGES[sweep_evidence_dir]}${CLR_RESET}\n" "$dir"
            valid=true
            ((evidence_count++))
        fi
    done
    
    # Godot-specific files
    local godot_files_list=$(find "$project_dir" -maxdepth 3 \( -name "*.gd" -o -name "*.tscn" -o -name "*.tres" -o -name "*.godot" -o -name "*.import" \) -print0 2>/dev/null | tr -d '\0' | wc -c)
    if [[ "$godot_files_list" -gt 0 ]]; then
        printf "${CLR_GREEN}${MESSAGES[sweep_evidence_files]}${CLR_RESET}\n" "$godot_files_list"
        valid=true
        ((evidence_count++))
    fi
    
    # .godot internal structure
    if [[ -d "$project_dir/.godot" ]]; then
        local struct=0
        [[ -d "$project_dir/.godot/imported" ]] && ((struct++))
        [[ -d "$project_dir/.godot/editor" ]] && ((struct++))
        [[ -d "$project_dir/.godot/shader_cache" ]] && ((struct++))
        [[ -f "$project_dir/.godot/global_script_class_cache.cfg" ]] && ((struct++))
        [[ -f "$project_dir/.godot/extension_list.cfg" ]] && ((struct++))
        if [[ $struct -gt 0 ]]; then
            printf "${CLR_GREEN}${MESSAGES[sweep_evidence_structure]}${CLR_RESET}\n" "$struct"
            valid=true
            ((evidence_count++))
        fi
    fi
    
    if [[ "$valid" == true ]]; then
        printf "${CLR_GREEN}${MESSAGES[sweep_confirmed]}${CLR_RESET}\n"
        printf "${CLR_GREEN}${MESSAGES[sweep_confirmed_total]}${CLR_RESET}\n" "$evidence_count"
        return 0
    fi
    
    printf "${CLR_YELLOW}${MESSAGES[sweep_skipped]}${CLR_RESET}\n"
    return 1
}

remove_godot_from_project() {
    local project_dir="$1"
    local godot_cache="$project_dir/.godot"
    
    printf "${CLR_BLUE}${MESSAGES[sweep_project_label]}${CLR_RESET}\n" "$project_dir"
    
    if ! is_godot_project "$project_dir"; then
        return 1
    fi
    
    if [[ ! -w "$project_dir" ]]; then
        printf "${CLR_RED}${MESSAGES[sweep_no_permission]}${CLR_RESET}\n"
        return 1
    fi
    
    local size=$(du -sh "$godot_cache" 2>/dev/null | cut -f1)
    local num_files=$(find "$godot_cache" -type f 2>/dev/null | wc -l)
    
    printf "${CLR_BLUE}${MESSAGES[sweep_cache_info]}${CLR_RESET}\n"
    printf "${CLR_BLUE}${MESSAGES[sweep_cache_size]}${CLR_RESET}\n" "$size"
    printf "${CLR_BLUE}${MESSAGES[sweep_cache_files]}${CLR_RESET}\n" "$num_files"
    
    printf "${CLR_BLUE}${MESSAGES[sweep_structure_title]}${CLR_RESET}\n"
    find "$godot_cache" -maxdepth 2 -type d 2>/dev/null | while read -r subdir; do
        local sub_size=$(du -sh "$subdir" 2>/dev/null | cut -f1)
        printf "  • %s: %s\n" "$(basename "$subdir")" "$sub_size"
    done
    
    printf "${CLR_YELLOW}${MESSAGES[sweep_removing]}${CLR_RESET}\n" "$godot_cache"
    if rm -rf "$godot_cache" 2>/dev/null && [[ ! -d "$godot_cache" ]]; then
        printf "${CLR_GREEN}${MESSAGES[sweep_removed]}${CLR_RESET}\n" "$size"
        return 0
    else
        printf "${CLR_RED}${MESSAGES[sweep_error_remove]}${CLR_RESET}\n"
        return 1
    fi
}

surgical_fix() {
    local project_dir=""
    
    if [[ $# -gt 0 ]]; then
        project_dir="$1"
    else
        echo -e "${CLR_CYAN}${MESSAGES[fix_description]}${CLR_RESET}\n"
        echo -e "${CLR_BOLD_YELLOW}${MESSAGES[confirm_removal]}${CLR_RESET}\n"
        read -r -p "${MESSAGES[prompt_y_n]}" response
        if [[ ! "$response" =~ ^[YySs]$ ]]; then
            printf "${CLR_RED}${MESSAGES[cancelled]}${CLR_RESET}\n"
            exit 0
        fi
        
        project_dir=$(zenity --file-selection --directory --title="${MESSAGES[select_project_dir]}" 2>/dev/null)
        
        if [[ -z "$project_dir" ]]; then
            printf "${CLR_RED}${MESSAGES[no_dir_selected]}${CLR_RESET}\n"
            exit 1
        fi
    fi
    
    if [[ ! -d "$project_dir/.godot" ]]; then
        printf "${CLR_RED}${MESSAGES[no_godot_dir]}${CLR_RESET}\n"
        exit 1
    fi
    
    printf "${CLR_YELLOW}${MESSAGES[removing]}${CLR_RESET}\n" "$project_dir"
    rm -rf "$project_dir/.godot"
    
    if [[ ! -d "$project_dir/.godot" ]]; then
        printf "${CLR_BOLD_GREEN}${MESSAGES[removed_success]}${CLR_RESET}\n"
        echo ""
        show_benefits
    else
        printf "${CLR_RED}${MESSAGES[sweep_error_remove]}${CLR_RESET}\n"
        exit 1
    fi
}

sweep_projects() {
    local base_dir="$1"
    
    echo -e "${CLR_BLUE}╔══════════════════════════════════════════════════════════╗${CLR_RESET}"
    echo -e "${CLR_BLUE}║     ${MESSAGES[sweep_header]}${CLR_RESET}"
    echo -e "${CLR_BLUE}╚══════════════════════════════════════════════════════════╝${CLR_RESET}"
    printf "${CLR_BLUE}${MESSAGES[date_label]}${CLR_RESET}\n" "$(date '+%Y-%m-%d %H:%M:%S')"
    printf "${CLR_BLUE}${MESSAGES[base_label]}${CLR_RESET}\n" "$base_dir"
    printf "${CLR_BLUE}${MESSAGES[mode_label]}${CLR_RESET}\n" "${MESSAGES[mode_normal]}"
    echo ""
    
    printf "${CLR_BLUE}${MESSAGES[sweep_phase1]}${CLR_RESET}\n" "$base_dir"
    printf "${CLR_DIM}${MESSAGES[sweep_may_take]}${CLR_RESET}\n"
    
    local godot_dirs=()
    while IFS= read -r -d '' dir; do
        godot_dirs+=("$dir")
    done < <(find "$base_dir" -type d -name ".godot" -print0 2>/dev/null)
    
    printf "${CLR_BLUE}${MESSAGES[sweep_found]}${CLR_RESET}\n" "${#godot_dirs[@]}"
    
    if [[ ${#godot_dirs[@]} -eq 0 ]]; then
        printf "${CLR_GREEN}${MESSAGES[sweep_none]}${CLR_RESET}\n"
        exit 0
    fi
    
    echo ""
    printf "${CLR_BLUE}${MESSAGES[sweep_summary_title]}${CLR_RESET}\n"
    for i in "${!godot_dirs[@]}"; do
        parent_project=$(dirname "${godot_dirs[$i]}")
        printf "  ${CLR_YELLOW}%d${CLR_RESET}. %s\n" "$((i+1))" "$parent_project"
    done
    
    echo ""
    printf "${CLR_YELLOW}${MESSAGES[sweep_attention_title]}${CLR_RESET}\n"
    printf "  ${MESSAGES[sweep_attention_1]}\n"
    printf "  ${MESSAGES[sweep_attention_2]}\n"
    printf "  ${MESSAGES[sweep_attention_3]}\n"
    echo ""
    read -r -p "${MESSAGES[prompt_yes_no]}" confirmation
    
    if [[ "${confirmation,,}" != "yes" ]] && [[ "${confirmation,,}" != "y" ]]; then
        printf "${CLR_BLUE}${MESSAGES[cancelled]}${CLR_RESET}\n"
        exit 0
    fi
    
    echo ""
    printf "${CLR_BLUE}${MESSAGES[sweep_phase2]}${CLR_RESET}\n"
    
    local total_removed=0
    local total_ignored=0
    local total_errors=0
    
    for godot_cache in "${godot_dirs[@]}"; do
        local parent_project=$(dirname "$godot_cache")
        echo ""
        echo -e "${CLR_BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${CLR_RESET}"
        
        if remove_godot_from_project "$parent_project"; then
            ((total_removed++))
        else
            if [[ -d "$godot_cache" ]]; then
                if is_godot_project "$parent_project" 2>/dev/null; then
                    ((total_errors++))
                else
                    ((total_ignored++))
                fi
            fi
        fi
    done
    
    echo ""
    echo -e "${CLR_BLUE}╔══════════════════════════════════════════════════════════╗${CLR_RESET}"
    echo -e "${CLR_BLUE}║     ${MESSAGES[sweep_report_title]}${CLR_RESET}"
    echo -e "${CLR_BLUE}╚══════════════════════════════════════════════════════════╝${CLR_RESET}"
    printf "${CLR_YELLOW}${MESSAGES[sweep_report_total]}${CLR_RESET}\n" "${#godot_dirs[@]}"
    printf "${CLR_GREEN}${MESSAGES[sweep_report_removed]}${CLR_RESET}\n" "$total_removed"
    printf "${CLR_YELLOW}${MESSAGES[sweep_report_ignored]}${CLR_RESET}\n" "$total_ignored"
    printf "${CLR_RED}${MESSAGES[sweep_report_errors]}${CLR_RESET}\n" "$total_errors"
    printf "${CLR_BLUE}${MESSAGES[sweep_report_datetime]}${CLR_RESET}\n" "$(date '+%Y-%m-%d %H:%M:%S')"
    
    if [[ $total_removed -gt 0 ]]; then
        echo ""
        printf "${CLR_GREEN}${MESSAGES[sweep_tip_1]}${CLR_RESET}\n"
        printf "${CLR_GREEN}${MESSAGES[sweep_tip_2]}${CLR_RESET}\n"
    fi
    
    echo ""
    printf "${CLR_BLUE}${MESSAGES[sweep_completed]}${CLR_RESET}\n"
    
    if [[ $total_errors -gt 0 ]]; then
        exit 1
    fi
}

force_sweep() {
    local base_dir="$1"
    
    echo -e "${CLR_BOLD_RED}╔══════════════════════════════════════════════════════════╗${CLR_RESET}"
    echo -e "${CLR_BOLD_RED}║     ${MESSAGES[force_header]}${CLR_RESET}"
    echo -e "${CLR_BOLD_RED}║     ${MESSAGES[force_cmd]}${CLR_RESET}"
    echo -e "${CLR_BOLD_RED}╚══════════════════════════════════════════════════════════╝${CLR_RESET}"
    printf "${CLR_RED}${MESSAGES[force_warning]}${CLR_RESET}\n"
    echo ""
    
    local before=$(find "$base_dir" -type d -name ".godot" 2>/dev/null | wc -l)
    printf "${CLR_YELLOW}${MESSAGES[force_found]}${CLR_RESET}\n" "$before"
    
    if [[ $before -eq 0 ]]; then
        printf "${CLR_GREEN}${MESSAGES[sweep_none]}${CLR_RESET}\n"
        exit 0
    fi
    
    echo ""
    printf "${CLR_RED}${MESSAGES[force_confirm]}${CLR_RESET}\n" "$before"
    printf "${CLR_RED}${MESSAGES[force_confirm_2]}${CLR_RESET}\n"
    read -r -p "${MESSAGES[force_type]} " confirmation
    
    if [[ "$confirmation" != "FORCE" ]]; then
        printf "${CLR_BLUE}${MESSAGES[force_cancelled]}${CLR_RESET}\n"
        exit 0
    fi
    
    echo ""
    printf "${CLR_BLUE}${MESSAGES[force_running]}${CLR_RESET}\n" "$base_dir"
    echo ""
    
    find "$base_dir" -type d -name ".godot" -print -exec rm -rf {} \; 2>/dev/null
    local exit_code=$?
    
    echo ""
    if [[ $exit_code -eq 0 ]]; then
        printf "${CLR_GREEN}${MESSAGES[force_exec_success]}${CLR_RESET}\n"
    else
        printf "${CLR_RED}${MESSAGES[force_exec_error]}${CLR_RESET}\n" "$exit_code"
    fi
    
    local after=$(find "$base_dir" -type d -name ".godot" 2>/dev/null | wc -l)
    
    echo ""
    echo -e "${CLR_BLUE}╔══════════════════════════════════════════════════════════╗${CLR_RESET}"
    echo -e "${CLR_BLUE}║     ${MESSAGES[sweep_report_title]}${CLR_RESET}"
    echo -e "${CLR_BLUE}╚══════════════════════════════════════════════════════════╝${CLR_RESET}"
    printf "${CLR_YELLOW}${MESSAGES[force_before]}${CLR_RESET}\n" "$before"
    printf "${CLR_YELLOW}${MESSAGES[force_after]}${CLR_RESET}\n" "$after"
    printf "${CLR_GREEN}${MESSAGES[force_removed]}${CLR_RESET}\n" "$((before - after))"
    
    if [[ $after -gt 0 ]]; then
        printf "${CLR_RED}${MESSAGES[force_remaining]}${CLR_RESET}\n" "$after"
        exit 1
    else
        printf "${CLR_GREEN}${MESSAGES[force_success]}${CLR_RESET}\n"
        exit 0
    fi
}

main() {
    if [[ $# -eq 0 ]]; then
        show_help
    fi
    
    case "$1" in
        -h|--help)
            show_help
            ;;
        -d|--doc)
            show_doc
            ;;
        --version)
            show_version
            ;;
        -f|--fix)
            shift
            surgical_fix "$@"
            ;;
        -s|--sweep)
            shift
            if [[ -z "$1" ]]; then
                printf "${CLR_RED}${MESSAGES[base_dir_required]}${CLR_RESET}\n"
                printf "${CLR_RED}${MESSAGES[use_help_hint]//%s/$SCRIPT_NAME}${CLR_RESET}\n"
                exit 1
            fi
            if [[ ! -d "$1" ]]; then
                printf "${CLR_RED}${MESSAGES[dir_not_found]//%s/$1}${CLR_RESET}\n"
                exit 1
            fi
            sweep_projects "$1"
            ;;
        -F|--force)
            shift
            if [[ -z "$1" ]]; then
                printf "${CLR_RED}${MESSAGES[base_dir_required]}${CLR_RESET}\n"
                printf "${CLR_RED}${MESSAGES[use_help_hint]//%s/$SCRIPT_NAME}${CLR_RESET}\n"
                exit 1
            fi
            if [[ ! -d "$1" ]]; then
                printf "${CLR_RED}${MESSAGES[dir_not_found]//%s/$1}${CLR_RESET}\n"
                exit 1
            fi
            force_sweep "$1"
            ;;
        *)
            printf "${CLR_RED}${MESSAGES[unknown_option]//%s/$1}${CLR_RESET}\n"
            show_help
            ;;
    esac
}

main "$@"