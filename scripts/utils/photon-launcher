# Script Name: photon-launcher (or whatever name you give it)
# Description: Launcher and version manager for Photon-Studio AppImages
# Author: Assistant
# Version: 1.0.0

set -euo pipefail

# Dynamic naming based on script name
SCRIPT_NAME="${0##*/}"
SCRIPT_NAME="${SCRIPT_NAME%.sh}"
CACHE_DIR="${HOME}/.cache/${SCRIPT_NAME}"
CONF_FILE="${CACHE_DIR}/${SCRIPT_NAME}.conf"
PHOTON_DIR="${HOME}/.local/bin"
DOWNLOAD_URL="https://tenzen.studio/photon/"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Ensure cache directory exists
mkdir -p "${CACHE_DIR}"

# Logging functions
log_info() { echo -e "${BLUE}[INFO]${NC} $*"; }
log_success() { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# Get the currently configured default version (if any)
get_default_version() {
    if [[ -f "${CONF_FILE}" ]]; then
        # shellcheck disable=SC1090
        source "${CONF_FILE}"
        echo "${PHOTON_DEFAULT_VERSION:-}"
    else
        echo ""
    fi
}

# Save default version to conf file
set_default_version() {
    local version="$1"
    cat > "${CONF_FILE}" <<EOF
# Photon Studio launcher configuration
# Generated automatically - do not edit unless you know what you are doing
PHOTON_DEFAULT_VERSION="${version}"
EOF
}

# Clear default version
clear_default_version() {
    if [[ -f "${CONF_FILE}" ]]; then
        rm -f "${CONF_FILE}"
    fi
}

# List all available Photon AppImages, sorted by version (newest first)
list_versions() {
    local -a files=()
    shopt -s nullglob
    for f in "${PHOTON_DIR}"/Photon-Studio-*-linux-x64.AppImage; do
        files+=("$(basename "$f")")
    done
    shopt -u nullglob

    if [[ ${#files[@]} -eq 0 ]]; then
        return 1
    fi

    # Sort using version sort, reverse for newest first
    printf '%s\n' "${files[@]}" | sort -Vr
}

# Get the most recent version (respecting configured default)
get_latest_version() {
    local configured
    configured="$(get_default_version)"

    if [[ -n "${configured}" ]]; then
        if [[ -f "${PHOTON_DIR}/${configured}" ]]; then
            echo "${configured}"
            return 0
        else
            log_warn "Configured version '${configured}' not found. Falling back to latest available."
        fi
    fi

    local latest
    latest="$(list_versions | head -n1 || true)"
    if [[ -z "${latest}" ]]; then
        return 1
    fi
    echo "${latest}"
}

# Launch Photon Studio
launch_photon() {
    local version
    version="$(get_latest_version)" || {
        log_error "No Photon-Studio AppImage found in ${PHOTON_DIR}"
        log_info "Download it from: ${DOWNLOAD_URL}"
        exit 1
    }

    local full_path="${PHOTON_DIR}/${version}"

    if [[ ! -x "${full_path}" ]]; then
        log_warn "File is not executable. Attempting to fix permissions..."
        chmod +x "${full_path}" || {
            log_error "Could not make ${full_path} executable."
            exit 1
        }
    fi

    log_info "Launching ${version}..."
    exec "${full_path}" "$@"
}

# Show version list with markers
show_versions() {
    local configured
    configured="$(get_default_version)"

    log_info "Available Photon-Studio versions in ${PHOTON_DIR}:"
    echo

    local i=1
    while IFS= read -r ver; do
        local marker=" "
        local note=""
        if [[ "${ver}" == "${configured}" ]]; then
            marker="*"
            note=" ${GREEN}(default)${NC}"
        elif [[ ${i} -eq 1 && -z "${configured}" ]]; then
            note=" ${YELLOW}(latest, will be launched)${NC}"
        fi
        printf "  %s %d) %s%b\n" "${marker}" "${i}" "${ver}" "${note}"
        ((i++))
    done < <(list_versions)
    echo
    printf "Legend: %b*%b = configured default version\n" "${GREEN}" "${NC}"
}

# Set a version as default
cmd_set_default() {
    local target="$1"
    if [[ -z "${target}" ]]; then
        log_error "Usage: ${SCRIPT_NAME} --set-default <version>"
        exit 1
    fi

    # Allow passing either full filename or partial (e.g., "0.1.70")
    local file="${target}"
    if [[ ! -f "${PHOTON_DIR}/${file}" ]]; then
        # Try to match by substring
        local match
        match="$(list_versions | grep -F "${target}" | head -n1 || true)"
        if [[ -z "${match}" ]]; then
            log_error "Version '${target}' not found in ${PHOTON_DIR}"
            exit 1
        fi
        file="${match}"
    fi

    set_default_version "${file}"
    log_success "Default version set to: ${file}"
}

# Unset default version
cmd_clear_default() {
    clear_default_version
    log_success "Default version cleared. The latest version will be launched."
}

# Delete a specific version
cmd_delete_version() {
    local target="$1"
    if [[ -z "${target}" ]]; then
        log_error "Usage: ${SCRIPT_NAME} --delete <version>"
        exit 1
    fi

    local file="${target}"
    if [[ ! -f "${PHOTON_DIR}/${file}" ]]; then
        local match
        match="$(list_versions | grep -F "${target}" | head -n1 || true)"
        if [[ -z "${match}" ]]; then
            log_error "Version '${target}' not found."
            exit 1
        fi
        file="${match}"
    fi

    local configured
    configured="$(get_default_version)"
    if [[ "${file}" == "${configured}" ]]; then
        log_error "Refusing to delete '${file}': it is set as the default version."
        log_info "Change the default first with: ${SCRIPT_NAME} --clear-default"
        log_info "or set another version with: ${SCRIPT_NAME} --set-default <version>"
        exit 1
    fi

    rm -f "${PHOTON_DIR:?}/${file}"
    log_success "Deleted: ${file}"
}

# Delete all old versions (keeps only the latest; refuses if default would be deleted)
cmd_delete_old() {
    local -a versions=()
    mapfile -t versions < <(list_versions)

    if [[ ${#versions[@]} -le 1 ]]; then
        log_info "Only one version present. Nothing to clean up."
        return 0
    fi

    local latest="${versions[0]}"
    local configured
    configured="$(get_default_version)"

    # Determine the "keep" target: configured version if valid, else the latest
    local keep="${latest}"
    if [[ -n "${configured}" ]]; then
        if [[ -f "${PHOTON_DIR}/${configured}" ]]; then
            keep="${configured}"
        else
            log_warn "Configured default '${configured}' no longer exists. Keeping latest."
        fi
    fi

    log_info "Keeping: ${keep}"
    log_info "Removing old versions..."

    local removed=0
    local f
    for f in "${versions[@]}"; do
        if [[ "${f}" == "${keep}" ]]; then
            continue
        fi
        if [[ "${f}" == "${configured}" ]]; then
            log_warn "Skipping '${f}': it is set as default."
            continue
        fi
        rm -f "${PHOTON_DIR:?}/${f}"
        log_success "Removed: ${f}"
        ((removed++))
    done

    if [[ ${removed} -eq 0 ]]; then
        log_info "No versions were removed."
    fi
}

# Show help
show_help() {
    cat <<EOF
${SCRIPT_NAME} - Photon-Studio launcher & version manager

USAGE:
    ${SCRIPT_NAME}                       Launch the latest (or configured) version
    ${SCRIPT_NAME} [--set-default|--clear-default|--delete|--delete-old|--list|--help]
    ${SCRIPT_NAME} [--] [args...]        Forward extra args to Photon-Studio

OPTIONS:
    -h, --help              Show this help message and exit
    -l, --list              List all installed Photon-Studio versions
    -s, --set-default VER   Set VER (full filename or substring) as default
    -c, --clear-default     Remove the configured default version
    -d, --delete VER        Delete a specific version (not allowed if it is default)
    -o, --delete-old        Delete all old versions, keeping only the default/latest
        --cache-dir         Print cache directory and config file paths
        --download-url      Print the Photon-Studio download URL

FILES:
    Versions directory : ${PHOTON_DIR}
    Config file        : ${CONF_FILE}
    Cache directory    : ${CACHE_DIR}

DOWNLOAD:
    ${DOWNLOAD_URL}

EXAMPLES:
    ${SCRIPT_NAME}
    ${SCRIPT_NAME} --set-default 0.1.70
    ${SCRIPT_NAME} --list
    ${SCRIPT_NAME} --delete 0.1.69
    ${SCRIPT_NAME} --delete-old
    ${SCRIPT_NAME} --clear-default
EOF
}

# Print cache paths
cmd_show_paths() {
    echo "Cache directory : ${CACHE_DIR}"
    echo "Config file     : ${CONF_FILE}"
    echo "Versions dir    : ${PHOTON_DIR}"
}

# Main entry point
main() {
    # Handle no-argument case: launch
    if [[ $# -eq 0 ]]; then
        launch_photon
        exit 0
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -l|--list)
                show_versions
                exit 0
                ;;
            -s|--set-default)
                cmd_set_default "${2:-}"
                shift 2
                ;;
            -c|--clear-default)
                cmd_clear_default
                shift
                ;;
            -d|--delete)
                cmd_delete_version "${2:-}"
                shift 2
                ;;
            -o|--delete-old)
                cmd_delete_old
                shift
                ;;
            --cache-dir)
                cmd_show_paths
                exit 0
                ;;
            --download-url)
                echo "${DOWNLOAD_URL}"
                exit 0
                ;;
            --)
                shift
                launch_photon "$@"
                exit 0
                ;;
            -*)
                log_error "Unknown option: $1"
                log_info "Use --help to see available options."
                exit 1
                ;;
            *)
                # Non-option argument: pass through to Photon
                launch_photon "$@"
                exit 0
                ;;
        esac
    done
}

main "$@"