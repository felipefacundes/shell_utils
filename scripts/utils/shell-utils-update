# ---------------------------------------------------------------------------
# Logging helper.
# '%b' interprets the ANSI escape sequences embedded in MESSAGES[...],
# producing real colors instead of printing them as literal text.
# '%s' would NOT interpret them. Timestamp has no escapes, so it stays
# uncolored regardless of '%b' or '%s'.
# ---------------------------------------------------------------------------
log_message() {
    printf '%b\n' "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >&2
}

# ---------------------------------------------------------------------------
# Git wrapper: runs git inside LOCAL_PATH without leaking the cd to callers.
# ---------------------------------------------------------------------------
git_command() {
    ( cd "$LOCAL_PATH" || return 1; command git "$@" )
}

# ---------------------------------------------------------------------------
# Verify that LOCAL_PATH is a valid Git repository and that its 'origin'
# remote points to the official repository. This is the primary defense
# against a user replacing the framework with a fork or a malicious repo:
# if origin is redirected, the script aborts before any destructive step.
# Accepts both HTTPS and SSH forms of the official URL.
# ---------------------------------------------------------------------------
verify_repository_integrity() {
    if [ ! -d "$LOCAL_PATH/.git" ]; then
        log_message "${MESSAGES[not_a_git_repo]}"
        return 1
    fi

    local origin_url
    origin_url=$(git_command config --get remote.origin.url 2>/dev/null) || origin_url=""

    case "$origin_url" in
        "https://github.com/$GITHUB_REPO.git"|"https://github.com/$GITHUB_REPO"|"git@github.com:$GITHUB_REPO.git") ;;
        *)
            log_message "${MESSAGES[remote_mismatch]}"
            log_message "Expected: $GITHUB_REPO — Found: ${origin_url:-<empty>}"
            return 1
            ;;
    esac

    return 0
}

# ---------------------------------------------------------------------------
# Detect and repair a corrupted Git index.
# Prevents the "fatal: unknown index entry format 0x706f0000" error from
# becoming permanent: once corrupted, every subsequent run would fail the
# same way without this recovery step. The repair (rm index + git reset)
# only rebuilds the local cache from HEAD; tracked working-tree files are
# left untouched.
# ---------------------------------------------------------------------------
repair_index_if_needed() {
    if git_command status >/dev/null 2>&1; then
        return 0
    fi

    log_message "${MESSAGES[index_repaired]}"

    rm -f "$LOCAL_PATH/.git/index" "$LOCAL_PATH/.git/index.lock" 2>/dev/null
    # Visible output: git reports what it is doing while rebuilding the index.
    git_command reset || return 1

    if ! git_command status >/dev/null 2>&1; then
        log_message "${MESSAGES[was_an_error]}"
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Primary update path: fetch, hard reset to origin/main, restore config.
#
# 'git reset --hard origin/main' is intentional: the framework core must
# always match the official version. Local modifications to tracked files
# are discarded, but untracked files (the user's personal folder) are
# preserved because 'reset --hard' does not touch untracked paths.
#
# Git output is deliberately left visible (no '>/dev/null') so the user
# can see exactly which commit was applied. This does not affect security:
# the commit content is already local after 'fetch'.
# ---------------------------------------------------------------------------
perform_update() {
    (
        local old_hash new_hash
        old_hash=$(git_command rev-parse HEAD 2>/dev/null) || old_hash=""

        # Backup local configuration before touching anything.
        if [ -f "config.local" ]; then
            cp config.local config.local.backup
        fi

        # Fetch the latest from the official repository.
        # 'fetch' output shows what was downloaded.
        if ! git_command fetch origin main; then
            log_message "${MESSAGES[was_an_error]}"
            exit 1
        fi

        # Force the local repository to match origin/main exactly.
        # Git prints "HEAD is now at <hash> <subject>" — the update summary.
        if ! git_command reset --hard origin/main; then
            log_message "${MESSAGES[was_an_error]}"
            exit 1
        fi

        new_hash=$(git_command rev-parse HEAD 2>/dev/null) || new_hash=""

        # Explicit before/after summary and the list of applied commits.
        # Purely informational; no security impact.
        if [ -n "$old_hash" ] && [ -n "$new_hash" ] && [ "$old_hash" != "$new_hash" ]; then
            printf '%b  %s -> %s\n' "${YELLOW}" "${old_hash:0:12}" "${new_hash:0:12}" >&2
            git_command --no-pager log --oneline "${old_hash}..${new_hash}" >&2 || true
        fi

        # Restore local configuration.
        if [ -f "config.local.backup" ]; then
            [ -f "config.local" ] && rm config.local
            mv config.local.backup config.local
        fi

        # Run post-update script if present. Failures here must not abort
        # the update, because the core is already in the desired state.
        if [ -f "post_update.sh" ]; then
            bash post_update.sh || true
        fi

        exit 0
    )
}

# ---------------------------------------------------------------------------
# "Gentle" update path: stash, rebase, fallback to hard reset.
# Kept for compatibility with the original script; not used by the
# default flow. The trap uses '|| true' so a failing stash pop or rebase
# abort inside the trap cannot bring the script down under 'set -e'
# (should -e ever be enabled in the future).
# ---------------------------------------------------------------------------
perform_update_user() {
    (
        local current_hash
        current_hash=$(git_command rev-parse HEAD 2>/dev/null) || exit 1
        local stash_success=0

        if [ -f "config.local" ]; then
            cp config.local config.local.backup
        fi

        git_command stash push -m "shell_utils auto-update backup" &>/dev/null || true

        trap '
            if [ "${stash_success:-0}" -eq 0 ]; then
                git_command stash pop 2>/dev/null || true
                git_command rebase --abort 2>/dev/null || true
                rm -f config.local.backup
            fi
        ' EXIT

        if ! git_command pull --rebase --stat origin main; then
            log_message "${MESSAGES[rebase_error]}"
            printf '%s\n' "${MESSAGES[rebase_abort]}" >&2
            git_command rebase --abort 2>/dev/null || true

            # Restore the exact previous state of tracked files.
            # (Previously used '-- ":!*"' which is a no-op pathspec.)
            git_command reset --hard "$current_hash" 2>/dev/null || true

            if ! git_command pull --stat origin main; then
                git_command stash pop 2>/dev/null || true
                log_message "${MESSAGES[was_an_error]}"
                exit 1
            fi
        fi

        if ! git_command stash pop 2>/dev/null; then
            log_message "${MESSAGES[stash_conflict]}"
        fi
        stash_success=1

        if [ -f "config.local.backup" ]; then
            [ -f "config.local" ] && rm config.local
            mv config.local.backup config.local
        fi

        if [ -f "post_update.sh" ]; then
            bash post_update.sh || true
        fi

        exit 0
    )
}

# ---------------------------------------------------------------------------
# Compare local HEAD with origin/main.
# Returns non-zero on fetch failure so callers do not silently operate on
# stale remote refs (which could otherwise lead to a reset to an old commit).
# Hash variables use the '_SU_' prefix to avoid colliding with generic
# names like LOCAL/REMOTE in the caller's shell.
# ---------------------------------------------------------------------------
check_update() {
    if ! git_command fetch origin main &>/dev/null; then
        return 1
    fi

    _SU_LOCAL_HASH=$(git_command rev-parse HEAD 2>/dev/null) || return 1
    _SU_REMOTE_HASH=$(git_command rev-parse origin/main 2>/dev/null) || return 1
    export _SU_LOCAL_HASH _SU_REMOTE_HASH
    return 0
}

# ---------------------------------------------------------------------------
# Config directory / file bootstrap.
# ---------------------------------------------------------------------------
if [ ! -d "$CONFIG_DIR" ]; then
    mkdir -p "$CONFIG_DIR"
fi

if [ ! -f "$CONFIG_FILE" ]; then
    {
        printf '# If this configuration is not set or is set to 0, automatic updates will be disabled.\n'
        printf 'SHELL_UTILS_AUTO_UPDATE=1\n'
        printf 'UPDATE_CHECK_INTERVAL=21600\n'
    } > "$CONFIG_FILE"
fi

# ---------------------------------------------------------------------------
# Sanitized config loading.
# Replaces a blind 'source "$CONFIG_FILE"' (which would execute arbitrary
# code placed there) with a whitelist parser:
#   - SHELL_UTILS_AUTO_UPDATE accepts only 0 or 1
#   - UPDATE_CHECK_INTERVAL accepts only digits
# Unknown keys are silently ignored.
# ---------------------------------------------------------------------------
if [ -f "$CONFIG_FILE" ]; then
    while IFS='=' read -r key value; do
        [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
        key="${key//[[:space:]]/}"
        value="${value//[[:space:]]/}"
        case "$key" in
            SHELL_UTILS_AUTO_UPDATE)
                [[ "$value" =~ ^[01]$ ]] && SHELL_UTILS_AUTO_UPDATE="$value"
                ;;
            UPDATE_CHECK_INTERVAL)
                [[ "$value" =~ ^[0-9]+$ ]] && UPDATE_CHECK_INTERVAL="$value"
                ;;
            *)
                # Ignore unknown keys silently.
                ;;
        esac
    done < "$CONFIG_FILE"
fi

# ---------------------------------------------------------------------------
# Early exit when automatic updates are disabled and no relevant flag given.
# ---------------------------------------------------------------------------
if [ "$SHELL_UTILS_AUTO_UPDATE" != "1" ]; then
    case "$ARGUMENT" in
        -c|--check|-h|--help) ;;
        *) exit 0 ;;
    esac
fi

# ---------------------------------------------------------------------------
# Clone the framework on first run.
# ---------------------------------------------------------------------------
if [ ! -d "$LOCAL_PATH" ]; then
    log_message "${MESSAGES[framework_not_found]}"
    if ! git clone --depth 1 "https://github.com/$GITHUB_REPO.git" "$LOCAL_PATH"; then
        log_message "${MESSAGES[repo_clone_error]}"
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Argument handling.
# ---------------------------------------------------------------------------
case "$ARGUMENT" in
    -c|--check)
        if ! git ls-remote "https://github.com/$GITHUB_REPO.git" HEAD &>/dev/null; then
            log_message "${MESSAGES[error_no_internet]}"
            exit 1
        fi
        if ! check_update; then
            log_message "${MESSAGES[was_an_error]}"
            exit 1
        fi
        if [ "$_SU_LOCAL_HASH" = "$_SU_REMOTE_HASH" ]; then
            log_message "${MESSAGES[updated]}"
            exit 0
        fi
        rm -f "$UPDATE_LOCK_FILE" "$LAST_UPDATE_FILE"
        export SHELL_UTILS_AUTO_UPDATE=1
        ;;
    -h|--help)
        printf '%s\n' "${MESSAGES[help]}" | less -i
        exit 0
        ;;
esac

# ---------------------------------------------------------------------------
# Connectivity check.
# ---------------------------------------------------------------------------
if ! git ls-remote "https://github.com/$GITHUB_REPO.git" HEAD &>/dev/null; then
    log_message "${MESSAGES[error_no_internet]}"
    exit 1
fi

# ---------------------------------------------------------------------------
# Repository integrity: must be a Git repo and 'origin' must be official.
# Runs BEFORE any destructive operation, so a tampered origin can never be
# used to pull arbitrary content over the framework.
# ---------------------------------------------------------------------------
if ! verify_repository_integrity; then
    exit 1
fi

# ---------------------------------------------------------------------------
# Index health check + auto repair (the '0x706f0000' fix).
# ---------------------------------------------------------------------------
if ! repair_index_if_needed; then
    log_message "${MESSAGES[was_an_error]}"
    exit 1
fi

# ---------------------------------------------------------------------------
# Concurrent-run lock (5-minute window).
# ---------------------------------------------------------------------------
if [ -f "$UPDATE_LOCK_FILE" ]; then
    if stat_output=$(stat -c %Y "$UPDATE_LOCK_FILE" 2>/dev/null); then
        lock_time=$stat_output
        current_time=$(date +%s)
        time_diff=$((current_time - lock_time))
        if [ "$time_diff" -lt 300 ]; then
            exit 0
        fi
    else
        # If stat fails, the file may have been removed; continue normally.
        rm -f "$UPDATE_LOCK_FILE" 2>/dev/null || true
    fi
fi

rm -f "$UPDATE_LOCK_FILE"
touch "$UPDATE_LOCK_FILE"
trap 'rm -f "$UPDATE_LOCK_FILE"' EXIT

# ---------------------------------------------------------------------------
# Respect the last-check timestamp.
# ---------------------------------------------------------------------------
if [ -f "$LAST_UPDATE_FILE" ]; then
    LAST_UPDATE=$(cat "$LAST_UPDATE_FILE")
    NOW=$(date +%s)
    if [ $((NOW - LAST_UPDATE)) -lt "$UPDATE_CHECK_INTERVAL" ]; then
        exit 0
    fi
fi

# ---------------------------------------------------------------------------
# Main update flow.
# ---------------------------------------------------------------------------
if ! check_update; then
    log_message "${MESSAGES[was_an_error]}"
    exit 1
fi

if [ "$_SU_LOCAL_HASH" != "$_SU_REMOTE_HASH" ]; then
    log_message "${MESSAGES[updates_found]}"

    # Re-verify integrity right before the destructive step, shrinking the
    # window between the check and the reset.
    if ! verify_repository_integrity; then
        exit 1
    fi

    if perform_update; then
        log_message "${MESSAGES[update_success]}"
    else
        log_message "${MESSAGES[update_error]}"
        exit 1
    fi
fi

# Record last successful check.
date +%s >| "$LAST_UPDATE_FILE"