#!/usr/bin/env bash
# License: GPLv3
# Credits: Felipe Facundes

set -euo pipefail

# Usage: blender-qremeshify <input_file> <output_file.blend>
# Example: blender-qremeshify model.fbx retopo_result.blend

if [ $# -ne 2 ]; then
    echo "Usage: ${0##*/} <input_file(fbx/glb/blend)> <output_file.blend>"
    exit 1
fi

INPUT_FILE="$1"
OUTPUT_FILE="$2"

# Check input file exists
if [ ! -f "$INPUT_FILE" ]; then
    echo "Error: input file not found: $INPUT_FILE"
    exit 1
fi

# Ensure output filename ends with .blend
if [[ "$OUTPUT_FILE" != *.blend ]]; then
    OUTPUT_FILE="${OUTPUT_FILE}.blend"
fi

# Generate temporary Python script
PYTHON_SCRIPT=$(mktemp /tmp/qremeshify_XXXXXX.py)

cat << 'EOF' | tee "$PYTHON_SCRIPT" &>/dev/null
import bpy
import sys
import os

# Retrieve arguments passed after Blender's "--"
argv = sys.argv
if "--" in argv:
    args = argv[argv.index("--") + 1:]
else:
    args = []

input_path = args[0]
output_path = args[1]

# ----------------------------------------------------------------------
# Tunable parameters
# ----------------------------------------------------------------------

# Maximum polygon count allowed before QRemeshify is executed.
# Above this threshold, a Decimate modifier is applied automatically.
# Lower values = faster processing, safer for 16GB RAM machines.
MAX_FACES = 50000

# If a single object still exceeds this after decimation, split it
# into loose parts and process each part separately.
SPLIT_THRESHOLD = 80000

# Enable or disable QRemeshify's internal Preprocess step.
# Set to False if you already cleaned the mesh manually.
ENABLE_PREPROCESS = False

# ----------------------------------------------------------------------

print(f"[QRemeshify Auto] Input: {input_path}")
print(f"[QRemeshify Auto] Output: {output_path}")
print(f"[QRemeshify Auto] MAX_FACES threshold: {MAX_FACES}")
print(f"[QRemeshify Auto] SPLIT_THRESHOLD: {SPLIT_THRESHOLD}")
print(f"[QRemeshify Auto] ENABLE_PREPROCESS: {ENABLE_PREPROCESS}")

# 1. Clear scene
bpy.ops.wm.read_factory_settings(use_empty=True)

# 2. Enable QRemeshify addon explicitly
try:
    bpy.ops.preferences.addon_enable(module="bl_ext.user_default.qremeshify")
    print("[QRemeshify Auto] Addon enabled")
except Exception as e:
    print(f"[QRemeshify Auto] Failed to enable addon: {e}")
    sys.exit(1)

# 3. Import model
ext = os.path.splitext(input_path)[1].lower()

if ext == ".fbx":
    bpy.ops.import_scene.fbx(filepath=input_path)
elif ext == ".glb" or ext == ".gltf":
    bpy.ops.import_scene.gltf(filepath=input_path)
elif ext == ".blend":
    bpy.ops.wm.open_mainfile(filepath=input_path)
else:
    print(f"[QRemeshify Auto] Unsupported file format: {ext}")
    sys.exit(1)

# 4. Find the largest mesh object
mesh_objects = [obj for obj in bpy.context.scene.objects if obj.type == 'MESH']
if not mesh_objects:
    print("[QRemeshify Auto] No mesh object found in scene")
    sys.exit(1)

obj = max(mesh_objects, key=lambda o: len(o.data.polygons))
initial_faces = len(obj.data.polygons)
print(f"[QRemeshify Auto] Processing object: {obj.name} ({initial_faces} faces)")

# 5. Deselect everything, select only target
bpy.ops.object.select_all(action='DESELECT')
obj.select_set(True)
bpy.context.view_layer.objects.active = obj
bpy.context.view_layer.update()

# 6. Conditional Decimate
if initial_faces > MAX_FACES:
    ratio = MAX_FACES / initial_faces
    print(f"[QRemeshify Auto] Face count exceeds threshold "
          f"({initial_faces} > {MAX_FACES}), applying Decimate "
          f"(ratio={ratio:.4f})")
    decimate_mod = obj.modifiers.new("Decimate", 'DECIMATE')
    decimate_mod.ratio = ratio
    decimate_mod.use_collapse_triangulate = True
    bpy.context.view_layer.objects.active = obj
    try:
        bpy.ops.object.modifier_apply(modifier=decimate_mod.name)
        print(f"[QRemeshify Auto] Decimated to {len(obj.data.polygons)} faces")
    except Exception as e:
        print(f"[QRemeshify Auto] Failed to apply Decimate: {e}")
        sys.exit(1)
else:
    print(f"[QRemeshify Auto] Face count within threshold "
          f"({initial_faces} <= {MAX_FACES}), skipping Decimate")

# 7. Aggressive mesh cleanup (always run)
print("[QRemeshify Auto] Cleaning up mesh geometry...")
bpy.context.view_layer.objects.active = obj
try:
    bpy.ops.object.mode_set(mode='EDIT')
    bpy.ops.mesh.select_all(action='SELECT')
    # Remove loose vertices/edges
    bpy.ops.mesh.delete_loose()
    # Dissolve degenerate geometry (zero-area faces, zero-length edges)
    bpy.ops.mesh.dissolve_degenerate()
    # Merge duplicate vertices within a tiny threshold
    bpy.ops.mesh.remove_doubles(threshold=0.0001)
    # Make normals consistent (avoid inverted faces)
    bpy.ops.mesh.normals_make_consistent(inside=False)
    bpy.ops.object.mode_set(mode='OBJECT')
    print(f"[QRemeshify Auto] Cleanup done. Faces: {len(obj.data.polygons)}")
except Exception as e:
    print(f"[QRemeshify Auto] Cleanup failed: {e}")
    try:
        bpy.ops.object.mode_set(mode='OBJECT')
    except Exception:
        pass
    sys.exit(1)

# 8. Split into loose parts if still too large
current_faces = len(obj.data.polygons)
if current_faces > SPLIT_THRESHOLD:
    print(f"[QRemeshify Auto] Object still has {current_faces} faces "
          f"(> {SPLIT_THRESHOLD}), splitting into loose parts...")
    bpy.ops.object.select_all(action='DESELECT')
    obj.select_set(True)
    bpy.context.view_layer.objects.active = obj
    try:
        bpy.ops.object.mode_set(mode='EDIT')
        bpy.ops.mesh.select_all(action='SELECT')
        bpy.ops.mesh.separate(type='LOOSE')
        bpy.ops.object.mode_set(mode='OBJECT')
        print("[QRemeshify Auto] Split complete")
    except Exception as e:
        print(f"[QRemeshify Auto] Split failed: {e}")
        try:
            bpy.ops.object.mode_set(mode='OBJECT')
        except Exception:
            pass
        sys.exit(1)

# Collect all mesh objects to process (single object, or all split parts)
target_objects = [o for o in bpy.context.scene.objects if o.type == 'MESH']
print(f"[QRemeshify Auto] Objects to process: {[o.name for o in target_objects]}")

# 9. Configure QRemeshify parameters (once, on the scene)
try:
    qw = bpy.context.scene.quadwild_props
    qw.enableRemesh = ENABLE_PREPROCESS
    qw.enableSmoothing = True
    qw.enableSharp = True
    qw.sharpAngle = 35.0
    qw.symmetryX = False
    qw.symmetryY = False
    qw.symmetryZ = False
    qw.debug = False
    qw.useCache = False
except AttributeError as e:
    print(f"[QRemeshify Auto] Failed to access quadwild_props: {e}")
    sys.exit(1)

try:
    qp = bpy.context.scene.quadpatches_props
    qp.scaleFact = 1.0
    qp.alpha = 0.005
except AttributeError as e:
    print(f"[QRemeshify Auto] Failed to access quadpatches_props: {e}")
    sys.exit(1)

# 10. Execute Remesh on each target object
for target in target_objects:
    target_faces = len(target.data.polygons)
    print(f"[QRemeshify Auto] --- Remeshing {target.name} "
          f"({target_faces} faces) ---")

    bpy.ops.object.select_all(action='DESELECT')
    target.select_set(True)
    bpy.context.view_layer.objects.active = target
    bpy.context.view_layer.update()

    try:
        with bpy.context.temp_override(
            selected_objects=[target],
            selected_editable_objects=[target],
            active_object=target,
            object=target,
        ):
            result = bpy.ops.qremeshify.remesh()
        if 'FINISHED' in result:
            print(f"[QRemeshify Auto] Remesh completed for {target.name}")
        else:
            print(f"[QRemeshify Auto] Operator returned {result} "
                  f"for {target.name}")
    except Exception as e:
        print(f"[QRemeshify Auto] Remesh failed for {target.name}: {e}")
        # Continue with the next object instead of aborting everything
        continue

# 11. Save output file
bpy.ops.wm.save_as_mainfile(filepath=output_path)
print(f"[QRemeshify Auto] Saved to: {output_path}")
EOF

# Run Blender in background
echo "[QRemeshify Auto] Launching Blender in background..."
blender --background --addons bl_ext.user_default.qremeshify --python "$PYTHON_SCRIPT" -- "$INPUT_FILE" "$OUTPUT_FILE"

# Clean up temporary script
rm -f "$PYTHON_SCRIPT"

echo "[QRemeshify Auto] Done"