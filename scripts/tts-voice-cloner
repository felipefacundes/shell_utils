#!/usr/bin/env bash
# License: GPLv3
# Credits: Felipe Facundes

: <<'DOCUMENTATION'
TTS Voice Cloner
=================

Command-line voice-cloning text-to-speech tool built on top of Coqui XTTS v2.

Given a >=10 second WAV sample of a voice, it clones that voice and reads
arbitrary text out loud (or saves it to a WAV file), with optional pitch,
speed and volume adjustments (e.g. a deep "Batman" voice or a high-pitched
one), plus quality/stability controls (temperature, repetition penalty) and
automatic reference-audio cleanup to reduce noise and artifacts.

Basic usage
-----------
    tts_voice_cloner.py -t "Hello, how are you?" -l en -m john.wav
    tts_voice_cloner.py -f story.txt -l pt -m mary.wav -o story.wav
    tts_voice_cloner.py -t "I am the night" -l en -m john.wav --deep

Run with --help for the full list of options.

LICENSE
    GPLv3

CREDITS
    Felipe Facundes
DOCUMENTATION

PYTHON_SCRIPT="/tmp/tts-voice-cloner.py"
PYTHON_VERSION="3.13.15"
SCRIPT_NAME="${0##*/}"

py_version="${HOME}/.pyenv/versions/${PYTHON_VERSION}/bin/python"
py_venv="${HOME}/.python/${SCRIPT_NAME}"
activate="${py_venv}/bin/activate"

# ---------------------------------------------------------------------------
# GPU auto-detection
#
# Installs the PyTorch build that actually matches the machine: the right
# CUDA wheel for NVIDIA (picked from the installed driver's max supported
# CUDA version, not just the card model), ROCm for AMD, XPU for Intel, or a
# plain CPU build when no supported GPU/driver is found.
#
# NOTE ON torch 2.7.0 PIN: coqui-tts 0.27.2 has been confirmed (through
# direct testing) to work with torch/torchaudio 2.7.0 on cu126, but NOT
# with torch 2.9 -- this is a coqui-tts/XTTS compatibility ceiling, not a
# GPU-model or driver quirk. NVIDIA drivers are backward-compatible (a
# driver that supports e.g. CUDA 13.0 can still run cu126-built binaries
# just fine), so the pin below applies whenever the driver supports AT
# LEAST CUDA 12.6 -- not only when the driver's own max happens to equal
# 12.6 exactly. "Newest driver support" is deliberately NOT used to pick a
# newer wheel here, because newer breaks this specific coqui-tts version.
# ---------------------------------------------------------------------------

get_driver_cuda() {
    # Prints the max CUDA runtime version the installed NVIDIA driver
    # supports (the "CUDA Version" field reported by `nvidia-smi`), or
    # nothing if it can't be determined.
    nvidia-smi 2>/dev/null | grep -oP 'CUDA Version:\s*\K[0-9]+\.[0-9]+' | head -n1
}

get_cuda_version() {
    # Best-effort fallback for drivers OLDER than CUDA 12.6 (too old for
    # the validated cu126+torch2.7.0 combo): returns the newest PyTorch
    # wheel tag that driver can still run, untested with coqui-tts.
    #
    # Self-contained on purpose (candidates declared locally, not in an
    # outer array) so this still works correctly if copy-pasted or tested
    # on its own.
    local candidates=(
        "cu121:12.1"
        "cu118:11.8"
    )

    local driver_cuda
    driver_cuda=$(get_driver_cuda)

    if [[ -z "$driver_cuda" ]]; then
        echo "cpu"
        return
    fi

    local entry tag min_ver
    for entry in "${candidates[@]}"; do
        tag="${entry%%:*}"
        min_ver="${entry##*:}"
        if awk -v a="$driver_cuda" -v b="$min_ver" 'BEGIN { exit !(a >= b) }'; then
            echo "$tag"
            return
        fi
    done

    echo "cpu"  # driver is older than every wheel we know about
}

gpu_detect() {
    if ! command -v lspci >/dev/null 2>&1; then
        echo "⚠️  'lspci' not found -- can't detect the GPU, installing PyTorch for CPU."
        pip install --force-reinstall torch torchaudio
        return
    fi

    local gpu_line
    gpu_line=$(lspci | grep -Ei "VGA|3D")

    if echo "$gpu_line" | grep -qi nvidia; then
        echo "🔍 NVIDIA GPU detected"

        if ! command -v nvidia-smi >/dev/null 2>&1; then
            echo "⚠️  nvidia-smi not found -- NVIDIA driver doesn't seem to be installed. Falling back to CPU."
            pip install --force-reinstall torch torchaudio
            return
        fi

        local driver_cuda
        driver_cuda=$(get_driver_cuda)

        if [[ -z "$driver_cuda" ]]; then
            echo "⚠️  Could not read the driver's CUDA version from nvidia-smi. Falling back to CPU."
            pip install --force-reinstall torch torchaudio

        elif awk -v a="$driver_cuda" 'BEGIN { exit !(a >= 12.6) }'; then
            # Driver supports CUDA >= 12.6 -> use the validated combo,
            # regardless of how much newer the driver actually is.
            echo "📌 Driver supports CUDA $driver_cuda (>= 12.6) -> pinning torch/torchaudio 2.7.0 + cu126 (coqui-tts 0.27.2 is known-broken on newer torch)"
            pip install torch==2.7.0 torchaudio==2.7.0 --index-url https://download.pytorch.org/whl/cu126 --force-reinstall

        else
            # Driver older than 12.6 -- best-effort fallback, untested
            # with coqui-tts 0.27.2.
            local cuda_tag
            cuda_tag=$(get_cuda_version)
            if [[ "$cuda_tag" == "cpu" ]]; then
                echo "⚠️  Driver's CUDA $driver_cuda is older than every supported PyTorch wheel. Falling back to CPU."
                pip install --force-reinstall torch torchaudio
            else
                echo "📊 Driver's CUDA $driver_cuda is below 12.6 -> best-effort wheel: $cuda_tag (untested with coqui-tts 0.27.2)"
                pip install --force-reinstall torch torchaudio --index-url "https://download.pytorch.org/whl/${cuda_tag}"
            fi
        fi

    elif echo "$gpu_line" | grep -Eqi "\bAMD\b|\bATI\b"; then
        echo "🔍 AMD GPU detected"
        pip install --force-reinstall torch torchaudio --index-url https://download.pytorch.org/whl/rocm6.4

    elif echo "$gpu_line" | grep -qi intel; then
        echo "🔍 Intel GPU detected"
        pip install --force-reinstall torch torchaudio --index-url https://download.pytorch.org/whl/xpu

    else
        echo "⚠️  No dedicated GPU detected - installing PyTorch for CPU"
        pip install --force-reinstall torch torchaudio
    fi
}

# CREATE PYTHON SCRIPT

cat << 'EOF' | tee "$PYTHON_SCRIPT" &>/dev/null
#!/usr/bin/env python3
# License: GPLv3
# Credits: Felipe Facundes

"""
TTS Voice Cloner
=================

Command-line voice-cloning text-to-speech tool built on top of Coqui XTTS v2.

Given a >=10 second WAV sample of a voice, it clones that voice and reads
arbitrary text out loud (or saves it to a WAV file), with optional pitch,
speed and volume adjustments (e.g. a deep "Batman" voice or a high-pitched
one), plus quality/stability controls (temperature, repetition penalty) and
automatic reference-audio cleanup to reduce noise and artifacts.

Basic usage
-----------
    tts-voice-cloner.py -t "Hello, how are you?" -l en -m john.wav
    tts-voice-cloner.py -f story.txt -l pt -m mary.wav -o story.wav
    tts-voice-cloner.py -t "I am the night" -l en -m john.wav --deep

Run with --help for the full list of options.
"""

import argparse
import os
import platform
import shutil
import sys
import tempfile
import warnings
from pathlib import Path

# ---------------------------------------------------------------------------
# Project directories
#
# Everything the tool needs (voice model samples, downloaded engine weights,
# etc.) lives inside a single hidden project folder, whose location depends
# on the operating system:
#
#   Linux   -> ~/.config/tts_voice_cloner
#   macOS   -> ~/Library/Application Support/tts_voice_cloner
#   Windows -> %APPDATA%\tts_voice_cloner
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Auto-accept the Coqui XTTS v2 model license (CPML).
#
# This MUST happen before "TTS" is imported anywhere, because coqui-tts reads
# this environment variable at import/first-use time to decide whether to
# prompt interactively for Terms of Service acceptance. Setting it here makes
# the tool fully non-interactive on first run.
# ---------------------------------------------------------------------------
os.environ.setdefault("COQUI_TOS_AGREED", "1")

def get_base_dir() -> Path:
    system = platform.system()
    if system == "Windows":
        root = os.getenv("APPDATA") or str(Path.home() / "AppData" / "Roaming")
        return Path(root) / "tts_voice_cloner"
    if system == "Darwin":
        return Path.home() / "Library" / "Application Support" / "tts_voice_cloner"
    # Linux and other Unix-like systems
    root = os.getenv("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(root) / "tts_voice_cloner"


BASE_DIR = get_base_dir()
MODELS_DIR = BASE_DIR / "models"   # voice sample WAVs to be cloned
ENGINE_DIR = BASE_DIR / "engine"   # downloaded XTTS v2 weights live here


def ensure_dirs() -> None:
    MODELS_DIR.mkdir(parents=True, exist_ok=True)
    ENGINE_DIR.mkdir(parents=True, exist_ok=True)


# Redirect Coqui TTS's own model cache into our project folder.
# This MUST be set before "TTS" is imported anywhere.
os.environ.setdefault("TTS_HOME", str(ENGINE_DIR))

XTTS_MODEL_NAME = "tts_models/multilingual/multi-dataset/xtts_v2"

# ---------------------------------------------------------------------------
# Languages supported by XTTS v2
# ---------------------------------------------------------------------------

SUPPORTED_LANGUAGES = {
    "en": "English",
    "es": "Spanish",
    "fr": "French",
    "de": "German",
    "it": "Italian",
    "pt": "Portuguese",
    "pl": "Polish",
    "tr": "Turkish",
    "ru": "Russian",
    "nl": "Dutch",
    "cs": "Czech",
    "ar": "Arabic",
    "zh-cn": "Chinese (Simplified)",
    "ja": "Japanese",
    "hu": "Hungarian",
    "ko": "Korean",
    "hi": "Hindi",
}

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="tts-voice-cloner.py",
        description="Clone a voice from a WAV sample and turn text into speech (Coqui XTTS v2).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    parser.add_argument(
        "-t", "--text",
        help="Text to synthesize, in the target language, wrapped in quotes.",
    )
    parser.add_argument(
        "-f", "--file",
        help="Path to a .txt file containing the text to synthesize.",
    )
    parser.add_argument(
        "-l", "--language",
        choices=sorted(SUPPORTED_LANGUAGES),
        metavar="LANG",
        help="Target language code (" + ", ".join(sorted(SUPPORTED_LANGUAGES)) + ").",
    )
    parser.add_argument(
        "-m", "--model",
        help="Voice sample file name (>=10s WAV) inside the models folder, "
             "or a path to a WAV file elsewhere.",
    )
    parser.add_argument(
        "-o", "--output",
        help="Save the result to this WAV file instead of playing it aloud.",
    )

    adj = parser.add_argument_group("voice adjustments")
    adj.add_argument(
        "--pitch", type=float, default=0.0,
        help="Pitch shift in semitones. Positive = higher voice, negative = "
             "deeper voice. Default: 0. Applied as post-processing; large "
             "shifts (beyond ~6 semitones) start to sound artificial.",
    )
    adj.add_argument(
        "--speed", type=float, default=1.0,
        help="Speech rate, generated natively by the model (not post-processed, "
             "so it stays cleaner). 1.0 = normal. Values far from 1.0 (below "
             "~0.7 or above ~1.3) can introduce artifacts. Default: 1.0.",
    )
    adj.add_argument(
        "--volume", type=float, default=0.0,
        help="Volume gain in dB. Positive boosts, negative reduces. Default: 0. "
             "Automatically peak-limited to avoid clipping distortion.",
    )
    adj.add_argument(
        "--deep", action="store_true",
        help="Preset: deep 'Batman-like' voice (pitch -6 semitones).",
    )
    adj.add_argument(
        "--high", action="store_true",
        help="Preset: high-pitched voice (pitch +6 semitones).",
    )

    quality = parser.add_argument_group(
        "quality / stability",
        "Control how clean vs. expressive the generated speech is. If you're "
        "hearing noise, crackle, stutters or mumbling, try lowering "
        "--temperature and/or raising --repetition-penalty first.",
    )
    quality.add_argument(
        "--temperature", type=float, default=0.65,
        help="Sampling randomness. Lower = more stable/monotone/cleaner, "
             "higher = more expressive but more prone to noise-like artifacts. "
             "XTTS default is ~0.75; default here is 0.65. Range ~0.3-1.0.",
    )
    quality.add_argument(
        "--repetition-penalty", type=float, default=3.0,
        help="Penalizes the model for repeating itself. Higher values reduce "
             "stutters, long silences and glitchy artifacts. Default: 3.0 "
             "(XTTS's own default is 2.0). Range ~1.0-8.0.",
    )
    quality.add_argument(
        "--top-k", type=int, default=50,
        help="Sampling pool size. Lower = safer/cleaner, higher = more varied. Default: 50.",
    )
    quality.add_argument(
        "--top-p", type=float, default=0.8,
        help="Nucleus sampling threshold. Lower = safer/cleaner, higher = more varied. Default: 0.8.",
    )
    quality.add_argument(
        "--no-clean-reference", action="store_true",
        help="Skip automatic cleanup (silence trimming + peak normalization) "
             "of the reference voice sample before cloning. Cleanup is on by "
             "default because a noisy/quiet/silence-padded reference is the "
             "single biggest cause of a noisy clone.",
    )

    misc = parser.add_argument_group("misc")
    misc.add_argument(
        "--list-models", action="store_true",
        help=f"List voice samples currently in {MODELS_DIR} and exit.",
    )
    misc.add_argument(
        "--list-languages", action="store_true",
        help="List supported language codes and exit.",
    )
    misc.add_argument(
        "--gpu", action="store_true",
        help="Force GPU usage. By default GPU is used automatically if available.",
    )

    return parser


def validate_args(parser: argparse.ArgumentParser, args: argparse.Namespace) -> None:
    if args.list_models or args.list_languages:
        return
    if not args.text and not args.file:
        parser.error("one of the arguments -t/--text -f/--file is required")
    if args.text and args.file:
        parser.error("arguments -t/--text and -f/--file are mutually exclusive")
    if not args.language:
        parser.error("the following argument is required: -l/--language")
    if not args.model:
        parser.error("the following argument is required: -m/--model")
    if args.deep and args.high:
        parser.error("arguments --deep and --high are mutually exclusive")


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def prepare_reference_audio(speaker_wav: Path, tmp_dir: Path, clean: bool) -> Path:
    """Trim leading/trailing silence and peak-normalize the reference sample.

    A noisy, too quiet, or silence-padded reference clip is the single
    biggest cause of a noisy/unstable clone -- cleaning it up here usually
    helps far more than any post-processing on the generated audio.
    """
    if not clean:
        return speaker_wav

    try:
        import librosa
        import numpy as np
        import soundfile as sf
    except ImportError:
        # Best-effort: fall back to the raw file if librosa isn't available.
        return speaker_wav

    y, sr = librosa.load(speaker_wav, sr=None, mono=True)
    y, _ = librosa.effects.trim(y, top_db=30)

    peak = float(np.max(np.abs(y))) if y.size else 0.0
    if peak > 0:
        y = y / peak * 0.95  # normalize to a safe peak without clipping

    cleaned_path = tmp_dir / "reference_clean.wav"
    sf.write(cleaned_path, y, sr)
    return cleaned_path


def resolve_model_path(model_arg: str) -> Path:
    """Find the voice sample either as a direct path or inside MODELS_DIR."""
    candidate = Path(model_arg).expanduser()
    if candidate.is_file():
        return candidate

    in_models_dir = MODELS_DIR / model_arg
    if in_models_dir.is_file():
        return in_models_dir

    sys.exit(
        f"Error: voice model '{model_arg}' not found.\n"
        f"Looked for it as a direct path and inside: {MODELS_DIR}\n"
        f"Tip: drop your >=10s WAV sample into that folder, or pass "
        f"--list-models to see what's already there."
    )


def read_text_input(args: argparse.Namespace) -> str:
    if args.file:
        path = Path(args.file).expanduser()
        if not path.is_file():
            sys.exit(f"Error: text file not found: {path}")
        text = path.read_text(encoding="utf-8").strip()
    else:
        text = args.text.strip()

    if not text:
        sys.exit("Error: no text provided.")
    return text


def list_models() -> None:
    wavs = sorted(MODELS_DIR.glob("*.wav"))
    if not wavs:
        print(f"No voice models found in {MODELS_DIR}")
        print("Add a WAV file (10s or longer) of the voice you want to clone there.")
        return
    print(f"Voice models in {MODELS_DIR}:")
    for w in wavs:
        print(f"  {w.name}")


def list_languages() -> None:
    for code, name in sorted(SUPPORTED_LANGUAGES.items()):
        print(f"{code}\t{name}")


# ---------------------------------------------------------------------------
# Synthesis
# ---------------------------------------------------------------------------


def synthesize(
    text: str,
    language: str,
    speaker_wav: Path,
    out_path: Path,
    force_gpu: bool,
    speed: float,
    temperature: float,
    repetition_penalty: float,
    top_k: int,
    top_p: float,
) -> None:
    try:
        from TTS.api import TTS
    except ImportError:
        sys.exit(
            "Error: the 'TTS' package is not installed.\n"
            "Install dependencies with: pip install -r requirements.txt"
        )

    import torch

    if force_gpu and not torch.cuda.is_available():
        sys.exit("Error: --gpu was requested but no CUDA GPU is available.")

    device = "cuda" if (force_gpu or torch.cuda.is_available()) else "cpu"
    print(f"Loading XTTS v2 on {device} (first run downloads the model, this can take a while)...",
          file=sys.stderr)

    tts = TTS(XTTS_MODEL_NAME).to(device)
    tts.tts_to_file(
        text=text,
        speaker_wav=str(speaker_wav),
        language=language,
        file_path=str(out_path),
        # Native XTTS generation parameters -- these produce far cleaner
        # results than post-processing the audio afterward would.
        speed=speed,
        temperature=temperature,
        repetition_penalty=repetition_penalty,
        top_k=top_k,
        top_p=top_p,
        enable_text_splitting=True,
    )


def apply_adjustments(wav_path: Path, pitch_semitones: float, volume_db: float) -> None:
    """Post-process pitch and volume. Speed is handled natively during
    synthesis (see synthesize()), since post-hoc time-stretching introduces
    far more audible artifacts than the model's own speed control."""
    if pitch_semitones == 0 and volume_db == 0:
        return

    try:
        import librosa
        import numpy as np
        import soundfile as sf
    except ImportError:
        sys.exit(
            "Error: 'librosa'/'soundfile' are required for voice adjustments.\n"
            "Install dependencies with: pip install -r requirements.txt"
        )

    y, sr = librosa.load(wav_path, sr=None)

    if pitch_semitones != 0:
        # librosa's pitch_shift internally emits harmless FutureWarnings
        # about deprecated phase_vocoder parameters (librosa's own code,
        # nothing we control) -- silence just those, scoped to this call.
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", category=FutureWarning)
            warnings.simplefilter("ignore", category=RuntimeWarning)
            y = librosa.effects.pitch_shift(y, sr=sr, n_steps=pitch_semitones)

        if not np.all(np.isfinite(y)):
            # On very short clips the shift can occasionally produce a few
            # NaN/Inf samples; sanitize instead of writing a corrupted or
            # silent file.
            print("Warning: pitch shift produced invalid samples on this "
                  "(likely very short) clip; they were zeroed out.", file=sys.stderr)
            y = np.nan_to_num(y, nan=0.0, posinf=0.0, neginf=0.0)

    if volume_db != 0:
        factor = 10 ** (volume_db / 20)
        y = y * factor
        # Soft peak-limit instead of hard clipping: hard clipping is a
        # direct source of harsh, crackly noise when boosting volume.
        peak = float(np.max(np.abs(y))) if y.size else 0.0
        if peak > 0.99:
            y = y / peak * 0.99

    sf.write(wav_path, y, sr)


def play_audio(wav_path: Path) -> None:
    try:
        import sounddevice as sd
        import soundfile as sf
    except ImportError:
        sys.exit(
            "Error: 'sounddevice'/'soundfile' are required to play audio.\n"
            "Install dependencies with: pip install -r requirements.txt\n"
            "Alternatively, use -o/--output to save to a WAV file instead."
        )

    data, sr = sf.read(wav_path, dtype="float32")
    sd.play(data, sr)
    sd.wait()


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def main() -> None:
    ensure_dirs()
    parser = build_arg_parser()
    args = parser.parse_args()
    validate_args(parser, args)

    if args.list_languages:
        list_languages()
        return
    if args.list_models:
        list_models()
        return

    pitch = args.pitch
    if args.deep:
        pitch -= 6
    if args.high:
        pitch += 6

    text = read_text_input(args)
    speaker_wav = resolve_model_path(args.model)

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_path = Path(tmp_dir)
        clean_speaker_wav = prepare_reference_audio(
            speaker_wav, tmp_path, clean=not args.no_clean_reference
        )

        raw_path = tmp_path / "raw.wav"
        synthesize(
            text, args.language, clean_speaker_wav, raw_path, args.gpu,
            speed=args.speed,
            temperature=args.temperature,
            repetition_penalty=args.repetition_penalty,
            top_k=args.top_k,
            top_p=args.top_p,
        )
        apply_adjustments(raw_path, pitch, args.volume)

        if args.output:
            out_path = Path(args.output).expanduser()
            out_path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(raw_path, out_path)
            print(f"Saved to {out_path}")
        else:
            print("Playing audio...")
            play_audio(raw_path)


if __name__ == "__main__":
    main()
EOF

[[ -f "$PYTHON_SCRIPT" && ! -x "$PYTHON_SCRIPT" ]] && chmod +x "$PYTHON_SCRIPT"

show_doc() {
    local doc
    doc=$(sed -n "/^: <<'DOCUMENTATION'$/,/^DOCUMENTATION$/p" "$0" | sed '1d;$d')
    echo "$doc"
    exit 0
}

if [[ "${1,,}" == "-d" || "${1,,}" == "--doc" ]]; then
    show_doc
fi

# Remove virtual environment and cloned project, then exit
if [[ "${1,,}" == "--clean" || "${1,,}" == "-c" ]]; then
    if [[ -d "${py_venv}" ]]; then
        echo "Cleaning virtual environment..."
        rm -rf "${py_venv}"
        echo "Virtual environment removed."
    fi
    exit 0
fi

if ! command -v pyenv >/dev/null 2>&1; then
    echo "Error: pyenv is not installed. Install it with: sudo pacman -S pyenv"
    exit 1
elif [[ ! -f "${py_version}" ]] && ! pyenv versions --bare | grep -qx "${PYTHON_VERSION}"; then
    echo "Installing Python ${PYTHON_VERSION}..."
    pyenv install "${PYTHON_VERSION}"
fi

# Create virtual environment if it does not exist yet
if [[ ! -d "${py_venv}" && -f "${py_version}" ]]; then
    echo "Creating virtual environment with Python ${PYTHON_VERSION} at ${py_venv}..."
    "${py_version}" -m venv "${py_venv}"

    #shellcheck source=/dev/null
    source "$activate"
    export VIRTUAL_ENV="$py_venv"

    echo "Upgrading pip..."
    pip install --upgrade pip

    # TTS Support
    # NOTE: coqui-tts >= 0.27.3 no longer installs PyTorch (torch/torchaudio/
    # torchcodec) as a dependency, which breaks the XTTS v2 workflow unless
    # those are installed manually first. 0.27.2 is the last version that
    # bundles them, so we pin here deliberately -- do NOT bump this without
    # also reordering the install steps and re-testing GPU detection.
    pip install "coqui-tts==0.27.2" "sounddevice>=0.4.6"

    # Auto-detect GPU (NVIDIA / AMD / Intel) and (re)install the matching
    # PyTorch build; falls back to CPU automatically if none is found.
    gpu_detect

    echo "Installation complete!"
fi

# Check if the virtual environment is actually usable
if [ ! -e "$activate" ]; then
    echo "Python environment is empty."
    exit 1
fi

# Activate venv if not already active
if [[ -z "$VIRTUAL_ENV" ]]; then
    echo "Activating virtual environment..."
    export VIRTUAL_ENV="$py_venv"
    #shellcheck source=/dev/null
    source "$activate"
fi

echo
python --version
