# -*- coding: utf-8 -*-
"""
deepseek-cli - Use DeepSeek (or any OpenAI-compatible API) from the Linux terminal.

Single file, standard library only (no pip install required).
Config file: ~/.config/deepseek-cli/deepseek-cli.conf (auto-created on first run).
Everything provider-specific (base URL, API key, model, endpoints, auth header,
extra headers...) lives in that file, so switching between DeepSeek, Ollama,
OpenRouter, etc. never requires editing this script.
Output language follows the system locale (en / pt) and can be forced with --lang.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from configparser import ConfigParser, Error as ConfigError
from pathlib import Path

APP = "deepseek-cli"
VERSION = "1.1.0"

SUPPORTED_LANGS = ("en", "pt")

# These values are used ONLY to generate the config file template on first run
# (and as a fallback for options missing in older config files). At runtime,
# the program always reads the provider settings from the config file.
TEMPLATE_DEFAULTS = {
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-chat",
    "chat_path": "/chat/completions",
    "models_path": "/models",
    "balance_path": "/user/balance",
    "auth_header": "Authorization",
    "auth_scheme": "Bearer",
    "reasoning_field": "reasoning_content",
    "signup_url": "https://platform.deepseek.com/sign_up",
    "topup_url": "https://platform.deepseek.com/top_up",
    "keys_url": "https://platform.deepseek.com/api_keys",
    "docs_url": "https://api-docs.deepseek.com/",
}

_xdg_config = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
_xdg_state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
CONFIG_DIR = Path(_xdg_config) / APP
CONFIG_FILE = CONFIG_DIR / f"{APP}.conf"
HISTORY_FILE = Path(_xdg_state) / APP / "history"

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_USAGE = 2
EXIT_CONFIG = 78
EXIT_INTERRUPT = 130


