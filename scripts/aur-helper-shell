# ----------------------------------------------------------------------------
# Small helpers
# ----------------------------------------------------------------------------
info() { printf '%s::%s %s\n' "$BLUE" "$NC" "$*"; }
ok()   { printf '%s✓%s %s\n' "$GREEN" "$NC" "$*"; }
warn() { printf '%s⚠%s %s\n' "$YELLOW" "$NC" "$*" >&2; }
err()  { printf '%s✗%s %s\n' "$RED" "$NC" "$*" >&2; }
die()  { err "$*"; exit 1; }

have() { command -v "$1" &>/dev/null; }
is_interactive() { [[ -t 0 && -t 1 ]]; }
urlencode() { jq -rn --arg v "$1" '$v|@uri'; }
fmt_date() { date -d "@$1" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$1"; }
trunc() { local s="$1" max="$2"; (( max < 4 )) && max=4; (( ${#s} > max )) && s="${s:0:max-1}…"; printf '%s' "$s"; }
term_width() { local w=${COLUMNS:-0}; (( w )) || w=$(tput cols 2>/dev/null) || w=100; printf '%s' "$w"; }

# confirm "prompt" [y|n]  -> default applies on Enter, --noconfirm and non-tty
confirm() {
    local prompt="$1" default="${2:-n}" reply hint
    if [[ $default == y ]]; then hint=$(L 'Y/n' 'S/n'); else hint=$(L 'y/N' 's/N'); fi
    if (( CFG_NOCONFIRM )) || [[ ! -t 0 ]]; then [[ $default == y ]]; return; fi
    read -rp "$prompt [$hint] " reply || return 1
    [[ -z $reply ]] && reply=$default
    [[ $reply =~ ^[SsYy]$ ]]
}

need_args() {
    if (( ${#ARGS[@]} < ${1:-1} )); then err "$(t err_no_pkg)"; return 1; fi
}

log_event() { # action pkg version
    mkdir -p "$STATE_DIR"
    printf '%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" "$2" "${3:-}" >> "$HISTORY_FILE"
}

load_config() {
    local f="$CONFIG_DIR/config"
    # shellcheck source=/dev/null
    [[ -r $f ]] && source "$f"
}

ensure_deps() {
    have pacman || die "$(t need_arch)"
    local -a missing=()
    have jq  || missing+=(jq)
    have git || missing+=(git)
    { have curl || have wget; } || missing+=(curl)
    if (( ${#missing[@]} )); then
        warn "$(t missing_tools "${missing[*]}")"
        if confirm "$(t install_tools_q)" y; then
            "${SUDO[@]}" pacman -S --needed "${missing[@]}" || exit 1
        else
            exit 1
        fi
    fi
}

ensure_build_tools() {
    (( EUID == 0 )) && die "$(t not_root)"
    if ! have makepkg || ! have fakeroot; then
        warn "$(t need_basedevel)"
        confirm "$(t install_tools_q)" y || return 1
        "${SUDO[@]}" pacman -S --needed base-devel || return 1
    fi
}

mkdirs() { mkdir -p "$CACHE" "$BUILD_ROOT" "$API_CACHE" "$STATE_DIR" "$REVIEW_DIR"; }

# ----------------------------------------------------------------------------
# Installed-package map
# ----------------------------------------------------------------------------
declare -A INSTALLED=()
INSTALLED_LOADED=0
load_installed() {
    (( INSTALLED_LOADED )) && return 0
    local n v
    while read -r n v; do INSTALLED[$n]=$v; done < <(pacman -Q 2>/dev/null)
    INSTALLED_LOADED=1
}

# ----------------------------------------------------------------------------
# AUR RPC layer (cached)
# ----------------------------------------------------------------------------
rpc_url() { # type key=value ...
    local type="$1" url kv; shift
    url="${AUR_RPC}?v=5&type=${type}"
    for kv in "$@"; do url+="&${kv%%=*}=$(urlencode "${kv#*=}")"; done
    printf '%s' "$url"
}

fetch() { # url -> JSON on stdout (cached)
    local url="$1" cache_file age body rc
    mkdir -p "$API_CACHE"
    cache_file="$API_CACHE/$(printf '%s' "$url" | md5sum | cut -d' ' -f1).json"
    if [[ -s $cache_file ]]; then
        age=$(( $(date +%s) - $(stat -c %Y "$cache_file") ))
        if (( age < CFG_API_TTL )); then cat "$cache_file"; return 0; fi
    fi
    if have curl; then
        body=$(curl -fsSgL --max-time 20 --retry 2 -A "$SCRIPT_REAL_NAME/$VERSION" "$url" 2>/dev/null); rc=$?
    elif have wget; then
        body=$(wget -qO- -T 20 -U "$SCRIPT_REAL_NAME/$VERSION" "$url" 2>/dev/null); rc=$?
    else
        err "$(t no_fetcher)"; return 1
    fi
    if (( rc != 0 )) || [[ -z $body ]] || ! jq -e . <<<"$body" &>/dev/null; then
        err "$(t cannot_connect)"; return 1
    fi
    if [[ $(jq -r '.type // empty' <<<"$body") == error ]]; then
        err "$(t api_error "$(jq -r '.error // "unknown"' <<<"$body")")"; return 1
    fi
    printf '%s' "$body" > "$cache_file.tmp" && mv -f "$cache_file.tmp" "$cache_file"
    printf '%s' "$body"
}

aur_search() { # by term -> results array
    local body
    body=$(fetch "$(rpc_url search "by=$1" "arg=$2")") || return 1
    jq -c '.results' <<<"$body"
}

aur_info() { # names... -> merged results array (batches of 50)
    local -a names=("$@"); local -a args; local i n body
    for (( i=0; i<${#names[@]}; i+=50 )); do
        args=()
        for n in "${names[@]:i:50}"; do args+=("arg[]=$n"); done
        body=$(fetch "$(rpc_url info "${args[@]}")") || return 1
        jq -c '.results' <<<"$body"
    done | jq -sc 'add // []'
}

declare -A AUR_INFO=() AUR_BASE_OF=() AUR_MISS=()
cache_info() { # names... -> fills AUR_INFO / AUR_BASE_OF / AUR_MISS
    local -a need=(); local n json name base obj
    for n in "$@"; do
        [[ -z ${AUR_INFO[$n]:-} && -z ${AUR_MISS[$n]:-} ]] && need+=("$n")
    done
    (( ${#need[@]} )) || return 0
    json=$(aur_info "${need[@]}") || return 1
    while IFS=$'\x1f' read -r name base obj; do
        AUR_INFO[$name]=$obj; AUR_BASE_OF[$name]=$base
    done < <(jq -r '.[] | [.Name, .PackageBase, tostring] | join("\u001f")' <<<"$json")
    for n in "${need[@]}"; do [[ -z ${AUR_INFO[$n]:-} ]] && AUR_MISS[$n]=1; done
    return 0
}

# ----------------------------------------------------------------------------
# Selection parser: "1 3 5-7 ^4" -> SELECTED=(indices)
# ----------------------------------------------------------------------------
SELECTED=()
parse_selection() {
    local max="$1" tok neg lo hi i has_inc=0
    local -a toks=(); local -A inc=() exc=()
    read -ra toks <<<"${2//,/ }"
    SELECTED=()
    for tok in "${toks[@]}"; do
        neg=0
        if [[ $tok == ^* ]]; then neg=1; tok=${tok#^}; fi
        if   [[ $tok =~ ^(a|all)$ ]];            then lo=1; hi=$max
        elif [[ $tok =~ ^([0-9]+)-([0-9]+)$ ]];  then lo=${BASH_REMATCH[1]}; hi=${BASH_REMATCH[2]}
        elif [[ $tok =~ ^[0-9]+$ ]];             then lo=$tok; hi=$tok
        else err "$(t invalid_selection "$tok")"; return 1; fi
        if (( lo < 1 || hi > max || lo > hi )); then err "$(t invalid_selection "$tok")"; return 1; fi
        for (( i=lo; i<=hi; i++ )); do
            if (( neg )); then exc[$i]=1; else inc[$i]=1; has_inc=1; fi
        done
    done
    if (( ! has_inc )); then for (( i=1; i<=max; i++ )); do inc[$i]=1; done; fi
    for (( i=1; i<=max; i++ )); do
        [[ -n ${inc[$i]:-} && -z ${exc[$i]:-} ]] && SELECTED+=("$i")
    done
    (( ${#SELECTED[@]} > 0 ))
}

# ----------------------------------------------------------------------------
# Info card
# ----------------------------------------------------------------------------
declare -A CARD=()
card_field() { # label_key json_key
    [[ -n ${CARD[$2]:-} ]] && printf '%s%-18s%s %s\n' "$BOLD" "$(t "$1")" "$NC" "${CARD[$2]}"
}

installed_status() { # pkg -> colored status line
    local pkg="$1" v
    if v=$(pacman -Q "$pkg" 2>/dev/null); then
        printf '%s (%s)' "${GREEN}$(t st_installed)${NC}" "${v#* }"
    elif pacman -Si "$pkg" &>/dev/null; then
        printf '%s' "${YELLOW}$(t st_repo)${NC}"
    else
        printf '%s' "${RED}$(t st_not_installed)${NC}"
    fi
}

print_card_obj() { # json object
    local obj="$1" k v
    CARD=()
    while IFS=$'\x1f' read -r k v; do CARD[$k]=$v; done < <(
        jq -r 'to_entries[] | select(.value != null)
               | .key + "\u001f" + (if (.value|type)=="array" then (.value|join("  ")) else (.value|tostring) end)' <<<"$obj")
    [[ -z ${CARD[Maintainer]:-} ]] && CARD[Maintainer]=$(t none_orphan)
    CARD[AurPage]="$AUR_BASE/packages/${CARD[Name]}"
    [[ ${CARD[PackageBase]:-} == "${CARD[Name]:-}" ]] && unset 'CARD[PackageBase]'
    [[ -n ${CARD[FirstSubmitted]:-} ]] && CARD[FirstSubmitted]=$(fmt_date "${CARD[FirstSubmitted]}")
    [[ -n ${CARD[LastModified]:-}   ]] && CARD[LastModified]=$(fmt_date "${CARD[LastModified]}")
    [[ -n ${CARD[OutOfDate]:-}      ]] && CARD[OutOfDate]="${RED}$(fmt_date "${CARD[OutOfDate]}")${NC}"
    CARD[Installed]=$(installed_status "${CARD[Name]}")
    printf '%s%s%s\n' "$GREEN" "$(printf '%0.s─' {1..60})" "$NC"
    card_field f_name Name;           card_field f_version Version
    card_field f_desc Description;    card_field f_url URL
    card_field f_aur AurPage;         card_field f_base PackageBase
    card_field f_license License;     card_field f_keywords Keywords
    card_field f_groups Groups;       card_field f_provides Provides
    card_field f_depends Depends;     card_field f_makedeps MakeDepends
    card_field f_checkdeps CheckDepends; card_field f_optdeps OptDepends
    card_field f_conflicts Conflicts; card_field f_replaces Replaces
    card_field f_maintainer Maintainer; card_field f_comaint CoMaintainers
    card_field f_submitter Submitter
    card_field f_votes NumVotes;      card_field f_pop Popularity
    card_field f_first FirstSubmitted; card_field f_last LastModified
    card_field f_ood OutOfDate;       card_field f_installed Installed
}

print_cards() { # names...
    local json obj
    json=$(aur_info "$@") || return 1
    if [[ $(jq 'length' <<<"$json") -eq 0 ]]; then err "$(t pkg_not_found "$*")"; return 1; fi
    if (( OPT_JSON )); then jq . <<<"$json"; return 0; fi
    while IFS= read -r obj; do print_card_obj "$obj"; done < <(jq -c '.[]' <<<"$json")
}

# ----------------------------------------------------------------------------
# Security audit of build files
# ----------------------------------------------------------------------------
AUDIT_KEYS=(audit_pipe audit_b64 audit_eval audit_net audit_perm audit_sudo audit_http audit_rm audit_svc)
AUDIT_SCOPE=(any any any any any any any any install)
AUDIT_REGEX=(
    '(curl|wget)[^#]*\|[[:space:]]*(sudo[[:space:]]+)?(ba|z|da)?sh([[:space:]]|$)'
    'base64[[:space:]]+(-d|--decode)'
    '(^|[;&|[:space:]])eval[[:space:]]'
    '/dev/(tcp|udp)/|(^|[[:space:]])(nc|ncat|socat)[[:space:]]'
    'chmod[[:space:]]+(-R[[:space:]]+)?(0?777|[ugoa]*\+s|[2467][0-7]{3})([[:space:]]|$)'
    '(^|[;&|[:space:]])(sudo|su)[[:space:]]'
    'http://'
    'rm[[:space:]]+(-[a-zA-Z]+[[:space:]]+)*(/|~|\$HOME)([[:space:]]|$)'
    'systemctl[[:space:]]+(enable|start)|useradd|adduser|crontab'
)
AUDIT_HITS=0

audit_files() { # files...
    local f i line lineno content base
    AUDIT_HITS=0
    for f in "$@"; do
        [[ -f $f ]] || continue
        base=${f##*/}
        for (( i=0; i<${#AUDIT_KEYS[@]}; i++ )); do
            [[ ${AUDIT_SCOPE[i]} == install && $f != *.install ]] && continue
            while IFS= read -r line; do
                (( AUDIT_HITS == 0 )) && warn "$(t audit_header)"
                AUDIT_HITS=$(( AUDIT_HITS + 1 ))
                lineno=${line%%:*}; content=${line#*:}
                printf '   %s%s:%s%s%s %s\n      %s%s%s\n' "$YELLOW" "$base" "$lineno" "$NC" "" \
                    "$(t "${AUDIT_KEYS[i]}")" "$DIM" "$(trunc "${content#"${content%%[![:space:]]*}"}" 110)" "$NC" >&2
            done < <(grep -nE -- "${AUDIT_REGEX[i]}" "$f" 2>/dev/null)
        done
    done
    local hosts
    hosts=$(grep -ohE "https?://[^/\"' )]+" "$@" 2>/dev/null | sort -u | tr '\n' ' ')
    [[ -n $hosts ]] && printf '   %s%s%s %s\n' "$DIM" "$(t audit_hosts)" "$NC" "$hosts" >&2
    (( AUDIT_HITS == 0 )) && printf '%s%s%s\n' "$DIM" "$(t audit_clean)" "$NC" >&2
    return 0
}

audit_dir() { # dir
    local -a files=("$1/PKGBUILD")
    local f
    for f in "$1"/*.install; do [[ -f $f ]] && files+=("$f"); done
    audit_files "${files[@]}"
}

# ----------------------------------------------------------------------------
# Pager / editor / review
# ----------------------------------------------------------------------------
show_pager() {
    if [[ -t 1 ]]; then
        local -a pg; read -ra pg <<<"${PAGER:-less}"
        LESS="${LESS:--R}" "${pg[@]}"
    else
        cat
    fi
}

pick_editor() {
    local e
    if [[ -n ${EDITOR:-} ]]; then printf '%s' "$EDITOR"; return 0; fi
    for e in nvim vim nano vi; do have "$e" && { printf '%s' "$e"; return 0; }; done
    return 1
}

edit_file() {
    local editor; local -a ed
    if ! editor=$(pick_editor); then
        err "$(t no_editor_found)"; echo "$(t set_editor)"; echo "$(t export_editor)"; return 1
    fi
    read -ra ed <<<"$editor"
    "${ed[@]}" "$1"
}

view_files() { # dir reviewed_commit
    local dir="$1" reviewed="$2" head f
    head=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
    {
        if [[ -n $reviewed && $reviewed != "$head" ]] && git -C "$dir" cat-file -e "${reviewed}^{commit}" 2>/dev/null; then
            printf '%s%s%s\n\n' "$BOLD" "$(t diff_since "${reviewed:0:8}")" "$NC"
            git -C "$dir" -c color.ui=always diff "$reviewed" -- . ':(exclude).SRCINFO'
        else
            for f in "$dir"/PKGBUILD "$dir"/*.install; do
                [[ -f $f ]] || continue
                printf '%s── %s ──%s\n' "$BOLD" "${f##*/}" "$NC"
                cat "$f"; printf '\n'
            done
            printf '%s%s%s\n' "$BOLD" "$(t extra_files)" "$NC"
            git -C "$dir" ls-files | grep -v '^\.SRCINFO$'
        fi
    } | show_pager
}

mark_reviewed() { # base
    local head
    head=$(git -C "$BUILD_ROOT/$1" rev-parse HEAD 2>/dev/null) || return 0
    mkdir -p "$REVIEW_DIR"; printf '%s\n' "$head" > "$REVIEW_DIR/$1"
}

review_pkgbuild() { # base -> 0 continue, 1 abort
    local base="$1" dir="$BUILD_ROOT/$1" head reviewed="" key
    head=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || head=""
    [[ -r $REVIEW_DIR/$base ]] && reviewed=$(<"$REVIEW_DIR/$base")
    audit_dir "$dir"
    (( CFG_REVIEW )) || return 0
    if [[ -n $head && $reviewed == "$head" ]] && git -C "$dir" diff --quiet 2>/dev/null; then
        ok "$(t review_unchanged)"; return 0
    fi
    if (( CFG_NOCONFIRM )) || ! is_interactive; then
        warn "$(t review_skipped)"; return 0
    fi
    view_files "$dir" "$reviewed"
    while true; do
        printf '%s' "$(t review_menu "$base")"
        IFS= read -rsn1 key; printf '\n'
        case $key in
            v|V) view_files "$dir" "$reviewed" ;;
            e|E) edit_file "$dir/PKGBUILD"; audit_dir "$dir" ;;
            c|C|'') mark_reviewed "$base"; return 0 ;;
            a|A|q|Q|n|N) return 1 ;;
        esac
    done
}

# ----------------------------------------------------------------------------
# Git repository handling
# ----------------------------------------------------------------------------
clone_repo() { # base dest
    local base="$1" dest="$2"
    if [[ $CFG_CLONE_PROTO == ssh ]]; then
        GIT_TERMINAL_PROMPT=0 git clone -q "ssh://aur@aur.archlinux.org/$base.git" "$dest" 2>/dev/null && return 0
    fi
    GIT_TERMINAL_PROMPT=0 git clone -q "$AUR_BASE/$base.git" "$dest"
}

prepare_repo() { # base
    local base="$1" dir="$BUILD_ROOT/$1" up
    mkdir -p "$BUILD_ROOT"
    if (( OPT_FRESH )) && [[ -d $dir ]]; then rm -rf "${BUILD_ROOT:?}/${base:?}"; fi
    if [[ ! -d $dir/.git ]]; then
        [[ -d $dir ]] && rm -rf "${BUILD_ROOT:?}/${base:?}"
        info "$(t cloning "$base")"
        if ! clone_repo "$base" "$dir"; then
            err "$(t clone_failed "$base")"; err "$(t check_name)"; return 1
        fi
    else
        info "$(t updating_repo)"
        git -C "$dir" fetch -q origin 2>/dev/null || { warn "$(t fetch_failed)"; return 0; }
        up=$(git -C "$dir" rev-parse '@{u}' 2>/dev/null) || return 0
        if [[ $(git -C "$dir" rev-parse HEAD) != "$up" ]]; then
            if ! git -C "$dir" diff --quiet 2>/dev/null; then
                confirm "$(t discard_local "$base")" n || { warn "$(t fetch_failed)"; return 0; }
            fi
            git -C "$dir" reset --hard -q "$up"
        fi
    fi
    [[ -f $dir/PKGBUILD ]] || { err "$(t no_pkgbuild)"; return 1; }
}

# ----------------------------------------------------------------------------
# Dependency resolution
# ----------------------------------------------------------------------------
declare -A DEP_STATE=()
STATE=""
dep_state() { # dep -> sets STATE=installed|repo|aur
    local dep="$1" name="${1%%[<>=]*}"
    if [[ -n ${DEP_STATE[$dep]:-} ]]; then STATE=${DEP_STATE[$dep]}; return 0; fi
    if   pacman -T -- "$dep" &>/dev/null; then STATE=installed
    elif pacman -Sddp --noconfirm -- "$name" </dev/null &>/dev/null; then STATE=repo
    else STATE=aur; fi
    DEP_STATE[$dep]=$STATE
}

declare -A VISITED=() IS_TARGET=() BASE_WANT=()
declare -a BUILD_ORDER=() BASE_ORDER=() MISSING_DEPS=()

resolve_one() { # pkgname (post-order DFS)
    local pkg="$1" e dep name
    [[ -n ${VISITED[$pkg]:-} ]] && return 0
    VISITED[$pkg]=1
    [[ -n ${AUR_INFO[$pkg]:-} ]] || return 1
    local -a deps=() need=()
    mapfile -t deps < <(jq -r '((.Depends // []) + (.MakeDepends // []) + (.CheckDepends // []))[]' <<<"${AUR_INFO[$pkg]}")
    for dep in "${deps[@]}"; do
        dep_state "$dep"
        [[ $STATE == aur ]] && need+=("${dep%%[<>=]*}")
    done
    (( ${#need[@]} )) && cache_info "${need[@]}"
    for dep in "${deps[@]}"; do
        name=${dep%%[<>=]*}
        dep_state "$dep"
        [[ $STATE == aur ]] || continue
        if [[ -n ${AUR_INFO[$name]:-} ]]; then
            resolve_one "$name"
        else
            MISSING_DEPS+=("$(t unresolved "$dep" "$pkg")")
        fi
    done
    BUILD_ORDER+=("$pkg")
}

trust_report() { # pkg
    local p="$1" ver votes pop maint ood first last age_days
    IFS=$'\x1f' read -r ver votes pop maint ood first last < <(
        jq -r '[.Version,.NumVotes,.Popularity,(.Maintainer//""),(.OutOfDate//""),.FirstSubmitted,.LastModified]
               | map(tostring) | join("\u001f")' <<<"${AUR_INFO[$p]}")
    age_days=$(( ( $(date +%s) - ${first:-0} ) / 86400 ))
    if [[ -n ${IS_TARGET[$p]:-} ]]; then
        printf '  %s%s%s\n' "$DIM" "$(t trust_line "$p" "$votes" "$(printf '%.2f' "${pop:-0}")" "${maint:-—}" "$(fmt_date "${last:-0}")")" "$NC"
    fi
    [[ -z $maint ]] && warn "$(t warn_orphan "$p")"
    [[ -n $ood   ]] && warn "$(t warn_ood "$p")"
    (( age_days < 30 )) && warn "$(t warn_new "$p" "$age_days")"
    (( ${votes:-0} < 3 )) && warn "$(t warn_votes "$p" "$votes")"
    return 0
}

show_plan() {
    local p ver tag
    printf '\n%s%s%s\n' "$BOLD" "$(t plan_header "${#BUILD_ORDER[@]}")" "$NC"
    for p in "${BUILD_ORDER[@]}"; do
        ver=$(jq -r '.Version' <<<"${AUR_INFO[$p]}")
        if [[ -n ${IS_TARGET[$p]:-} ]]; then tag="${GREEN}$(t tag_target)${NC}"; else tag="${CYAN}$(t tag_dep)${NC}"; fi
        printf '  %-32s %-18s (%s)\n' "$p" "$ver" "$tag"
    done
    printf '\n'
    for p in "${BUILD_ORDER[@]}"; do trust_report "$p"; done
    printf '\n'
}

choose_build_mode() {
    (( OPT_BUILD_ONLY || OPT_FORCE || UPGRADE_MODE || CFG_NOCONFIRM )) && return 0
    is_interactive || return 0
    local choice
    info "$(t build_options)"
    t mode_1; printf '\n'; t mode_2; printf '\n'; t mode_3; printf '\n'
    read -rp "$(t choose_option) " choice
    case ${choice:-2} in
        1) OPT_BUILD_ONLY=1 ;;
        2) ;;
        3) OPT_FORCE=1 ;;
        *) warn "$(t invalid_option)"; return 1 ;;
    esac
}

# ----------------------------------------------------------------------------
# Build + install of one package base
# ----------------------------------------------------------------------------
offer_pgp_import() { # dir -> 0 if keys were imported
    local dir="$1" key imported=1
    local -a missing=()
    [[ -r $dir/.SRCINFO ]] && have gpg || return 1
    while read -r key; do
        [[ -n $key ]] && ! gpg --list-keys "$key" &>/dev/null && missing+=("$key")
    done < <(awk -F' = ' '/^[[:space:]]*validpgpkeys/ {print $2}' "$dir/.SRCINFO" | sort -u)
    (( ${#missing[@]} )) || return 1
    warn "$(t pgp_missing)"; printf '   %s\n' "${missing[@]}"
    confirm "$(t pgp_import_q)" y || return 1
    for key in "${missing[@]}"; do
        gpg --recv-keys "$key" || gpg --keyserver hkps://keyserver.ubuntu.com --recv-keys "$key" && imported=0
    done
    return $imported
}

run_makepkg() { # dir args...
    local dir="$1" rc; shift
    ( cd "$dir" && makepkg "$@" ); rc=$?
    (( rc == 0 )) && return 0
    if offer_pgp_import "$dir"; then
        info "$(t pgp_retry)"
        ( cd "$dir" && makepkg "$@" ); return $?
    fi
    return $rc
}

pkgname_of_file() { local fn="${1##*/}"; fn=${fn%.pkg.tar*}; printf '%s' "${fn%-*-*-*}"; }

build_and_install() { # base
    local base="$1" dir="$BUILD_ROOT/$1" n f name
    local -a want=() files=() sel=() exp=() dep=() keep=() mflags=() pflags=()
    read -ra want <<<"${BASE_WANT[$base]}"
    local has_target=0 do_install=1 rebuild=1 all_exist=1
    for n in "${want[@]}"; do [[ -n ${IS_TARGET[$n]:-} ]] && has_target=1; done
    (( has_target && OPT_BUILD_ONLY )) && do_install=0

    mapfile -t files < <(cd "$dir" && makepkg --packagelist 2>/dev/null)
    for f in "${files[@]}"; do
        name=$(pkgname_of_file "$f")
        for n in "${want[@]}"; do [[ $n == "$name" ]] && sel+=("$f"); done
    done
    if (( ${#sel[@]} == 0 )); then err "$(t no_files "$base")"; return 1; fi

    for f in "${sel[@]}"; do [[ -f $f ]] || all_exist=0; done
    if (( all_exist && ! OPT_FORCE )); then
        confirm "$(t reuse_built)" y && rebuild=0
    fi

    if (( rebuild )); then
        info "$(t building "$base")"
        mflags=(-s -f)
        (( CFG_NOCONFIRM )) && mflags+=(--noconfirm)
        (( OPT_RMDEPS )) && mflags+=(-r)
        # shellcheck disable=SC2206
        [[ -n $CFG_MAKEPKG_FLAGS ]] && mflags+=($CFG_MAKEPKG_FLAGS)
        if ! run_makepkg "$dir" "${mflags[@]}"; then
            err "$(t build_failed "$base")"
            printf '%s\n' "$(t package_location "$dir")"
            return 1
        fi
    fi

    if (( do_install )); then
        (( CFG_NOCONFIRM )) && pflags+=(--noconfirm)
        load_installed
        for f in "${sel[@]}"; do
            name=$(pkgname_of_file "$f")
            if   [[ -n ${IS_TARGET[$name]:-} ]]; then exp+=("$f")
            elif [[ -n ${INSTALLED[$name]:-} ]]; then keep+=("$f")
            else dep+=("$f"); fi
        done
        info "$(t installing "${want[*]}")"
        if (( ${#exp[@]} )); then
            "${SUDO[@]}" pacman -U "${pflags[@]}" --asexplicit "${exp[@]}" || return 1
        fi
        if (( ${#keep[@]} )); then
            "${SUDO[@]}" pacman -U "${pflags[@]}" "${keep[@]}" || return 1
        fi
        if (( ${#dep[@]} )); then
            "${SUDO[@]}" pacman -U "${pflags[@]}" --asdeps "${dep[@]}" || return 1
        fi
        for n in "${want[@]}"; do
            log_event install "$n" "$(jq -r '.Version' <<<"${AUR_INFO[$n]}")"
        done
        INSTALLED_LOADED=0; INSTALLED=()
    else
        ok "$(t process_done)"
        printf '%s\n' "$(t package_location "$dir")"
    fi
    return 0
}

process_base() { # base
    local base="$1"
    printf '\n'; info "$(t processing "$base")"
    prepare_repo "$base" || return 1
    review_pkgbuild "$base" || return 1
    build_and_install "$base"
}

# ----------------------------------------------------------------------------
# Install flow: targets -> resolve -> plan -> build in dependency order
# ----------------------------------------------------------------------------
install_flow() { # names...
    ensure_build_tools || return 1
    mkdirs
    VISITED=(); IS_TARGET=(); BASE_WANT=(); BUILD_ORDER=(); BASE_ORDER=(); MISSING_DEPS=()
    local n p base failed=0
    local -a want=() repo_targets=()

    cache_info "$@" || return 1
    for n in "$@"; do
        if [[ -n ${AUR_INFO[$n]:-} ]]; then
            want+=("$n"); IS_TARGET[$n]=1
        elif pacman -Si -- "$n" &>/dev/null; then
            repo_targets+=("$n")
        else
            err "$(t pkg_not_found "$n")"; failed=1
        fi
    done
    if (( ${#repo_targets[@]} )); then
        info "$(t in_repos "${repo_targets[*]}")"
        "${SUDO[@]}" pacman -S --needed "${repo_targets[@]}" || return 1
    fi
    (( ${#want[@]} )) || return $failed

    info "$(t resolving)"
    for n in "${want[@]}"; do resolve_one "$n"; done
    if (( ${#MISSING_DEPS[@]} )); then
        for p in "${MISSING_DEPS[@]}"; do err "$p"; done
        err "$(t unresolved_hint)"
        return 1
    fi

    for p in "${BUILD_ORDER[@]}"; do
        base=${AUR_BASE_OF[$p]}
        [[ -z ${BASE_WANT[$base]:-} ]] && BASE_ORDER+=("$base")
        BASE_WANT[$base]+="$p "
    done

    show_plan
    confirm "$(t proceed_q)" y || { warn "$(t aborted)"; return 1; }
    choose_build_mode || return 1

    local idx=0
    for base in "${BASE_ORDER[@]}"; do
        idx=$(( idx + 1 ))
        if ! process_base "$base"; then
            if (( idx < ${#BASE_ORDER[@]} )); then
                warn "$(t skipped_after "${BASE_ORDER[*]:idx}")"
            fi
            return 1
        fi
    done
    printf '\n'; ok "$(t process_done)"
    return $failed
}

# ----------------------------------------------------------------------------
# Commands
# ----------------------------------------------------------------------------
filter_results() { # stdin array -> filtered + sorted array
    local sortexpr
    case $CFG_SORT in
        popularity) sortexpr='sort_by(-.Popularity)' ;;
        votes)      sortexpr='sort_by(-.NumVotes)' ;;
        name)       sortexpr='sort_by(.Name)' ;;
        updated)    sortexpr='sort_by(-.LastModified)' ;;
        *)          sortexpr='.' ;;
    esac
    jq -c --argjson minv "$OPT_MIN_VOTES" --argjson noood "$OPT_NO_OOD" "
        map(select(.NumVotes >= \$minv))
        | (if \$noood == 1 then map(select(.OutOfDate == null)) else . end)
        | $sortexpr"
}

RESULTS_JSON='[]'
declare -a RESULT_NAMES=()

print_results() {
    load_installed
    local i=0 name ver votes pop ood maint desc flags entry width
    local -a out=()
    width=$(term_width)
    while IFS=$'\x1f' read -r name ver votes pop ood maint desc; do
        i=$(( i + 1 )); flags=""
        [[ -n ${INSTALLED[$name]:-} ]] && flags+=" ${GREEN}[$(t installed_tag "${INSTALLED[$name]}")]${NC}"
        [[ -n $ood ]]   && flags+=" ${RED}[$(t ood_tag)]${NC}"
        [[ -z $maint ]] && flags+=" ${YELLOW}[$(t orphan_tag)]${NC}"
        printf -v entry '%s%3d%s %saur/%s%s %s%s%s (+%s %.2f)%s\n      %s' \
            "$YELLOW" "$i" "$NC" "$BOLD" "$name" "$NC" "$GREEN" "$ver" "$NC" "$votes" "$pop" "$flags" \
            "$(trunc "$desc" $(( width - 8 )))"
        out+=("$entry")
    done < <(jq -r '.[] | [.Name,.Version,.NumVotes,.Popularity,(.OutOfDate//""),(.Maintainer//""),(.Description//"")]
                    | map(tostring) | join("\u001f")' <<<"$RESULTS_JSON")
    if (( CFG_REVERSE )); then
        for (( i=${#out[@]}-1; i>=0; i-- )); do printf '%s\n' "${out[i]}"; done
    else
        printf '%s\n' "${out[@]}"
    fi
}

save_results() {
    local file="${OPT_OUTPUT:-aur_results_$(date +%Y%m%d_%H%M%S).txt}"
    case $file in
        *.json) jq . <<<"$RESULTS_JSON" > "$file" ;;
        *.csv)  jq -r '(["name","version","votes","popularity","maintainer","description"] | @csv),
                       (.[] | [.Name,.Version,.NumVotes,.Popularity,(.Maintainer//""),(.Description//"")] | @csv)' \
                    <<<"$RESULTS_JSON" > "$file" ;;
        *)      jq -r '.[] | "Name: \(.Name)\tVersion: \(.Version)\tDescription: \(.Description // "")"' \
                    <<<"$RESULTS_JSON" > "$file" ;;
    esac
    ok "$(t results_saved) $file"
}

names_from_selection() { # prints names for SELECTED
    local idx; for idx in "${SELECTED[@]}"; do printf '%s\n' "${RESULT_NAMES[idx-1]}"; done
}

search_prompt() {
    local line rest
    local -a names
    while true; do
        printf '%s\n' "$(t prompt_select)"
        read -rp "==> " line || return 0
        case $line in
            ''|q|Q) return 0 ;;
            s|S)    save_results; continue ;;
            d*|D*)  rest=${line:1}
                    parse_selection "${#RESULT_NAMES[@]}" "$rest" || continue
                    mapfile -t names < <(names_from_selection)
                    print_cards "${names[@]}"; continue ;;
            p*|P*)  rest=${line:1}
                    parse_selection "${#RESULT_NAMES[@]}" "$rest" || continue
                    mapfile -t names < <(names_from_selection)
                    ARGS=("${names[@]}"); cmd_pkgbuild; continue ;;
        esac
        parse_selection "${#RESULT_NAMES[@]}" "$line" || continue
        mapfile -t names < <(names_from_selection)
        install_flow "${names[@]}"
        return
    done
}

cmd_search() {
    local limit="${OPT_LIMIT:-}" term raw total shown details_n
    local -a words=("${ARGS[@]}")
    if (( ${#words[@]} > 1 )); then
        local last="${words[-1]}"
        if [[ -z $limit ]] && [[ $last =~ ^[0-9]+$ || $last == full ]]; then
            limit=$last; unset 'words[-1]'
        fi
    fi
    term="${words[*]}"
    if [[ -z $term ]] && (( ! OPT_ORPHANS )); then err "$(t err_no_term)"; show_usage_hint; return 1; fi
    (( OPT_ORPHANS )) && OPT_BY=maintainer
    if [[ -z $limit ]]; then
        if (( OPT_DETAILS )); then limit=$CFG_DETAIL_LIMIT; else limit=$CFG_SEARCH_LIMIT; fi
    fi
    [[ $limit == full || $limit =~ ^[0-9]+$ ]] || { err "$(t bad_value --limit "$limit")"; return 1; }

    (( OPT_JSON )) || { printf '%s%s%s %s%s%s\n' "$BLUE" "$(t searching_for)" "$NC" "$GREEN" "$term" "$NC"; }
    raw=$(aur_search "$OPT_BY" "$term") || return 1
    total=$(jq 'length' <<<"$raw")
    if (( total == 0 )); then warn "$(t no_packages) $term"; return 0; fi

    RESULTS_JSON=$(filter_results <<<"$raw")
    if [[ $limit != full ]]; then RESULTS_JSON=$(jq -c ".[:$limit]" <<<"$RESULTS_JSON"); fi
    mapfile -t RESULT_NAMES < <(jq -r '.[].Name' <<<"$RESULTS_JSON")
    shown=${#RESULT_NAMES[@]}

    if (( OPT_JSON )); then jq . <<<"$RESULTS_JSON"; return 0; fi
    printf '%s%s%s\n%s%s%s\n\n' "$GREEN" "$(t found_packages "$total")" "$NC" \
        "$BLUE" "$(t showing_results "$shown" "$CFG_SORT")" "$NC"
    print_results
    [[ -n $OPT_OUTPUT ]] && save_results

    if (( OPT_DETAILS )); then
        if [[ $limit == full ]]; then details_n=$shown; else details_n=$limit; fi
        (( details_n > shown )) && details_n=$shown
        print_cards "${RESULT_NAMES[@]:0:details_n}"
    fi
    if is_interactive && (( ! CFG_NOCONFIRM )) && [[ -z $OPT_OUTPUT ]]; then
        printf '\n'; search_prompt
    fi
}

cmd_fzf() {
    local term="${ARGS[*]}" raw json sel q
    if ! have fzf; then warn "$(t no_fzf)"; cmd_search; return; fi
    if [[ -z $term ]]; then read -rp "$(t searching_for) " term; fi
    [[ -n $term ]] || { err "$(t err_no_term)"; return 1; }
    raw=$(aur_search "$OPT_BY" "$term") || return 1
    json=$(filter_results <<<"$raw")
    [[ $(jq 'length' <<<"$json") -gt 0 ]] || { warn "$(t no_packages) $term"; return 0; }
    q=$(printf '%q' "$SELF")
    local -a fargs=(--multi --ansi --reverse --height=90% --header="$(t fzf_header)"
        --preview "AUR_COLOR=always $q --card {1}" --preview-window=right:55%:wrap
        --bind "alt-p:change-preview(AUR_COLOR=always $q --pkgbuild {1})"
        --bind "alt-i:change-preview(AUR_COLOR=always $q --card {1})")
    sel=$(jq -r '.[] | [.Name, .Version, ("+" + (.NumVotes|tostring)), ((.Popularity*100|round/100)|tostring),
                        ((.Description // "") | gsub("[\t\n]";" "))] | join("\t")' <<<"$json" \
          | { have column && column -t -s $'\t' || cat; } | fzf "${fargs[@]}" | awk '{print $1}')
    [[ -n $sel ]] || return 0
    local -a names; mapfile -t names <<<"$sel"
    install_flow "${names[@]}"
}

cmd_aurinfo() { need_args 1 || return 1; print_cards "${ARGS[@]}"; }
cmd_pacinfo() { need_args 1 || return 1; pacman -Qi "${ARGS[@]}"; }

cmd_pkgbuild() {
    need_args 1 || return 1
    local p base tmp url
    cache_info "${ARGS[@]}"
    for p in "${ARGS[@]}"; do
        if [[ -z ${AUR_INFO[$p]:-} ]]; then err "$(t pkg_not_found "$p")"; continue; fi
        base=${AUR_BASE_OF[$p]}
        url="$AUR_BASE/cgit/aur.git/plain/PKGBUILD?h=$(urlencode "$base")"
        tmp=$(mktemp -d)
        if have curl; then curl -fsSL "$url" -o "$tmp/PKGBUILD"; else wget -qO "$tmp/PKGBUILD" "$url"; fi
        if [[ -s $tmp/PKGBUILD ]]; then
            audit_files "$tmp/PKGBUILD"
            cat "$tmp/PKGBUILD" | show_pager
        else
            err "$(t pkg_not_found "$p")"
        fi
        rm -rf "$tmp"
    done
}

cmd_get() {
    need_args 1 || return 1
    local p base
    cache_info "${ARGS[@]}"
    for p in "${ARGS[@]}"; do
        if [[ -z ${AUR_INFO[$p]:-} ]]; then err "$(t pkg_not_found "$p")"; continue; fi
        base=${AUR_BASE_OF[$p]}
        if clone_repo "$base" "$PWD/$base"; then ok "$(t got_repo "$base" "$PWD/$base")"; else err "$(t clone_failed "$base")"; fi
    done
}

print_tree() { # pkg prefix depth
    local pkg="$1" prefix="$2" depth="$3" e dep kind name tag branch next i=0 total
    (( depth > OPT_DEPTH )) && return 0
    local -a entries=() need=()
    mapfile -t entries < <(jq -r '((.Depends//[])[] | . + "\u001fdep"),
                                  ((.MakeDepends//[])[] | . + "\u001fmake"),
                                  ((.CheckDepends//[])[] | . + "\u001fcheck")' <<<"${AUR_INFO[$pkg]}")
    for e in "${entries[@]}"; do
        dep=${e%%$'\x1f'*}; dep_state "$dep"
        [[ $STATE == aur ]] && need+=("${dep%%[<>=]*}")
    done
    (( ${#need[@]} )) && cache_info "${need[@]}"
    total=${#entries[@]}
    for e in "${entries[@]}"; do
        i=$(( i + 1 ))
        dep=${e%%$'\x1f'*}; kind=${e#*$'\x1f'}; name=${dep%%[<>=]*}
        if (( i == total )); then branch='└── '; next='    '; else branch='├── '; next='│   '; fi
        dep_state "$dep"
        case $STATE in
            installed) tag="${GREEN}installed${NC}" ;;
            repo)      tag="${CYAN}repo${NC}" ;;
            *)         if [[ -n ${AUR_INFO[$name]:-} ]]; then tag="${YELLOW}AUR${NC}"; else tag="${RED}missing${NC}"; fi ;;
        esac
        local seen=""
        if [[ $STATE == aur && -n ${AUR_INFO[$name]:-} ]]; then
            if [[ -n ${TREE_SEEN[$name]:-} ]]; then seen=" (*)"; fi
        fi
        printf '%s%s%s %s[%s]%s %s%s\n' "$prefix" "$branch" "$dep" "$DIM" "$kind" "$NC" "$tag" "$seen"
        if [[ $STATE == aur && -n ${AUR_INFO[$name]:-} && -z $seen ]]; then
            TREE_SEEN[$name]=1
            print_tree "$name" "$prefix$next" $(( depth + 1 ))
        fi
    done
}

declare -A TREE_SEEN=()
cmd_tree() {
    need_args 1 || return 1
    local p
    cache_info "${ARGS[@]}"
    for p in "${ARGS[@]}"; do
        if [[ -z ${AUR_INFO[$p]:-} ]]; then err "$(t pkg_not_found "$p")"; continue; fi
        TREE_SEEN=([$p]=1)
        printf '%s%s%s %s\n' "$BOLD" "$p" "$NC" "$(jq -r '.Version' <<<"${AUR_INFO[$p]}")"
        print_tree "$p" "" 1
    done
    printf '%s%s%s\n' "$DIM" "$(t tree_legend)" "$NC"
}

declare -A IGNORED=()
build_ignore() {
    local p
    for p in $CFG_IGNORE ${OPT_IGNORE//,/ }; do IGNORED[$p]=1; done
    if have pacman-conf; then
        while read -r p; do [[ -n $p ]] && IGNORED[$p]=1; done < <(pacman-conf IgnorePkg 2>/dev/null | tr ' ' '\n')
    fi
}

cmd_upgrade() {
    build_ignore
    local -A fver=(); local n v name new i
    while read -r n v; do fver[$n]=$v; done < <(pacman -Qm 2>/dev/null)
    if (( ${#fver[@]} == 0 )); then ok "$(t no_foreign)"; return 0; fi
    info "$(t checking_upgrades)"
    local -a names; mapfile -t names < <(printf '%s\n' "${!fver[@]}" | sort)
    local json; json=$(aur_info "${names[@]}") || return 1

    local -a up_name=() up_old=() up_new=() up_note=() ignored=()
    local -A seen=()
    local newer note
    while IFS=$'\x1f' read -r name new; do
        seen[$name]=1; newer=0; note=""
        if (( $(vercmp "${fver[$name]}" "$new") < 0 )); then newer=1
        elif (( CFG_DEVEL )) && [[ $name =~ -(git|svn|hg|bzr|darcs)$ ]]; then newer=1; note="$(t tag_devel)"; fi
        (( newer )) || continue
        if [[ -n ${IGNORED[$name]:-} ]]; then ignored+=("$name"); continue; fi
        up_name+=("$name"); up_old+=("${fver[$name]}"); up_new+=("$new"); up_note+=("$note")
    done < <(jq -r '.[] | [.Name,.Version] | join("\u001f")' <<<"$json")

    local missing=0
    for n in "${names[@]}"; do [[ -z ${seen[$n]:-} ]] && missing=$(( missing + 1 )); done
    (( ${#ignored[@]} )) && warn "$(t ignored_note "${ignored[*]}")"
    (( missing )) && warn "$(t missing_in_aur "$missing")"
    if (( ${#up_name[@]} == 0 )); then ok "$(t all_updated)"; return 0; fi

    printf '\n%s%s%s\n' "$BOLD" "$(t upgrades_header "${#up_name[@]}")" "$NC"
    for (( i=0; i<${#up_name[@]}; i++ )); do
        printf '%s%3d%s %s%-32s%s %s%s%s → %s%s%s %s%s%s\n' "$YELLOW" $(( i + 1 )) "$NC" "$BOLD" "${up_name[i]}" "$NC" \
            "$RED" "${up_old[i]}" "$NC" "$GREEN" "${up_new[i]}" "$NC" "$CYAN" "${up_note[i]}" "$NC"
    done
    printf '\n'
    local line="" sel_names=()
    if is_interactive && (( ! CFG_NOCONFIRM )); then
        printf '%s\n' "$(t upgrade_select)"
        read -rp "==> " line || return 0
        [[ $line == n || $line == N ]] && return 0
    fi
    parse_selection "${#up_name[@]}" "$line" || return 1
    for i in "${SELECTED[@]}"; do sel_names+=("${up_name[i-1]}"); done
    UPGRADE_MODE=1
    install_flow "${sel_names[@]}"
}

cmd_sysupgrade() {
    info "$(t sysupgrade_start)"
    local -a pflags=(); (( CFG_NOCONFIRM )) && pflags+=(--noconfirm)
    "${SUDO[@]}" pacman -Syu "${pflags[@]}" || return 1
    log_event sysupgrade "-" ""
    cmd_upgrade
}

cmd_foreign() { # mode: all|outdated|missing
    local mode="$1" n v name
    local -A fver=(); local -A seen=()
    while read -r n v; do fver[$n]=$v; done < <(pacman -Qm 2>/dev/null)
    if (( ${#fver[@]} == 0 )); then ok "$(t no_foreign)"; return 0; fi
    local -a names; mapfile -t names < <(printf '%s\n' "${!fver[@]}" | sort)
    local json; json=$(aur_info "${names[@]}") || return 1

    case $mode in
        all)
            printf '%s%s%s\n' "$BOLD" "$(t foreign_header "${#names[@]}")" "$NC"
            for n in "${names[@]}"; do printf '  %s%-34s%s %s\n' "$BOLD" "$n" "$NC" "${fver[$n]}"; done ;;
        outdated)
            local -a ood; mapfile -t ood < <(jq -r '.[] | select(.OutOfDate != null) | .Name' <<<"$json")
            if (( ${#ood[@]} == 0 )); then ok "$(t nothing_outdated)"; return 0; fi
            printf '%s%s%s\n' "$BOLD" "$(t outdated_header)" "$NC"
            for n in "${ood[@]}"; do printf '  %s%-34s%s %s\n' "$RED" "$n" "$NC" "${fver[$n]}"; done ;;
        missing)
            while read -r name; do seen[$name]=1; done < <(jq -r '.[].Name' <<<"$json")
            local found=0 repo
            for n in "${names[@]}"; do
                [[ -n ${seen[$n]:-} ]] && continue
                (( found == 0 )) && printf '%s%s%s\n' "$BOLD" "$(t missing_header)" "$NC"
                found=1
                repo=$(pacman -Si "$n" 2>/dev/null | awk -F': *' '/^Repository/ {print $2; exit}')
                printf '  %s%-34s%s %s' "$RED" "$n" "$NC" "${fver[$n]}"
                [[ -n $repo ]] && printf '  %s%s%s' "$CYAN" "$(t now_in_repo "$repo")" "$NC"
                printf '\n'
            done
            (( found )) || ok "$(t nothing_missing)" ;;
    esac
}

cmd_remove() {
    need_args 1 || return 1
    "${SUDO[@]}" pacman "$1" "${ARGS[@]}" && for n in "${ARGS[@]}"; do log_event remove "$n" ""; done
}

cmd_remove_debug() {
    local -a pk
    info "$(t removing_debug)"
    mapfile -t pk < <(pacman -Qq | grep -E -- '-debug$')
    (( ${#pk[@]} )) || { ok "$(t no_debug)"; return 0; }
    "${SUDO[@]}" pacman -R "${pk[@]}"
}

cmd_remove_orphans() {
    local -a pk
    info "$(t removing_orphans)"
    mapfile -t pk < <(pacman -Qtdq 2>/dev/null)
    (( ${#pk[@]} )) || { ok "$(t no_orphans)"; return 0; }
    printf '  %s\n' "${pk[@]}"
    "${SUDO[@]}" pacman -Rns "${pk[@]}"
}

base_installed() { # base -> 0 if any package built from it is installed
    local dir="$BUILD_ROOT/$1" n
    if [[ -r $dir/.SRCINFO ]]; then
        while read -r n; do [[ -n ${INSTALLED[$n]:-} ]] && return 0; done \
            < <(awk '/^[[:space:]]*pkgname = / {print $3}' "$dir/.SRCINFO")
        return 1
    fi
    [[ -n ${INSTALLED[$1]:-} ]]
}

cmd_clean() {
    local all="$1" d base
    local -a stale=() kept=()
    [[ -d $CACHE ]] || { ok "$(t nothing_to_clean)"; return 0; }
    info "$(t cache_usage)"; du -sh "$CACHE" 2>/dev/null | awk '{print "   " $1 "  " $2}'
    if [[ $all == 1 ]]; then
        confirm "$(t clean_all_q)" n || return 0
        rm -rf "${CACHE:?}"; rm -rf "${REVIEW_DIR:?}"
        ok "$(t clean_done)"; return 0
    fi
    load_installed
    for d in "$BUILD_ROOT"/*/; do
        [[ -d $d ]] || continue
        base=$(basename "$d")
        if base_installed "$base"; then kept+=("$base"); else stale+=("$base"); fi
    done
    if (( ${#stale[@]} )); then
        info "$(t clean_stale)"; printf '   %s\n' "${stale[@]}"
        if confirm "$(t clean_stale_q)" y; then
            for base in "${stale[@]}"; do rm -rf "${BUILD_ROOT:?}/${base:?}" "${REVIEW_DIR:?}/${base:?}"; done
        fi
    fi
    if (( ${#kept[@]} )) && confirm "$(t clean_artifacts_q)" n; then
        for base in "${kept[@]}"; do git -C "$BUILD_ROOT/$base" clean -fdxq 2>/dev/null; done
    fi
    rm -rf "${API_CACHE:?}"
    ok "$(t clean_done)"
}

cmd_stats() {
    local nforeign nexplicit nbuilds nrev last
    nforeign=$(pacman -Qmq 2>/dev/null | wc -l)
    nexplicit=$(pacman -Qeq 2>/dev/null | wc -l)
    nbuilds=$(find "$BUILD_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    nrev=$(find "$REVIEW_DIR" -type f 2>/dev/null | wc -l)
    last=$(tail -n1 "$HISTORY_FILE" 2>/dev/null | tr '\t' ' ')
    printf '%s%s%s\n%s\n' "$GREEN" "$(t stats_title)" "$NC" "======================"
    printf '%-34s %s\n' "$(t s_foreign):" "$nforeign" "$(t s_explicit):" "$nexplicit" \
        "$(t s_builds):" "$nbuilds" "$(t s_reviewed):" "$nrev" \
        "$(t s_cache_size):" "$(du -sh "$CACHE" 2>/dev/null | cut -f1)" "$(t s_last):" "${last:-—}"
}

cmd_history() {
    local n="${ARGS[0]:-30}"
    [[ -s $HISTORY_FILE ]] || { info "$(t no_history)"; return 0; }
    tail -n "$n" "$HISTORY_FILE" | column -t -s $'\t' 2>/dev/null || tail -n "$n" "$HISTORY_FILE"
}

cmd_init_config() {
    local f="$CONFIG_DIR/config"
    if [[ -e $f ]]; then warn "$(t config_exists "$f")"; return 0; fi
    mkdir -p "$CONFIG_DIR"
    cat > "$f" <<'EOF'
# aur-helper configuration (sourced as bash)
CFG_API_TTL=300              # seconds an API response stays cached
CFG_SEARCH_LIMIT=20
CFG_DETAIL_LIMIT=5
CFG_SORT=popularity          # popularity | votes | name | updated | relevance
CFG_REVIEW=1                 # review PKGBUILD (with diff) before building
CFG_NOCONFIRM=0
CFG_CLONE_PROTO=https        # https | ssh (ssh falls back to https)
CFG_MAKEPKG_FLAGS=""         # extra makepkg flags, e.g. "--skippgpcheck" (not recommended)
CFG_IGNORE=""                # packages never upgraded, e.g. "foo-git bar-bin"
CFG_DEVEL=0                  # also rebuild -git/-svn/-hg/... on upgrade
CFG_REVERSE=0                # print best result last, closest to the prompt
EOF
    ok "$(t config_created "$f")"
}

cmd_completion() {
    local shell="${ARGS[0]:-bash}"
    [[ $shell == zsh ]] && printf '%s\n' 'autoload -U +X bashcompinit && bashcompinit'
    cat <<'EOF'
_aur_helper_complete() {
    local cur prev opts
    cur=${COMP_WORDS[COMP_CWORD]}
    prev=${COMP_WORDS[COMP_CWORD-1]}
    opts='-s -d -i -u -I -p -G -t -R -c -h -V -Ss -S -Si -Qi -Qm -Su -Sua -Syu -Rcs -Rns -R-d -R-o
          --search --detailed --install --upgrade --interactive --info --aur-info --pkgbuild --get --tree
          --foreign --outdated --missing --remove --remove-all --purge --remove-debug --remove-orphans
          --clean --clean-all --stats --history --init-config --completion --by --sort --limit --min-votes
          --no-outdated --orphans --reverse --votes-last --votes-first -r --json --output --no-cache --noconfirm --no-review --build-only
          --force --fresh --devel --ignore --rmdeps --depth --lang --help --version'
    case $prev in
        -R|--remove|-Rcs|-Rns|--remove-all|--purge|-Qi|--info|--query-info)
            mapfile -t COMPREPLY < <(compgen -W "$(pacman -Qq 2>/dev/null)" -- "$cur"); return ;;
        -i|-S|--install|-Si|--aur-info|--show|-p|--pkgbuild|-G|--get|-t|--tree)
            if (( ${#cur} >= 2 )); then
                mapfile -t COMPREPLY < <(compgen -W "$(curl -fsm3 "https://aur.archlinux.org/rpc/?v=5&type=suggest&arg=$cur" 2>/dev/null | tr -d '[]"' | tr ',' ' ')" -- "$cur")
            fi
            return ;;
        --by)         mapfile -t COMPREPLY < <(compgen -W "name name-desc maintainer depends makedepends optdepends checkdepends submitter keywords comaintainers" -- "$cur"); return ;;
        --sort)       mapfile -t COMPREPLY < <(compgen -W "popularity votes name updated relevance" -- "$cur"); return ;;
        --completion) mapfile -t COMPREPLY < <(compgen -W "bash zsh" -- "$cur"); return ;;
        --lang)       mapfile -t COMPREPLY < <(compgen -W "en pt" -- "$cur"); return ;;
    esac
    mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
}
EOF
    printf 'complete -F _aur_helper_complete %s\n' "$SCRIPT"
}

# ----------------------------------------------------------------------------
# Help
# ----------------------------------------------------------------------------
hsec() { printf '\n%s%s%s\n' "$BOLD" "$(L "$1" "$2")" "$NC"; }
hopt() { printf '  %s%-38s%s %s\n' "$GREEN" "$1" "$NC" "$(L "$2" "$3")"; }

show_usage_hint() { printf '%s\n' "$(L "Try: $SCRIPT --help" "Tente: $SCRIPT --help")" >&2; }

show_help() {
    local n; n=$(pacman -Qmq 2>/dev/null | wc -l)
    printf '%sAUR Helper in Shell v%s%s\n======================\n' "$GREEN" "$VERSION" "$NC"
    L "Search, audit, build, install and upgrade packages from the Arch User Repository" \
      "Pesquisa, audita, compila, instala e atualiza pacotes do Arch User Repository"; printf '\n'
    printf '%s %s%s%s\n' "$(L 'Foreign (AUR/manual) packages installed:' 'Pacotes estrangeiros (AUR/manual) instalados:')" "$YELLOW" "$n" "$NC"

    hsec "Search" "Pesquisa"
    hopt "$SCRIPT <term> [full|N]"        "Search the AUR (default: 20 results)" "Pesquisa no AUR (padrão: 20 resultados)"
    hopt "-s, -Ss, --search <term> [N]"   "Same as above" "Igual ao anterior"
    hopt "-d, --detailed <term> [N]"      "Search with full info cards (default: 5)" "Pesquisa com fichas completas (padrão: 5)"
    hopt "-I, --interactive <term>"       "fzf browser with live preview, multi-select" "Navegador fzf com preview, multisseleção"
    hopt "-Si, --aur-info <pkg...>"       "Full AUR info card" "Ficha completa do AUR"
    hopt "-p, --pkgbuild <pkg...>"        "View a PKGBUILD (with quick audit) without cloning" "Ver um PKGBUILD (com auditoria rápida) sem clonar"
    hopt "-t, --tree <pkg>"               "Recursive dependency tree (repo/AUR/installed)" "Árvore recursiva de dependências (repo/AUR/instalado)"
    hopt "--by <field>"                   "name|name-desc|maintainer|depends|makedepends|optdepends|checkdepends" "name|name-desc|maintainer|depends|makedepends|optdepends|checkdepends"
    hopt "--sort <key>"                   "popularity|votes|name|updated|relevance" "popularity|votes|name|updated|relevance"
    hopt "-n, --limit <N|full>"           "Number of results" "Número de resultados"
    hopt "--min-votes <N>  --no-outdated" "Filter by votes / hide out-of-date" "Filtra por votos / oculta desatualizados"
    hopt "--orphans"                      "List orphaned packages matching the term" "Lista pacotes órfãos"
    hopt "-r, --reverse, --votes-last"    "Print the most voted result LAST (closest to the prompt)" "Mostra o mais votado por ÚLTIMO (perto do prompt)"
    hopt "--votes-first"                  "Most voted first (default; overrides config)" "Mais votado primeiro (padrão; sobrepõe a config)"
    hopt "--json  -o, --output <file>"    "JSON output / save results (.txt .csv .json)" "Saída JSON / salvar resultados (.txt .csv .json)"

    hsec "Install & upgrade" "Instalar e atualizar"
    hopt "-i, -S, --install <pkg...>"     "Resolve AUR deps, review, build and install" "Resolve deps do AUR, revisa, compila e instala"
    hopt "-G, --get <pkg...>"             "Only clone the AUR repo into the current dir" "Apenas clona o repositório do AUR no diretório atual"
    hopt "-u, -Su, -Sua, --upgrade"       "Upgrade installed AUR packages" "Atualiza os pacotes do AUR instalados"
    hopt "-Syu"                           "pacman -Syu, then upgrade AUR packages" "pacman -Syu e depois atualiza os pacotes do AUR"
    hopt "--devel"                        "Include -git/-svn/-hg/... on upgrade" "Inclui -git/-svn/-hg/... na atualização"
    hopt "--ignore a,b"                   "Do not upgrade these packages" "Não atualiza estes pacotes"
    hopt "--build-only  --force  --fresh" "Only build / force rebuild / re-clone" "Só compilar / forçar recompilação / reclonar"
    hopt "--no-review  --noconfirm, -y"   "Skip PKGBUILD review / accept defaults" "Pula revisão do PKGBUILD / aceita padrões"
    hopt "--rmdeps"                       "Remove make deps after the build (makepkg -r)" "Remove deps de build após compilar (makepkg -r)"

    hsec "Inspect" "Inspecionar"
    hopt "-Qi, --info, --query-info <pkg>" "Installed package info (pacman -Qi)" "Info do pacote instalado (pacman -Qi)"
    hopt "-Qm, --foreign"                 "List foreign packages" "Lista pacotes estrangeiros"
    hopt "--outdated"                     "Installed AUR packages flagged out of date" "Pacotes do AUR instalados marcados como desatualizados"
    hopt "--missing"                      "Installed packages that vanished from the AUR" "Pacotes instalados que sumiram do AUR"
    hopt "--stats  --history [N]"         "Statistics / action history" "Estatísticas / histórico de ações"

    hsec "Remove & clean" "Remover e limpar"
    hopt "-R, --remove <pkg...>"          "Remove packages (pacman -R)" "Remove pacotes (pacman -R)"
    hopt "-Rcs, --remove-all <pkg...>"    "pacman -Rcs (cascade: also removes dependents!)" "pacman -Rcs (cascata: remove também os dependentes!)"
    hopt "-Rns, --purge <pkg...>"         "pacman -Rns (unused deps + config files)" "pacman -Rns (deps não usadas + arquivos de configuração)"
    hopt "-R-d, --remove-debug"           "Remove all installed -debug packages" "Remove todos os pacotes -debug instalados"
    hopt "-R-o, --remove-orphans"         "Remove orphaned packages" "Remove pacotes órfãos"
    hopt "-c, --clean  --clean-all"       "Clean stale builds / wipe the whole cache" "Limpa builds obsoletos / apaga todo o cache"

    hsec "Setup" "Configuração"
    hopt "--init-config"                  "Create $CONFIG_DIR/config" "Cria $CONFIG_DIR/config"
    hopt "--completion bash|zsh"          "Print the completion script (eval \"\$($SCRIPT --completion bash)\")" "Imprime o script de completion (eval \"\$($SCRIPT --completion bash)\")"
    hopt "--lang en|pt  --no-cache"       "Force language / ignore the API cache" "Força o idioma / ignora o cache da API"
    hopt "-h, --help   -V, --version"     "Help / version" "Ajuda / versão"

    hsec "Examples" "Exemplos"
    printf '  %s neovim 30\n  %s -d neovim full\n  %s -I browser\n  %s --by depends --sort votes python-requests\n' "$SCRIPT" "$SCRIPT" "$SCRIPT" "$SCRIPT"
    printf '  %s -i yay-bin paru-bin\n  %s -Syu\n  %s -t visual-studio-code-bin\n  %s --outdated\n' "$SCRIPT" "$SCRIPT" "$SCRIPT" "$SCRIPT"

    hsec "Files" "Arquivos"
    printf '  %s\n  %s\n  %s\n' "$(L "config : $CONFIG_DIR/config" "config : $CONFIG_DIR/config")" \
        "$(L "builds : $BUILD_ROOT/" "builds : $BUILD_ROOT/")" "$(L "history: $HISTORY_FILE" "histórico: $HISTORY_FILE")"
}

# ----------------------------------------------------------------------------
# Argument parsing
# ----------------------------------------------------------------------------
need_value() { [[ -n ${2-} ]] || { err "$(t missing_value "$1")"; exit 1; }; }
is_uint() { [[ $1 =~ ^[0-9]+$ ]]; }

parse_args() {
    while (( $# )); do
        case $1 in --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
        case $1 in
            -h|--help)                               CMD=help ;;
            -V|--version)                            CMD=version ;;
            -s|-Ss|--search)                         CMD=search ;;
            -d|--detailed)                           CMD=search; OPT_DETAILS=1 ;;
            -i|-S|--install)                         CMD=install ;;
            -u|-Su|-Sua|--upgrade)                   CMD=upgrade ;;
            -Syu)                                    CMD=sysupgrade ;;
            -I|--interactive)                        CMD=fzf ;;
            -Qi|--info|--query-info)                 CMD=pacinfo ;;
            -Si|--aur-info|--show|--card)            CMD=aurinfo ;;
            -p|--pkgbuild)                           CMD=pkgbuild ;;
            -G|--get)                                CMD=get ;;
            -t|--tree)                               CMD=tree ;;
            -Qm|--foreign)                           CMD=foreign ;;
            --outdated)                              CMD=outdated ;;
            --missing)                               CMD=missing ;;
            -R|--remove)                             CMD=remove; REMOVE_FLAG=-R ;;
            -Rcs|--remove-all|--remove-with-deps)    CMD=remove; REMOVE_FLAG=-Rcs ;;
            -Rns|--purge)                            CMD=remove; REMOVE_FLAG=-Rns ;;
            -R-d|--remove-debug)                     CMD=remove_debug ;;
            -R-o|--remove-orphans|--remove-unused)   CMD=remove_orphans ;;
            -c|--clean)                              CMD=clean ;;
            --clean-all)                             CMD=clean_all ;;
            --stats)                                 CMD=stats ;;
            --history)                               CMD=history ;;
            --init-config)                           CMD=init_config ;;
            --completion)                            CMD=completion ;;
            --by)          need_value "$@"; OPT_BY=$2; shift ;;
            --sort)        need_value "$@"; CFG_SORT=$2; shift ;;
            -n|--limit)    need_value "$@"; OPT_LIMIT=$2; shift ;;
            --min-votes)   need_value "$@"; OPT_MIN_VOTES=$2; shift ;;
            --depth)       need_value "$@"; OPT_DEPTH=$2; shift ;;
            --ignore)      need_value "$@"; OPT_IGNORE+="${OPT_IGNORE:+,}$2"; shift ;;
            -o|--output)   need_value "$@"; OPT_OUTPUT=$2; shift ;;
            --lang)        need_value "$@"; LANG_CODE=$2; shift ;;
            --no-outdated) OPT_NO_OOD=1 ;;
            --orphans)     OPT_ORPHANS=1 ;;
            -r|--reverse|--votes-last) CFG_REVERSE=1 ;;
            --votes-first) CFG_REVERSE=0 ;;
            --json)        OPT_JSON=1 ;;
            --no-cache)    CFG_API_TTL=0 ;;
            -y|--noconfirm) CFG_NOCONFIRM=1 ;;
            --no-review)   CFG_REVIEW=0 ;;
            --build-only)  OPT_BUILD_ONLY=1 ;;
            --force)       OPT_FORCE=1 ;;
            --fresh)       OPT_FRESH=1 ;;
            --devel)       CFG_DEVEL=1 ;;
            --rmdeps)      OPT_RMDEPS=1 ;;
            --)            shift; ARGS+=("$@"); break ;;
            -*)            err "$(t unknown_option "$1")"; show_usage_hint; exit 1 ;;
            *)             ARGS+=("$1") ;;
        esac
        shift
    done

    case $OPT_BY in
        name|name-desc|maintainer|depends|makedepends|optdepends|checkdepends|submitter|keywords|comaintainers) ;;
        *) err "$(t bad_value --by "$OPT_BY")"; exit 1 ;;
    esac
    case $CFG_SORT in popularity|votes|name|updated|relevance) ;; *) err "$(t bad_value --sort "$CFG_SORT")"; exit 1 ;; esac
    is_uint "$OPT_MIN_VOTES" || { err "$(t bad_value --min-votes "$OPT_MIN_VOTES")"; exit 1; }
    is_uint "$OPT_DEPTH"     || { err "$(t bad_value --depth "$OPT_DEPTH")"; exit 1; }
    [[ -z $OPT_LIMIT || $OPT_LIMIT == full ]] || is_uint "$OPT_LIMIT" || { err "$(t bad_value --limit "$OPT_LIMIT")"; exit 1; }
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
REMOVE_FLAG=-R
SUDO=(sudo)

main() {
    trap 'printf "\n"; exit 130' INT
    load_config
    setup_colors
    parse_args "$@"
    setup_colors   # re-run in case a flag changed nothing, keeps AUR_COLOR/NO_COLOR logic

    (( EUID == 0 )) && SUDO=()

    if [[ -z $CMD ]]; then
        if (( ${#ARGS[@]} == 0 )) && (( ! OPT_ORPHANS )); then show_help; exit 1; fi
        CMD=search
    fi

    case $CMD in
        help)       show_help; return 0 ;;
        version)    printf '%s %s\n' "$SCRIPT_REAL_NAME" "$VERSION"; return 0 ;;
        completion) cmd_completion; return 0 ;;
        init_config) cmd_init_config; return 0 ;;
    esac

    ensure_deps
    mkdirs

    case $CMD in
        search)         cmd_search ;;
        install)        need_args 1 || exit 1; install_flow "${ARGS[@]}" ;;
        upgrade)        ensure_build_tools && cmd_upgrade ;;
        sysupgrade)     ensure_build_tools && cmd_sysupgrade ;;
        fzf)            cmd_fzf ;;
        pacinfo)        cmd_pacinfo ;;
        aurinfo)        cmd_aurinfo ;;
        pkgbuild)       cmd_pkgbuild ;;
        get)            cmd_get ;;
        tree)           cmd_tree ;;
        foreign)        cmd_foreign all ;;
        outdated)       cmd_foreign outdated ;;
        missing)        cmd_foreign missing ;;
        remove)         cmd_remove "$REMOVE_FLAG" ;;
        remove_debug)   cmd_remove_debug ;;
        remove_orphans) cmd_remove_orphans ;;
        clean)          cmd_clean 0 ;;
        clean_all)      cmd_clean 1 ;;
        stats)          cmd_stats ;;
        history)        cmd_history ;;
    esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
