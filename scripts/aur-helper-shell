# ----------------------------------------------------------------------------
# Colors
# ----------------------------------------------------------------------------
setup_colors() {
    if { [[ -t 1 ]] || [[ ${AUR_COLOR:-} == always ]]; } && [[ -z ${NO_COLOR:-} ]]; then
        RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
        BLUE=$'\033[0;34m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'
        DIM=$'\033[2m'; NC=$'\033[0m'
    else
        RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; DIM=''; NC=''
    fi
}

# ----------------------------------------------------------------------------
# i18n: m key "english" "portuguese"  /  t key [printf args...]
# ----------------------------------------------------------------------------
declare -A MSG_EN MSG_PT
LANG_CODE=en
_lang_src="${AUR_HELPER_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}"
[[ ${_lang_src,,} == pt* ]] && LANG_CODE=pt
unset _lang_src

m() { MSG_EN[$1]=$2; MSG_PT[$1]=$3; }
t() {
    local key="$1" fmt=""; shift
    [[ $LANG_CODE == pt ]] && fmt=${MSG_PT[$key]-}
    [[ -z $fmt ]] && fmt=${MSG_EN[$key]-$key}
    # shellcheck disable=SC2059
    printf -- "$fmt" "$@"
}
L() { if [[ $LANG_CODE == pt ]]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

