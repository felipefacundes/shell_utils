#!/usr/bin/env bash
# License: GPLv3
# Credits: Felipe Facundes
#
# ==============================================================================
#  flowframes.sh — AI frame interpolation for the terminal (TUI + CLI)
# ------------------------------------------------------------------------------
#  A Flowframes-inspired workflow written in Bash:
#    probe -> (scene detection) -> extract frames -> interpolate -> encode
#
#  Engines (detected with `command -v`):
#    RIFE   rife-ncnn-vulkan | rife-cuda
#    FLAVR  flavr-cuda | flavr
#    CAIN   cain-ncnn-vulkan | cain
#
#  Modes:
#    * Interactive (default): a gum based dashboard resembling the Flowframes GUI.
#    * CLI: pass -a/--autorun with file(s) and the options below.
#
#  Engine contract (every backend is called the same way):
#    <engine> -i <input_frames_dir> -o <output_frames_dir> -n <target_frames> [-m <model>]
#  Input/output frames are 8-digit PNGs (00000001.png, ...). This is the native
#  CLI of the *-ncnn-vulkan tools; for Python/CUDA implementations provide a thin
#  wrapper that honours the same contract.
#
#  Environment:
#    FF_BIN_<ENGINE>   Override an engine binary (e.g. FF_BIN_RIFENCNN=/opt/rife/rife-ncnn-vulkan)
#    FF_MODELS_DIR     Model root (default: ~/.local/share/flowframes-cli/models)
#    FF_TMPDIR         Scratch directory for extracted frames (default: ~/.cache/flowframes-cli)
#    FF_GPU_ID         GPU id forwarded to the engine with -g
#    FF_ENGINE_ARGS    Extra arguments appended to the engine command line
#    FF_CRF            Override the default quality value of the selected encoder
#    FF_PRESET         Override the encoder preset / speed (x264, x265, SvtAv1, Aom)
#    FF_SVT_PARAMS     Extra libsvtav1 parameters, e.g. "tune=0:film-grain=0"
#    NO_COLOR          Disable ANSI colors
# ==============================================================================

set -Eeuo pipefail
shopt -s nullglob

if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  printf 'flowframes: bash >= 4.4 is required.\n' >&2
  exit 1
fi

# ------------------------------------------------------------------------------
#  Constants & paths
# ------------------------------------------------------------------------------
