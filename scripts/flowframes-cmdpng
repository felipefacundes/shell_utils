MODELS_DIR="${FF_MODELS_DIR:-$DATA_DIR/models}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/$APP"
LOG_FILE="$STATE_DIR/last-run.log"

# Theme
C_ACCENT="#38BDF8"; C_OK="#4ADE80"; C_WARN="#FACC15"; C_ERR="#F87171"; C_DIM="#6B7280"

CR=""; CB=""; CA=""; CO=""; CW=""; CE=""; CD=""
HAVE_GUM=0
IS_TTY=0
BAR_W=34
STAGE_T0=0
LAST_PCT=-1

