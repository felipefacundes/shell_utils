        [help_godot_permanent]="Permanent: Use -g to set a specific version to always use"
        [help_cleanup_text]="When cache limit is reached, the oldest backup is automatically removed."
        [help_example1]="Create backup and launch Godot"
        [help_example2]="Restore from a backup"
        [help_example3]="Set cache limit to 50GB"
        [help_example4]="Use specific Godot version"
        [help_example5]="Pass arguments to Godot"
        [available_backups]="Available backups:"
        [total_size]="Total size:"
        [no_backups]="No backups found in"
        [enter_number]="Enter number:"
        [invalid_selection]="Invalid selection"
        [available_versions]="Available versions:"
        [no_godot_found]="No Godot binaries found"
        [error_specify_binary]="Please specify the Godot binary name"
        [error_not_found_in]="not found in"
        [set_permanent_version]="Permanent Godot version set to:"
        [purge_confirm]="Are you sure you want to delete ALL backups?"
        [purge_all]="All backups purged."
        [delete_manually]="You can delete it manually after confirming the restoration is correct."
        [error_could_not_move]="Could not move existing directory"
        [error_invalid_choice]="Restore failed - Invalid selection"
        [update_config]="Please update the configuration or create the directory."
    )
