        [help_example5]="Passar argumentos para o Godot"
        [available_backups]="Backups disponíveis:"
        [total_size]="Tamanho total:"
        [no_backups]="Nenhum backup encontrado em"
        [enter_number]="Digite o número:"
        [invalid_selection]="Seleção inválida"
        [available_versions]="Versões disponíveis:"
        [no_godot_found]="Nenhum binário Godot encontrado"
        [error_specify_binary]="Por favor, especifique o nome do binário Godot"
