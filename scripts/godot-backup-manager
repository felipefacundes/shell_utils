# Script variables
SCRIPT_NAME="${0##*/}"
CACHE_DIR="${HOME}/.cache/${SCRIPT_NAME}"
CONFIG_FILE="${HOME}/.config/${SCRIPT_NAME}.conf"
GODOT_BIN_DIR="${HOME}/.local/bin"
DEFAULT_CACHE_SIZE="30G"
TEMP_PROJECT_DIR=""  # Temporary override for project directory

# Color definitions for help (now actually used in show_help)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to convert human-readable size to bytes
human_to_bytes() {
    local size="$1"
    local num="${size%[A-Za-z]*}"
    local unit="${size##*[0-9]}"
    case "$unit" in
        G|g) echo "$((num * 1024 * 1024 * 1024))" ;;
        M|m) echo "$((num * 1024 * 1024))" ;;
        T|t) echo "$((num * 1024 * 1024 * 1024 * 1024))" ;;
        K|k) echo "$((num * 1024))" ;;
        *) echo "$num" ;;
    esac
}

# Function to bytes to human-readable
bytes_to_human() {
    local bytes="$1"
    if [[ "$bytes" -gt 1073741824 ]]; then
        echo "$((bytes / 1073741824))G"
    elif [[ "$bytes" -gt 1048576 ]]; then
        echo "$((bytes / 1048576))M"
    elif [[ "$bytes" -gt 1024 ]]; then
        echo "$((bytes / 1024))K"
    else
        echo "${bytes}B"
    fi
}

# Function to get human-readable size with ls (for precision with decimals)
get_human_size() {
    local file="$1"
    # Use ls -lh and extract the size field
    ls -lh "$file" 2>/dev/null | awk '{print $5}'
}

# Function to display help
show_help() {
    cat << EOF | { echo -e "$(cat)"; }
${GREEN}${MESSAGES[help_title]}${NC}

${YELLOW}${MESSAGES[help_usage]}${NC}
    ${SCRIPT_NAME} [OPTIONS] [godot arguments]

${YELLOW}${MESSAGES[help_description]}${NC}
    Automates backup creation for Godot projects with restore functionality.
    Backups are stored in ${BLUE}~/.cache/${SCRIPT_NAME}/${NC}

${YELLOW}${MESSAGES[help_options]}${NC}
    ${GREEN}-h, --help${NC}        ${MESSAGES[help_show]}
    ${GREEN}-r, --restore${NC}     ${MESSAGES[help_restore_opt]}
    ${GREEN}-c, --cache${NC}       ${MESSAGES[help_cache_opt]}
    ${GREEN}-g, --godot${NC}       ${MESSAGES[help_godot_opt]}
    ${GREEN}-l, --list${NC}        ${MESSAGES[help_list_opt]}
    ${GREEN}-p, --purge${NC}       ${MESSAGES[help_purge_opt]}
    ${GREEN}--project${NC}         ${MESSAGES[help_project_opt]}

${YELLOW}${MESSAGES[help_first_run]}${NC}
    ${MESSAGES[help_first_run_text]}

${YELLOW}${MESSAGES[help_backup_dir]}${NC}
    ${MESSAGES[help_backup_dir_text]}

${YELLOW}${MESSAGES[help_restore]}${NC}
    ${MESSAGES[help_restore_text]}

${YELLOW}${MESSAGES[help_godot]}${NC}
    ${MESSAGES[help_godot_default]}
    ${MESSAGES[help_godot_permanent]}

${YELLOW}${MESSAGES[help_cleanup]}${NC}
    ${MESSAGES[help_cleanup_text]}

${YELLOW}${MESSAGES[help_examples]}${NC}
    ${GREEN}${SCRIPT_NAME}${NC}                    # ${MESSAGES[help_example1]}
    ${GREEN}${SCRIPT_NAME} -r${NC}                  # ${MESSAGES[help_example2]}
    ${GREEN}${SCRIPT_NAME} -c 50G${NC}              # ${MESSAGES[help_example3]}
    ${GREEN}${SCRIPT_NAME} -g Godot_v4.2-stable${NC} # ${MESSAGES[help_example4]}
    ${GREEN}${SCRIPT_NAME} -g${NC}                  # ${MESSAGES[help_example5]}
    ${GREEN}${SCRIPT_NAME} --project${NC}           # ${MESSAGES[help_example6]}
    ${GREEN}${SCRIPT_NAME} --project /path/to/proj${NC} # ${MESSAGES[help_example7]}
    ${GREEN}${SCRIPT_NAME} --project /path/to/proj -- --rendering-driver vulkan${NC} # ${MESSAGES[help_example8]}

EOF
}

# Function to setup configuration
setup_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        # Use zenity to select projects directory
        if command -v zenity >/dev/null 2>&1; then
            local project_dir
            project_dir=$(zenity --file-selection --directory --title="${MESSAGES[select_project_dir]}" 2>/dev/null)
            if [[ -n "$project_dir" ]]; then
                echo "PROJECTS_DIR=\"$project_dir\"" > "$CONFIG_FILE"
                echo "CACHE_SIZE=\"$DEFAULT_CACHE_SIZE\"" >> "$CONFIG_FILE"
                echo "GODOT_VERSION=\"\"" >> "$CONFIG_FILE"
                echo "${MESSAGES[backup_created]}: $project_dir"
            else
                echo "${MESSAGES[operation_cancelled]}"
                exit 1
            fi
        else
            echo "${MESSAGES[install_zenity]} $CONFIG_FILE"
            echo "${MESSAGES[example_content]}:"
            echo 'PROJECTS_DIR="/path/to/your/godot/projects"'
            echo "CACHE_SIZE=\"$DEFAULT_CACHE_SIZE\""
            echo 'GODOT_VERSION=""'
            exit 1
        fi
    fi
    
    # Source configuration
    source "$CONFIG_FILE"
    
    # Override with temporary project directory if set
    if [[ -n "$TEMP_PROJECT_DIR" ]]; then
        PROJECTS_DIR="$TEMP_PROJECT_DIR"
        echo "${MESSAGES[using_temporary_project_dir]} $PROJECTS_DIR"
    fi
    
    # Create cache directory if it doesn't exist
    mkdir -p "$CACHE_DIR"
}

# Function to manage cache size
manage_cache_size() {
    local max_size_bytes
    max_size_bytes=$(human_to_bytes "$CACHE_SIZE")
    
    while true; do
        local size_bkp_tars
        size_bkp_tars=$(du -sb "$CACHE_DIR" 2>/dev/null | awk '{print $1}')
        [[ -z "$size_bkp_tars" ]] && size_bkp_tars=0
        
        if [[ "$size_bkp_tars" -gt "$max_size_bytes" ]]; then
            echo "${MESSAGES[backup_limit_reached]}"
            
            # Remove the oldest tar file
            local oldest_tar
            oldest_tar=$(ls -t "$CACHE_DIR"/*.tar 2>/dev/null | tail -n 1)
            if [[ -n "$oldest_tar" ]]; then
                rm -f "$oldest_tar" 2>/dev/null
                echo -e "\n${MESSAGES[removed_file]}: $oldest_tar\n"
            else
                break
            fi
        else
            break
        fi
    done
}

# Function to create backup
create_backup() {
    local projects_dir="$1"
    local backup_name
    backup_name="${projects_dir##*/}_$(date +'%d-%m-%Y_%H-%M-%S').tar"
    
    echo "${MESSAGES[wait_backup]}"
    
    # Create backup
    if tar -cf "$CACHE_DIR/$backup_name" -C "$(dirname "$projects_dir")" "${projects_dir##*/}" 2>/dev/null; then
        echo -e "\n${MESSAGES[backup_created]}: $backup_name"
        return 0
    else
        echo "${MESSAGES[backup_failed]}"
        return 1
    fi
}

# Function to list backups with human-readable sizes (using ls -lh for precision)
list_backups() {
    echo -e "\n${YELLOW}${MESSAGES[available_backups]}${NC}"
    echo "----------------------------------------"
    
    # Use find to get files (handles spaces), then use ls -lh for each file
    while IFS= read -r -d '' file; do
        local filename=$(basename "$file")
        local size_human=$(get_human_size "$file")
        printf "%-60s (%s)\n" "$filename" "$size_human"
    done < <(find "$CACHE_DIR" -maxdepth 1 -name "*.tar" -print0 2>/dev/null | sort -rz)
    
    echo "----------------------------------------"
    echo "${MESSAGES[total_size]}: $(du -sh "$CACHE_DIR" 2>/dev/null | awk '{print $1}')"
}

# Function to get array of backups with proper handling of spaces
get_backup_list() {
    local backups=()
    while IFS= read -r -d '' file; do
        backups+=("$file")
    done < <(find "$CACHE_DIR" -maxdepth 1 -name "*.tar" -print0 2>/dev/null | sort -rz)
    printf '%s\n' "${backups[@]}"
}

# Function to restore backup
restore_backup() {
    local backup_file
    local backups=()
    
    # Get list of backups using null-delimited handling
    while IFS= read -r -d '' file; do
        backups+=("$file")
    done < <(find "$CACHE_DIR" -maxdepth 1 -name "*.tar" -print0 2>/dev/null | sort -rz)
    
    if [[ ${#backups[@]} -eq 0 ]]; then
        echo "${MESSAGES[no_backups]} $CACHE_DIR"
        return 1
    fi
    
    # Display backup list and get user selection
    if command -v whiptail >/dev/null 2>&1; then
        local options=()
        for i in "${!backups[@]}"; do
            # Get just the filename without path
            local filename=$(basename "${backups[$i]}")
            # Get size using ls -lh for precision
            local size_human=$(get_human_size "${backups[$i]}")
            options+=("$i" "$filename ($size_human)")
        done
        
        local choice
        choice=$(whiptail --title "${MESSAGES[restore_prompt]}" \
            --menu "${MESSAGES[restore_prompt]}" 20 80 10 \
            "${options[@]}" 3>&1 1>&2 2>&3)
        
        if [[ $? -ne 0 ]]; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
        
        backup_file="${backups[$choice]}"
        
    elif command -v dialog >/dev/null 2>&1; then
        local options=()
        for i in "${!backups[@]}"; do
            local filename=$(basename "${backups[$i]}")
            local size_human=$(get_human_size "${backups[$i]}")
            options+=("$i" "$filename ($size_human)")
        done
        
        local choice
        choice=$(dialog --title "${MESSAGES[restore_prompt]}" \
            --menu "${MESSAGES[restore_prompt]}" 20 80 10 \
            "${options[@]}" 3>&1 1>&2 2>&3)
        
        if [[ $? -ne 0 ]]; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
        
        backup_file="${backups[$choice]}"
        
    else
        # Fallback to simple list
        echo "${MESSAGES[restore_prompt]}:"
        for i in "${!backups[@]}"; do
            local size_human=$(get_human_size "${backups[$i]}")
            echo "$i) $(basename "${backups[$i]}") ($size_human)"
        done
        read -p "${MESSAGES[enter_number]} " choice
        
        if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -ge "${#backups[@]}" ]]; then
            echo "${MESSAGES[restore_failed]} - ${MESSAGES[invalid_selection]}"
            return 1
        fi
        
        backup_file="${backups[$choice]}"
    fi
    
    # Extract project name from backup file
    local backup_basename=$(basename "$backup_file")
    local project_name
    project_name=$(echo "$backup_basename" | sed 's/_[0-9]\{2\}-[0-9]\{2\}-[0-9]\{4\}_.*\.tar$//')
    
    # Get parent directory
    local extract_dir
    extract_dir="$(dirname "$PROJECTS_DIR")"
    local project_path="${extract_dir}/${project_name}"
    
    echo "${MESSAGES[overwrite_warning]}"
    
    # Check if project directory exists
    if [[ -d "$project_path" ]]; then
        # Generate timestamp for backup
        local new_date
        new_date="$(date +'%d-%m-%Y_%H-%M-%S')"
        local backup_dir_name="${project_name}_backup_${new_date}"
        local backup_dir_path="${extract_dir}/${backup_dir_name}"
        
        echo "${MESSAGES[dir_exists]}: ${backup_dir_path}"
        
        # Move existing directory to backup
        if mv "$project_path" "$backup_dir_path"; then
            echo "${MESSAGES[dir_moved]}: ${backup_dir_path}"
        else
            echo "${MESSAGES[restore_failed]} - ${MESSAGES[error_could_not_move]}"
            return 1
        fi
    fi
    
    # Extract backup
    echo "Restoring: $(basename "$backup_file")"
    if tar -xf "$backup_file" -C "$extract_dir" 2>/dev/null; then
        echo "${MESSAGES[restore_complete]}"
        
        # Show info about moved directory if it was moved
        if [[ -n "$backup_dir_path" ]] && [[ -d "$backup_dir_path" ]]; then
            echo -e "\n${YELLOW}${MESSAGES[dir_moved]}:${NC} $backup_dir_path"
            echo "${MESSAGES[delete_manually]}"
        fi
        
        return 0
    else
        echo "${MESSAGES[restore_failed]}"
        return 1
    fi
}

# Function to get list of available Godot binaries
get_godot_binaries() {
    local binaries=()
    local display_names=()
    
    # Check for binaries in GODOT_BIN_DIR
    while IFS= read -r -d '' file; do
        if [[ -x "$file" ]]; then
            binaries+=("$file")
            display_names+=("$(basename "$file")")
        fi
    done < <(find "$GODOT_BIN_DIR" -maxdepth 1 -name "Godot*" -print0 2>/dev/null | sort -z)
    
    # Check for native godot in /usr/bin
    if [[ -x "/usr/bin/godot" ]]; then
        binaries+=("/usr/bin/godot")
        display_names+=("${MESSAGES[native_version]} (/usr/bin/godot)")
    fi
    
    # Return both arrays
    printf '%s\n' "${binaries[@]}" > /tmp/godot_binaries_$$.tmp
    printf '%s\n' "${display_names[@]}" > /tmp/godot_display_$$.tmp
    echo "${#binaries[@]}"
}

# Function to set permanent godot version with interactive selection
set_godot_version_interactive() {
    local binaries=()
    local display_names=()
    local count=0
    
    # Read binaries
    while IFS= read -r line; do
        binaries+=("$line")
    done < <(find "$GODOT_BIN_DIR" -maxdepth 1 -name "Godot*" -print0 2>/dev/null | sort -z | xargs -0 -n1 2>/dev/null)
    
    # Check for native godot
    if [[ -x "/usr/bin/godot" ]]; then
        binaries+=("/usr/bin/godot")
    fi
    
    if [[ ${#binaries[@]} -eq 0 ]]; then
        echo "${MESSAGES[no_godot_binaries]}"
        return 1
    fi
    
    # Build display names
    for binary in "${binaries[@]}"; do
        if [[ "$binary" == "/usr/bin/godot" ]]; then
            display_names+=("${MESSAGES[native_version]} (/usr/bin/godot)")
        else
            display_names+=("$(basename "$binary")")
        fi
    done
    
    # Display selection menu
    if command -v whiptail >/dev/null 2>&1; then
        local options=()
        for i in "${!display_names[@]}"; do
            options+=("$i" "${display_names[$i]}")
        done
        
        local choice
        choice=$(whiptail --title "${MESSAGES[select_godot_version]}" \
            --menu "${MESSAGES[godot_binaries_found]}" 20 80 10 \
            "${options[@]}" 3>&1 1>&2 2>&3)
        
        if [[ $? -ne 0 ]]; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
        
        local selected_binary="${binaries[$choice]}"
        local selected_name="${display_names[$choice]}"
        
        # If native version, store as "native" special marker
        if [[ "$selected_binary" == "/usr/bin/godot" ]]; then
            # Remove GODOT_VERSION from config to use native
            sed -i "/^GODOT_VERSION=/d" "$CONFIG_FILE"
            echo "# Using native system Godot" >> "$CONFIG_FILE"
            echo "GODOT_VERSION=\"native\"" >> "$CONFIG_FILE"
            echo "${MESSAGES[set_permanent_version]} ${MESSAGES[native_version]}"
        else
            local version_name=$(basename "$selected_binary")
            sed -i "s/^GODOT_VERSION=.*/GODOT_VERSION=\"$version_name\"/" "$CONFIG_FILE"
            echo "${MESSAGES[set_permanent_version]} $version_name"
        fi
        
    elif command -v dialog >/dev/null 2>&1; then
        local options=()
        for i in "${!display_names[@]}"; do
            options+=("$i" "${display_names[$i]}")
        done
        
        local choice
        choice=$(dialog --title "${MESSAGES[select_godot_version]}" \
            --menu "${MESSAGES[godot_binaries_found]}" 20 80 10 \
            "${options[@]}" 3>&1 1>&2 2>&3)
        
        if [[ $? -ne 0 ]]; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
        
        local selected_binary="${binaries[$choice]}"
        
        if [[ "$selected_binary" == "/usr/bin/godot" ]]; then
            sed -i "/^GODOT_VERSION=/d" "$CONFIG_FILE"
            echo "# Using native system Godot" >> "$CONFIG_FILE"
            echo "GODOT_VERSION=\"native\"" >> "$CONFIG_FILE"
            echo "${MESSAGES[set_permanent_version]} ${MESSAGES[native_version]}"
        else
            local version_name=$(basename "$selected_binary")
            sed -i "s/^GODOT_VERSION=.*/GODOT_VERSION=\"$version_name\"/" "$CONFIG_FILE"
            echo "${MESSAGES[set_permanent_version]} $version_name"
        fi
        
    else
        # Fallback to simple list
        echo "${MESSAGES[select_godot_version]}:"
        for i in "${!display_names[@]}"; do
            echo "$i) ${display_names[$i]}"
        done
        read -p "${MESSAGES[enter_number]} " choice
        
        if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -ge "${#binaries[@]}" ]]; then
            echo "${MESSAGES[invalid_selection]}"
            return 1
        fi
        
        local selected_binary="${binaries[$choice]}"
        
        if [[ "$selected_binary" == "/usr/bin/godot" ]]; then
            sed -i "/^GODOT_VERSION=/d" "$CONFIG_FILE"
            echo "# Using native system Godot" >> "$CONFIG_FILE"
            echo "GODOT_VERSION=\"native\"" >> "$CONFIG_FILE"
            echo "${MESSAGES[set_permanent_version]} ${MESSAGES[native_version]}"
        else
            local version_name=$(basename "$selected_binary")
            sed -i "s/^GODOT_VERSION=.*/GODOT_VERSION=\"$version_name\"/" "$CONFIG_FILE"
            echo "${MESSAGES[set_permanent_version]} $version_name"
        fi
    fi
    
    # Cleanup temp files
    rm -f /tmp/godot_binaries_$$.tmp /tmp/godot_display_$$.tmp 2>/dev/null
    
    return 0
}

# Function to set permanent godot version (legacy - direct set)
set_godot_version() {
    local version="$1"
    
    # Check if it's a file in GODOT_BIN_DIR
    if [[ -f "$GODOT_BIN_DIR/$version" ]]; then
        # Update config
        sed -i "s/^GODOT_VERSION=.*/GODOT_VERSION=\"$version\"/" "$CONFIG_FILE"
        echo "${MESSAGES[set_permanent_version]} $version"
        return 0
    fi
    
    # Check if it's the native version
    if [[ "$version" == "native" ]] && [[ -x "/usr/bin/godot" ]]; then
        sed -i "/^GODOT_VERSION=/d" "$CONFIG_FILE"
        echo "# Using native system Godot" >> "$CONFIG_FILE"
        echo "GODOT_VERSION=\"native\"" >> "$CONFIG_FILE"
        echo "${MESSAGES[set_permanent_version]} ${MESSAGES[native_version]}"
        return 0
    fi
    
    echo "Error: $version ${MESSAGES[error_not_found_in]} $GODOT_BIN_DIR"
    echo "${MESSAGES[available_versions]}:"
    ls -1 "$GODOT_BIN_DIR"/Godot* 2>/dev/null || echo "${MESSAGES[no_godot_found]}"
    if [[ -x "/usr/bin/godot" ]]; then
        echo "${MESSAGES[native_version]} (/usr/bin/godot)"
    fi
    return 1
}

# Function to get Godot binary
get_godot_binary() {
    local godot_bin
    
    # If permanent version is set to "native", use system godot
    if [[ "$GODOT_VERSION" == "native" ]] && command -v godot >/dev/null 2>&1; then
        echo "godot"
        return 0
    fi
    
    # If permanent version is set, use it
    if [[ -n "$GODOT_VERSION" ]] && [[ -f "$GODOT_BIN_DIR/$GODOT_VERSION" ]]; then
        echo "$GODOT_BIN_DIR/$GODOT_VERSION"
        return 0
    fi
    
    # Otherwise use latest version
    godot_bin=$(ls -v "$GODOT_BIN_DIR"/Godot* 2>/dev/null | tail -n1)
    
    if [[ -n "$godot_bin" ]] && [[ -f "$godot_bin" ]]; then
        echo "$godot_bin"
        return 0
    fi
    
    # Check if godot is in PATH
    if command -v godot >/dev/null 2>&1; then
        echo "godot"
        return 0
    fi
    
    echo "${MESSAGES[godot_not_found]}" >&2
    return 1
}

# Function to purge all backups
purge_backups() {
    if whiptail --yesno "${MESSAGES[purge_confirm]}" 10 60 2>/dev/null || \
       dialog --yesno "${MESSAGES[purge_confirm]}" 10 60 2>/dev/null || \
       read -p "${MESSAGES[purge_confirm]} (y/n): " confirm; then
        if [[ "$confirm" =~ ^[Yy]$ ]] || [[ $? -eq 0 ]]; then
            rm -rf "$CACHE_DIR"/*.tar
            echo "${MESSAGES[purge_all]}"
        else
            echo "${MESSAGES[operation_cancelled]}"
        fi
    fi
}

# Main execution
main() {
    # Parse command line arguments
    local restore_mode=false
    local list_mode=false
    local purge_mode=false
    local project_dir_arg=""
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -r|--restore)
                restore_mode=true
                shift
                ;;
            -c|--cache)
                if [[ -n "$2" ]] && [[ "$2" =~ ^[0-9]+[GgMmTtKk]?$ ]]; then
                    sed -i "s/^CACHE_SIZE=.*/CACHE_SIZE=\"$2\"/" "$CONFIG_FILE"
                    echo "${MESSAGES[cache_size_set]} $2"
                    exit 0
                else
                    echo "${MESSAGES[invalid_size]}"
                    exit 1
                fi
                shift 2
                ;;
            -g|--godot)
                if [[ -n "$2" ]] && [[ ! "$2" =~ ^- ]]; then
                    # Has argument - set specific version
                    set_godot_version "$2"
                    exit $?
                else
                    # No argument - interactive selection
                    setup_config
                    set_godot_version_interactive
                    exit $?
                fi
                shift 2
                ;;
            --project)
                if [[ -n "$2" ]] && [[ ! "$2" =~ ^- ]]; then
                    # Has argument - use specified directory
                    project_dir_arg="$2"
                    shift 2
                else
                    # No argument - interactive selection
                    if command -v zenity >/dev/null 2>&1; then
                        project_dir_arg=$(zenity --file-selection --directory --title="${MESSAGES[select_project_directory]}" 2>/dev/null)
                        if [[ -z "$project_dir_arg" ]]; then
                            echo "${MESSAGES[operation_cancelled]}"
                            exit 1
                        fi
                    else
                        echo "${MESSAGES[install_zenity]}"
                        echo "${MESSAGES[select_project_dir]}:"
                        read -r project_dir_arg
                        if [[ -z "$project_dir_arg" ]] || [[ ! -d "$project_dir_arg" ]]; then
                            echo "${MESSAGES[operation_cancelled]}"
                            exit 1
                        fi
                    fi
                    shift
                fi
                # Set temporary project directory
                TEMP_PROJECT_DIR="$project_dir_arg"
                echo "${MESSAGES[project_dir_selected]} $TEMP_PROJECT_DIR"
                ;;
            -l|--list)
                list_mode=true
                shift
                ;;
            -p|--purge)
                purge_mode=true
                shift
                ;;
            --)
                # End of options, everything after is for Godot
                shift
                break
                ;;
            *)
                break
                ;;
        esac
    done
    
    # Setup configuration (will use TEMP_PROJECT_DIR if set)
    setup_config
    
    # Handle list mode
    if [[ "$list_mode" == true ]]; then
        list_backups
        exit 0
    fi
    
    # Handle purge mode
    if [[ "$purge_mode" == true ]]; then
        purge_backups
        exit 0
    fi
    
    # Handle restore mode
    if [[ "$restore_mode" == true ]]; then
        restore_backup
        exit $?
    fi
    
    # Verify projects directory exists
    if [[ ! -d "$PROJECTS_DIR" ]]; then
        echo "${MESSAGES[project_dir_not_found]}: $PROJECTS_DIR"
        echo "${MESSAGES[update_config]}"
        exit 1
    fi
    
    # Manage cache size
    manage_cache_size
    
    # Create backup
    create_backup "$PROJECTS_DIR"
    if [[ $? -ne 0 ]]; then
        exit 1
    fi
    
    # Get Godot binary
    local godot_bin
    godot_bin=$(get_godot_binary)
    if [[ $? -ne 0 ]]; then
        exit 1
    fi
    
    # Set graphics environment
    export vblank_mode=0
    export __GL_SYNC_TO_VBLANK=0
    
    # NVIDIA handling
    if lspci | grep -i "VGA" | grep -qi "NVIDIA"; then
        if lsmod | grep -i nvidia >/dev/null 2>&1; then
            export __NV_PRIME_RENDER_OFFLOAD=1
            export __VK_LAYER_NV_OPTIMUS=NVIDIA_only
            export __GLX_VENDOR_LIBRARY_NAME=nvidia
        fi
    fi
    
    # Launch Godot
    echo "${MESSAGES[starting_godot]}"
    setsid "$godot_bin" "$@" &
    local godot_pid=$!
    
    # Handle SIGINT
    trap 'kill "$godot_pid" 2>/dev/null; exit' SIGINT
    
    wait "$godot_pid"
}

# Run main function
main "$@"