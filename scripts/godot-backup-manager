        [help_purge_opt]="Purge all backups (confirmation required)"
        [help_first_run_text]="On first execution, zenity will prompt to select the projects directory. The selected directory will be the one backed up."
        [help_backup_dir_text]="All projects inside the selected directory will be included in the backup. Backup format: projectdir_YYYY-MM-DD_HH-MM-SS.tar"
        [help_restore_text]="When restoring, the existing project directory will be moved to: projectdir_backup_YYYY-MM-DD_HH-MM-SS This prevents data loss and avoids overwrite errors."
