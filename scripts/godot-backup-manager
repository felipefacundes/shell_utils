        [help_first_run_text]="Na primeira execução, o zenity solicitará que você selecione o diretório de projetos. O diretório selecionado será o que será copiado em backup."
        [help_backup_dir_text]="Todos os projetos dentro do diretório selecionado serão incluídos no backup. Formato do backup: projectdir_AAAA-MM-DD_HH-MM-SS.tar"
