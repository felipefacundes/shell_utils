        [select_project_dir]="Select the directory where your Godot projects are located"
        [project_dir_not_found]="Project directory not found"
        [backup_limit_reached]="Backup limit reached, deleting the oldest"
        [removed_file]="file removed"
        [starting_godot]="Starting Godot"
        [wait_backup]="Backup being created. Wait!"
        [godot_not_found]="Godot not found in ~/.local/bin. Please download a version from https://godotengine.org/ and place it in ~/.local/bin"
        [choose_godot]="Choose the Godot version you want to use permanently"
        [restore_prompt]="Choose the backup you want to restore"
        [cache_size_prompt]="Set the maximum cache folder size (ex: 30G, 500M)"
        [invalid_size]="Invalid size. Use format like 30G, 500M, 10T"
        [operation_cancelled]="Operation cancelled by user"
        [dir_moved]="Directory moved to"
        [dir_exists]="Directory already exists. Moving to"
        [overwrite_warning]="WARNING: The project folder will be moved to a backup before restoration"
        [help_title]="${SCRIPT_NAME} - Godot Project Backup and Restore Tool"
        [help_usage]="USAGE:"
