#!/usr/bin/env bash
# License: GPLv3
# Credits: Felipe Facundes

if ! command -v rofi >/dev/null; then
    notify-send 'Install: rofi!'
    exit 1
fi

if pidof rofi >/dev/null; then
    exit 1
fi

state="$(hyprctl -j clients)"
active_window="$(hyprctl -j activewindow)"

current_addr="$(echo "$active_window" | jq -r '.address')"

# Marca a janela ativa diretamente no jq (sem sed), evitando problemas de escaping
window="$(echo "$state" |
    jq -r --arg cur "$current_addr" '
        .[]
        | select(.monitor != -1)
        | if .address == $cur
          then "focused        \(.workspace.name)    \(.title)"
          else "\(.address)    \(.workspace.name)    \(.title)"
          end' |
    sort -r | rofi -show window "Windows")"

[[ -z "$window" ]] && exit 0

addr="$(echo "$window" | awk '{print $1}')"
ws="$(echo "$window" | awk '{print $2}')"

if [[ "$addr" == "focused" ]]; then
    echo 'already focused, exiting'
    exit 0
fi

# Remove qualquer whitespace residual do endereço (defensivo)
addr="${addr//[[:space:]]/}"

# Janela em fullscreen na workspace alvo
# (fullscreen pode ser bool ou número dependendo da versão do Hyprland)
fullscreen_on_same_ws="$(echo "$state" | jq -r --arg ws "$ws" '
    .[]
    | select(.fullscreen != 0 and .fullscreen != false)
    | select(.workspace.name == $ws)
    | .address' | head -n1)"

# Remove whitespace residual do endereço da fullscreen também
fullscreen_on_same_ws="${fullscreen_on_same_ws//[[:space:]]/}"

if [[ -z "$fullscreen_on_same_ws" ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:${addr}\" })"
else
    # Se app_B está em fullscreen na mesma workspace, focar apenas app_A
    # deixa app_B por cima. Desliga o fullscreen de B, foca A, e religa em A.
    notify-send 'Complex switch' "$window"
    hyprctl eval "
        hl.dispatch(hl.dsp.focus({ window = 'address:${fullscreen_on_same_ws}' }))
        hl.dispatch(hl.dsp.window.fullscreen({ mode = 'maximized', action = 'toggle' }))
        hl.dispatch(hl.dsp.focus({ window = 'address:${addr}' }))
        hl.dispatch(hl.dsp.window.fullscreen({ mode = 'maximized', action = 'toggle' }))
    "
fi