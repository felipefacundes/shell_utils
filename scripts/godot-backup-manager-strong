    ${MESSAGES[help_first_run_text]}

${YELLOW}${MESSAGES[help_backup_dir]}${NC}
    ${MESSAGES[help_backup_dir_text]}

${YELLOW}${MESSAGES[help_safety_features]}${NC}
    ${MESSAGES[help_safety_verify]}
    ${MESSAGES[help_safety_safe]}
    ${MESSAGES[help_safety_backup]}
    ${MESSAGES[help_safety_validate]}
    ${MESSAGES[help_safety_log]}
    ${MESSAGES[help_safety_dry]}

