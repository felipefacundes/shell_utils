# Script variables
SCRIPT_NAME="${0##*/}"
CACHE_DIR="${HOME}/.cache/${SCRIPT_NAME}"
CONFIG_FILE="${HOME}/.config/${SCRIPT_NAME}.conf"
GODOT_BIN_DIR="${HOME}/.local/bin"
DEFAULT_CACHE_SIZE="30G"
CHECKSUM_FILE="checksums.txt"

# Color definitions for help
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Function to convert human-readable size to bytes
human_to_bytes() {
    local size="$1"
    local num="${size%[A-Za-z]*}"
    local unit="${size##*[0-9]}"
    case "$unit" in
        G|g) echo "$((num * 1024 * 1024 * 1024))" ;;
        M|m) echo "$((num * 1024 * 1024))" ;;
        T|t) echo "$((num * 1024 * 1024 * 1024 * 1024))" ;;
        K|k) echo "$((num * 1024))" ;;
        *) echo "$num" ;;
    esac
}

# Function to generate checksum for backup
generate_checksum() {
    local backup_file="$1"
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$backup_file" | awk '{print $1}'
    elif command -v md5sum >/dev/null 2>&1; then
        md5sum "$backup_file" | awk '{print $1}'
    else
        echo "WARNING: No checksum tool found" >&2
        return 1
    fi
}

# Function to verify backup integrity
verify_backup() {
    local backup_file="$1"
    local checksum_file="${backup_file}.checksum"
    
    echo "${MESSAGES[verify_checksum]}"
    
    # If checksum file exists, verify
    if [[ -f "$checksum_file" ]]; then
        local stored_checksum
        stored_checksum=$(cat "$checksum_file")
        local current_checksum
        current_checksum=$(generate_checksum "$backup_file")
        
        if [[ "$stored_checksum" == "$current_checksum" ]]; then
            echo "${MESSAGES[checksum_passed]}"
            return 0
        else
            echo "${MESSAGES[checksum_failed]}"
            return 1
        fi
    fi
    
    # Otherwise, test tar integrity
    if tar -tf "$backup_file" >/dev/null 2>&1; then
        echo "${MESSAGES[backup_verified]}"
        return 0
    else
        echo "${MESSAGES[backup_corrupted]}"
        return 1
    fi
}

# Function to display help
show_help() {
    cat << EOF | { echo -e "$(cat)"; }
${BOLD}${GREEN}${MESSAGES[help_title]}${NC}

${YELLOW}${MESSAGES[help_usage]}${NC}
    ${SCRIPT_NAME} [OPTIONS] [godot arguments]

${YELLOW}${MESSAGES[help_description]}${NC}
    Automates backup creation for Godot projects with restore functionality.
    Backups are stored in ${BLUE}~/.cache/${SCRIPT_NAME}/${NC}
    
    ${BOLD}${RED}${MESSAGES[help_safety_title]}${NC}

${YELLOW}${MESSAGES[help_options]}${NC}
    ${GREEN}-h, --help${NC}        ${MESSAGES[help_show]}
    ${GREEN}-r, --restore${NC}     ${MESSAGES[help_restore_opt]}
    ${GREEN}-c, --cache${NC}       ${MESSAGES[help_cache_opt]}
    ${GREEN}-g, --godot${NC}       ${MESSAGES[help_godot_opt]}
    ${GREEN}-l, --list${NC}        ${MESSAGES[help_list_opt]}
    ${GREEN}-p, --purge${NC}       ${MESSAGES[help_purge_opt]}
    ${GREEN}-d, --dry-run${NC}     ${MESSAGES[help_dry_run_opt]}
    ${GREEN}-v, --verify${NC}      ${MESSAGES[help_verify_opt]}

