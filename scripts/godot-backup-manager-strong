# Function to setup configuration
setup_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        # Use zenity to select projects directory
        if command -v zenity >/dev/null 2>&1; then
            local project_dir
            project_dir=$(zenity --file-selection --directory --title="${MESSAGES[select_project_dir]}" 2>/dev/null)
            if [[ -n "$project_dir" ]]; then
                echo "PROJECTS_DIR=\"$project_dir\"" > "$CONFIG_FILE"
                echo "CACHE_SIZE=\"$DEFAULT_CACHE_SIZE\"" >> "$CONFIG_FILE"
                echo "GODOT_VERSION=\"\"" >> "$CONFIG_FILE"
                echo "${MESSAGES[backup_created]}: $project_dir"
            else
                echo "${MESSAGES[operation_cancelled]}"
                exit 1
            fi
        else
            echo "${MESSAGES[install_zenity]} $CONFIG_FILE"
            echo "${MESSAGES[example_content]}:"
            echo 'PROJECTS_DIR="/path/to/your/godot/projects"'
            echo "CACHE_SIZE=\"$DEFAULT_CACHE_SIZE\""
            echo 'GODOT_VERSION=""'
            exit 1
        fi
    fi
    
    # Source configuration
    source "$CONFIG_FILE"
    
    # Validate configuration
    if [[ -z "$PROJECTS_DIR" ]] || [[ ! -d "$PROJECTS_DIR" ]]; then
        echo "${MESSAGES[project_dir_not_found]}: $PROJECTS_DIR"
        echo "${MESSAGES[fix_config]} $CONFIG_FILE"
        exit 1
    fi
    
    # Create cache directory if it doesn't exist
    mkdir -p "$CACHE_DIR"
    
    # Initialize checksum file if it doesn't exist
    if [[ ! -f "$CACHE_DIR/$CHECKSUM_FILE" ]]; then
        touch "$CACHE_DIR/$CHECKSUM_FILE"
    fi
}

# Function to manage cache size
manage_cache_size() {
    local max_size_bytes
    max_size_bytes=$(human_to_bytes "$CACHE_SIZE")
    
    while true; do
        local size_bkp_tars
        size_bkp_tars=$(du -sb "$CACHE_DIR" 2>/dev/null | awk '{print $1}')
        [[ -z "$size_bkp_tars" ]] && size_bkp_tars=0
        
        if [[ "$size_bkp_tars" -gt "$max_size_bytes" ]]; then
            echo "${MESSAGES[backup_limit_reached]}"
            
            # Remove the oldest tar file and its checksum
            local oldest_tar
            oldest_tar=$(ls -t "$CACHE_DIR"/*.tar 2>/dev/null | tail -n 1)
            if [[ -n "$oldest_tar" ]]; then
                rm -f "$oldest_tar" 2>/dev/null
                rm -f "${oldest_tar}.checksum" 2>/dev/null
                echo -e "\n${MESSAGES[removed_file]}: $oldest_tar\n"
            else
                break
            fi
        else
            break
        fi
    done
}

# Function to create backup
create_backup() {
    local projects_dir="$1"
    local backup_name
    backup_name="${projects_dir##*/}_$(date +'%d-%m-%Y_%H-%M-%S').tar"
    local backup_path="$CACHE_DIR/$backup_name"
    
    echo "${MESSAGES[wait_backup]}"
    
    # Create backup
    if tar -cf "$backup_path" -C "$(dirname "$projects_dir")" "${projects_dir##*/}" 2>/dev/null; then
        # Generate checksum
        local checksum
        checksum=$(generate_checksum "$backup_path")
        if [[ -n "$checksum" ]]; then
            echo "$checksum" > "${backup_path}.checksum"
            echo "${MESSAGES[checksum_passed]}"
        fi
        
        echo -e "\n${MESSAGES[backup_created]}: $backup_name"
        echo "${MESSAGES[backup_size]}: $(du -h "$backup_path" | awk '{print $1}')"
        return 0
    else
        echo "${MESSAGES[backup_failed]}"
        return 1
    fi
}

# Function to list backups with details
list_backups() {
    echo -e "\n${BOLD}${BLUE}${MESSAGES[backup_list_header]}${NC}"
    echo "═══════════════════════════════════════════════════════════════════════════════"
    
    local backups=($(ls -t "$CACHE_DIR"/*.tar 2>/dev/null))
    if [[ ${#backups[@]} -eq 0 ]]; then
        echo "${MESSAGES[no_backups]}"
        echo "═══════════════════════════════════════════════════════════════════════════════"
        return 1
    fi
    
    for backup in "${backups[@]}"; do
        local backup_name=$(basename "$backup")
        local backup_size=$(du -h "$backup" | awk '{print $1}')
        local backup_date=$(date -r "$backup" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "N/A")
        local checksum_status="❌"
        
        # Check if checksum exists and verify
        if [[ -f "${backup}.checksum" ]]; then
            if verify_backup "$backup" >/dev/null 2>&1; then
                checksum_status="✅"
            fi
        fi
        
        printf "${YELLOW}%-50s${NC}\n" "$backup_name"
        printf "  ${BLUE}${MESSAGES[backup_size]}:${NC} %-10s ${BLUE}${MESSAGES[backup_date]}:${NC} %-20s ${BLUE}${MESSAGES[integrity]}:${NC} %s\n" \
            "$backup_size" "$backup_date" "$checksum_status"
        echo "───────────────────────────────────────────────────────────────────────────────"
    done
    
    echo -e "\n${GREEN}${MESSAGES[total_size]}:${NC} $(du -sh "$CACHE_DIR" 2>/dev/null | awk '{print $1}')"
    echo "═══════════════════════════════════════════════════════════════════════════════"
}

# Function to restore backup with safety checks
restore_backup() {
    local dry_run="${1:-false}"
    local backup_file
    
    # Get list of backups
    local backups=($(ls -t "$CACHE_DIR"/*.tar 2>/dev/null))
    
    if [[ ${#backups[@]} -eq 0 ]]; then
        echo "${MESSAGES[no_backups]}"
        return 1
    fi
    
    # Display backup list and get user selection
    if command -v whiptail >/dev/null 2>&1; then
        local options=()
        for i in "${!backups[@]}"; do
            local size=$(du -h "${backups[$i]}" | awk '{print $1}')
            options+=("$i" "$(basename "${backups[$i]}") ($size)")
        done
        
        local choice
        choice=$(whiptail --title "${MESSAGES[restore_prompt]}" \
            --menu "${MESSAGES[restore_prompt]}" 20 80 10 \
            "${options[@]}" 3>&1 1>&2 2>&3)
        
        if [[ $? -ne 0 ]]; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
        
        backup_file="${backups[$choice]}"
        
    elif command -v dialog >/dev/null 2>&1; then
        local options=()
        for i in "${!backups[@]}"; do
            local size=$(du -h "${backups[$i]}" | awk '{print $1}')
            options+=("$i" "$(basename "${backups[$i]}") ($size)")
        done
        
        local choice
        choice=$(dialog --title "${MESSAGES[restore_prompt]}" \
            --menu "${MESSAGES[restore_prompt]}" 20 80 10 \
            "${options[@]}" 3>&1 1>&2 2>&3)
        
        if [[ $? -ne 0 ]]; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
        
        backup_file="${backups[$choice]}"
        
    else
        # Fallback to simple list
        echo "${MESSAGES[restore_prompt]}:"
        for i in "${!backups[@]}"; do
            local size=$(du -h "${backups[$i]}" | awk '{print $1}')
            echo "$i) $(basename "${backups[$i]}") ($size)"
        done
        read -p "${MESSAGES[enter_number]} " choice
        
        if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -ge "${#backups[@]}" ]]; then
            echo "${MESSAGES[restore_failed]} - ${MESSAGES[invalid_selection]}"
            return 1
        fi
        
        backup_file="${backups[$choice]}"
    fi
    
    # SAFETY STEP 1: Verify backup integrity
    echo -e "\n${BOLD}${YELLOW}${MESSAGES[safety_check]}${NC}"
    if ! verify_backup "$backup_file"; then
        echo "${RED}${MESSAGES[safety_failed]}${NC}"
        echo "The backup may be corrupted. Do not proceed with restore."
        return 1
    fi
    echo "${GREEN}${MESSAGES[safety_passed]}${NC}\n"
    
    # Extract project name from backup file
    local project_name
    project_name=$(basename "$backup_file" | sed 's/_[0-9]\{2\}-[0-9]\{2\}-[0-9]\{4\}_.*\.tar$//')
    
    # Get parent directory
    local extract_dir
    extract_dir="$(dirname "$PROJECTS_DIR")"
    local project_path="${extract_dir}/${project_name}"
    
    echo "${BOLD}${YELLOW}${MESSAGES[overwrite_warning]}${NC}"
    
    if [[ "$dry_run" == true ]]; then
        echo "${BOLD}${BLUE}${MESSAGES[dry_run]}${NC}"
        echo "${MESSAGES[would_restore]} $(basename "$backup_file")"
        echo "${MESSAGES[target]}: $project_path"
        if [[ -d "$project_path" ]]; then
            local new_date
            new_date="$(date +'%d-%m-%Y_%H-%M-%S')"
            echo "${MESSAGES[would_move_existing]} ${project_path}_backup_${new_date}"
        fi
        return 0
    fi
    
    # SAFETY STEP 2: Confirm restore
    if command -v whiptail >/dev/null 2>&1; then
        if ! whiptail --yesno "${MESSAGES[confirm_restore]}" 10 60; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
    elif command -v dialog >/dev/null 2>&1; then
        if ! dialog --yesno "${MESSAGES[confirm_restore]}" 10 60; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
    else
        read -p "${MESSAGES[confirm_restore]} (y/n): " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
    fi
    
    # SAFETY STEP 3: Check if project directory exists and move it
    local backup_dir_path=""
    if [[ -d "$project_path" ]]; then
        local new_date
        new_date="$(date +'%d-%m-%Y_%H-%M-%S')"
        local backup_dir_name="${project_name}_backup_${new_date}"
        backup_dir_path="${extract_dir}/${backup_dir_name}"
        
        echo "${MESSAGES[dir_exists]}: ${backup_dir_path}"
        
        # Move existing directory to backup
        if mv "$project_path" "$backup_dir_path"; then
            echo "${MESSAGES[dir_moved]}: ${backup_dir_path}"
        else
            echo "${RED}${MESSAGES[restore_failed]} - ${MESSAGES[error_could_not_move]}${NC}"
            return 1
        fi
    fi
    
    # SAFETY STEP 4: Extract backup
    echo "Restoring: $(basename "$backup_file")"
    if tar -xf "$backup_file" -C "$extract_dir" 2>/dev/null; then
        echo "${GREEN}${BOLD}${MESSAGES[restore_success]}${NC}"
        
        # Show info about moved directory if it was moved
        if [[ -n "$backup_dir_path" ]] && [[ -d "$backup_dir_path" ]]; then
            echo -e "\n${YELLOW}${MESSAGES[restore_warning]}${NC} $backup_dir_path"
            echo "${MESSAGES[delete_manually]}"
            echo "${MESSAGES[delete_command]} \"$backup_dir_path\""
        fi
        
        return 0
    else
        echo "${RED}${MESSAGES[restore_failed]}${NC}"
        
        # Attempt to restore original directory if extraction failed
        if [[ -n "$backup_dir_path" ]] && [[ -d "$backup_dir_path" ]]; then
            echo "${MESSAGES[attempting_restore_original]}"
            if mv "$backup_dir_path" "$project_path" 2>/dev/null; then
                echo "${MESSAGES[original_restored]}"
            else
                echo "${MESSAGES[original_at]} $backup_dir_path"
            fi
        fi
        return 1
    fi
}

# Function to get Godot binary
get_godot_binary() {
    local godot_bin
    
    # If permanent version is set, use it
    if [[ -n "$GODOT_VERSION" ]] && [[ -f "$GODOT_BIN_DIR/$GODOT_VERSION" ]]; then
        echo "$GODOT_BIN_DIR/$GODOT_VERSION"
        return 0
    fi
    
    # Otherwise use latest version
    godot_bin=$(ls -v "$GODOT_BIN_DIR"/Godot* 2>/dev/null | tail -n1)
    
    if [[ -n "$godot_bin" ]] && [[ -f "$godot_bin" ]]; then
        echo "$godot_bin"
        return 0
    fi
    
    # Check if godot is in PATH
    if command -v godot >/dev/null 2>&1; then
        echo "godot"
        return 0
    fi
    
    echo "${MESSAGES[godot_not_found]}" >&2
    return 1
}

# Function to set permanent godot version
set_godot_version() {
    local version="$1"
    
    if [[ -f "$GODOT_BIN_DIR/$version" ]]; then
        # Update config
        sed -i "s/^GODOT_VERSION=.*/GODOT_VERSION=\"$version\"/" "$CONFIG_FILE"
        echo "${MESSAGES[set_permanent_version]} $version"
    else
        echo "Error: $version ${MESSAGES[error_not_found_in]} $GODOT_BIN_DIR"
        echo "${MESSAGES[available_versions]}:"
        ls -1 "$GODOT_BIN_DIR"/Godot* 2>/dev/null || echo "${MESSAGES[no_godot_found]}"
        return 1
    fi
}

# Function to verify backup integrity
verify_backup_file() {
    local backup_file="$1"
    
    if [[ ! -f "$backup_file" ]]; then
        # Check if it's in cache
        backup_file="$CACHE_DIR/$1"
        if [[ ! -f "$backup_file" ]]; then
            echo "${MESSAGES[backup_not_found]} $1"
            return 1
        fi
    fi
    
    echo "${BOLD}${YELLOW}${MESSAGES[verifying_backup]} $(basename "$backup_file")${NC}"
    if verify_backup "$backup_file"; then
        echo "${GREEN}${MESSAGES[backup_intact]}${NC}"
        echo "${MESSAGES[backup_size]}: $(du -h "$backup_file" | awk '{print $1}')"
        echo "${MESSAGES[backup_date]}: $(date -r "$backup_file" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo 'N/A')"
        return 0
    else
        echo "${RED}${MESSAGES[backup_verification_failed]}${NC}"
        return 1
    fi
}

# Function to purge all backups
purge_backups() {
    if command -v whiptail >/dev/null 2>&1; then
        if ! whiptail --yesno "${MESSAGES[purge_confirm]}" 12 60; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
    elif command -v dialog >/dev/null 2>&1; then
        if ! dialog --yesno "${MESSAGES[purge_confirm]}" 12 60; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
    else
        read -p "${MESSAGES[purge_confirm]} (y/n): " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
    fi
    
    # Double confirmation for safety
    if command -v whiptail >/dev/null 2>&1; then
        if ! whiptail --yesno "${MESSAGES[purge_final_warning]}" 10 60; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
    elif command -v dialog >/dev/null 2>&1; then
        if ! dialog --yesno "${MESSAGES[purge_final_warning]}" 10 60; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
    else
        read -p "${MESSAGES[purge_final_warning]} (y/n): " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "${MESSAGES[operation_cancelled]}"
            return 1
        fi
    fi
    
    rm -rf "$CACHE_DIR"/*.tar "$CACHE_DIR"/*.checksum
    echo "${MESSAGES[purge_all]}"
}

# Main execution
main() {
    # Parse command line arguments
    local restore_mode=false
    local list_mode=false
    local purge_mode=false
    local dry_run=false
    local verify_mode=false
    local verify_file=""
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -r|--restore)
                restore_mode=true
                shift
                ;;
            -c|--cache)
                if [[ -n "$2" ]] && [[ "$2" =~ ^[0-9]+[GgMmTtKk]?$ ]]; then
                    sed -i "s/^CACHE_SIZE=.*/CACHE_SIZE=\"$2\"/" "$CONFIG_FILE"
                    echo "${MESSAGES[cache_size_set]} $2"
                    exit 0
                else
                    echo "${MESSAGES[invalid_size]}"
                    exit 1
                fi
                shift 2
                ;;
            -g|--godot)
                if [[ -n "$2" ]]; then
                    set_godot_version "$2"
                    exit 0
                else
                    echo "${MESSAGES[error_specify_binary]}"
                    exit 1
                fi
                shift 2
                ;;
            -l|--list)
                list_mode=true
                shift
                ;;
            -p|--purge)
                purge_mode=true
                shift
                ;;
            -d|--dry-run)
                dry_run=true
                shift
                ;;
            -v|--verify)
                verify_mode=true
                if [[ -n "$2" ]] && [[ ! "$2" =~ ^- ]]; then
                    verify_file="$2"
                    shift 2
                else
                    shift
                fi
                ;;
            *)
                break
                ;;
        esac
    done
    
    # Setup configuration
    setup_config
    
    # Handle verify mode
    if [[ "$verify_mode" == true ]]; then
        if [[ -n "$verify_file" ]]; then
            verify_backup_file "$verify_file"
            exit $?
        else
            echo "${MESSAGES[no_backup_specified]}"
            exit 1
        fi
    fi
    
    # Handle list mode
    if [[ "$list_mode" == true ]]; then
        list_backups
        exit 0
    fi
    
    # Handle purge mode
    if [[ "$purge_mode" == true ]]; then
        purge_backups
        exit $?
    fi
    
    # Handle restore mode
    if [[ "$restore_mode" == true ]]; then
        restore_backup "$dry_run"
        exit $?
    fi
    
    # Manage cache size
    manage_cache_size
    
    # Create backup
    create_backup "$PROJECTS_DIR"
    if [[ $? -ne 0 ]]; then
        exit 1
    fi
    
    # Get Godot binary
    local godot_bin
    godot_bin=$(get_godot_binary)
    if [[ $? -ne 0 ]]; then
        exit 1
    fi
    
    # Set graphics environment
    export vblank_mode=0
    export __GL_SYNC_TO_VBLANK=0
    
    # NVIDIA handling
    if lspci | grep -i "VGA" | grep -qi "NVIDIA"; then
        if lsmod | grep -i nvidia >/dev/null 2>&1; then
            export __NV_PRIME_RENDER_OFFLOAD=1
            export __VK_LAYER_NV_OPTIMUS=NVIDIA_only
            export __GLX_VENDOR_LIBRARY_NAME=nvidia
        fi
    fi
    
    # Launch Godot
    echo "${MESSAGES[starting_godot]}"
    setsid "$godot_bin" "$@" &
    local godot_pid=$!
    
    # Handle SIGINT
    trap 'kill "$godot_pid" 2>/dev/null; exit' SIGINT
    
    wait "$godot_pid"
}

# Run main function
main "$@"